/-- The route's scalar observations: each load's window and byte pins at its
block-start memory, each store's window, and each branch choice. -/
structure Route (mem : Std.ExtHashMap Nat (BitVec 8)) (a4 a3 a5 sp : BitVec 64) (b1 b2 b3 b4 b5 b6 : List (BitVec 8)) : Prop where
  control0 : a4 &&& 1#64 = 0x0#64
  read1 : ReadWindow (a3 + BitVec.ofNat 64 0) 8
  pins1 : LPins8 (mem1 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) (a3 + BitVec.ofNat 64 0).toNat b1
  read2 : ReadWindow ((bytesVal .ld b1) + BitVec.ofNat 64 40) 8
  pins2 : LPins8 (mem1 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) ((bytesVal .ld b1) + BitVec.ofNat 64 40).toNat b2
  control1 : (a4).toNat < ((bytesVal .ld b2)).toNat
  read3 : ReadWindow ((bytesVal .ld b1) + BitVec.ofNat 64 32) 8
  pins3 : LPins8 (mem2 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) ((bytesVal .ld b1) + BitVec.ofNat 64 32).toNat b3
  control2 : ((bytesVal .ld b3)).toNat < (a4).toNat
  read4 : ReadWindow ((bytesVal .ld b1) + BitVec.ofNat 64 104) 8
  pins4 : LPins8 (mem3 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) ((bytesVal .ld b1) + BitVec.ofNat 64 104).toNat b4
  read5 : ReadWindow ((bytesVal .ld b4) + BitVec.ofNat 64 24) 8
  pins5 : LPins8 (mem3 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) ((bytesVal .ld b4) + BitVec.ofNat 64 24).toNat b5
  read6 : ReadWindow ((bytesVal .ld b4) + BitVec.ofNat 64 32) 8
  pins6 : LPins8 (mem3 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) ((bytesVal .ld b4) + BitVec.ofNat 64 32).toNat b6
  control3 : ((bytesVal .ld b6)).toNat ≤ ((bytesVal .ld b5)).toNat
  write1 : WriteWindow (sp + BitVec.ofNat 64 8) 8
  write2 : WriteWindow (sp + BitVec.ofNat 64 0) 8

theorem access {mem : Std.ExtHashMap Nat (BitVec 8)} {a4 a3 a5 sp : BitVec 64} {b1 b2 b3 b4 b5 b6 : List (BitVec 8)}
    (r : Route mem a4 a3 a5 sp b1 b2 b3 b4 b5 b6) : ChainAccess mem (regs a4 a3 a5 sp) (loads b1 b2 b3 b4 b5 b6) blocks := by
  simp only [loads, regs]
  apply ChainAccess.cons ⟨block0_access (mem0 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) a4 a3 a5 sp  _ ,
    block0_control a4 a3 a5 sp  _ r.control0⟩
  rw [block0_log, block0_regs, block0_loads, writeLog_nil']
  change ChainAccess (mem1 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) _ _ _
  apply ChainAccess.cons ⟨block1_access (mem1 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) a4 a3 a5 sp b1 b2 _ r.read1 r.pins1 r.read2 r.pins2,
    block1_control a4 a3 a5 sp b1 b2 _ r.control1⟩
  rw [block1_log, block1_regs, block1_loads, writeLog_nil']
  change ChainAccess (mem2 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) _ _ _
  apply ChainAccess.cons ⟨block2_access (mem2 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) a4 a3 a5 sp (bytesVal .ld b1) (bytesVal .ld b2) b3 _ r.read3 r.pins3,
    block2_control a4 a3 a5 sp (bytesVal .ld b1) (bytesVal .ld b2) b3 _ r.control2⟩
  rw [block2_log, block2_regs, block2_loads, writeLog_nil']
  change ChainAccess (mem3 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) _ _ _
  apply ChainAccess.cons ⟨block3_access (mem3 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) a4 a3 a5 sp (bytesVal .ld b1) (bytesVal .ld b2) (bytesVal .ld b3) b4 b5 b6 _ r.read4 r.pins4 r.read5 r.pins5 r.read6 r.pins6,
    block3_control a4 a3 a5 sp (bytesVal .ld b1) (bytesVal .ld b2) (bytesVal .ld b3) b4 b5 b6 _ r.control3⟩
  rw [block3_log, block3_regs, block3_loads, writeLog_nil']
  change ChainAccess (mem4 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) _ _ _
  apply ChainAccess.cons ⟨block4_access (mem4 mem b1 b2 b3 b4 b5 b6 a4 a3 a5 sp) a4 a3 a5 sp (bytesVal .ld b1) (bytesVal .ld b2) (bytesVal .ld b3) (bytesVal .ld b4) (bytesVal .ld b5) (bytesVal .ld b6)  _ r.write1 r.write2,
    block4_control a4 a3 a5 sp (bytesVal .ld b1) (bytesVal .ld b2) (bytesVal .ld b3) (bytesVal .ld b4) (bytesVal .ld b5) (bytesVal .ld b6)  _⟩
  rw [block4_log, block4_regs, block4_loads]
  exact ChainAccess.nil

structure Input (a4 a3 a5 sp : BitVec 64) (b1 b2 b3 b4 b5 b6 : List (BitVec 8)) (c : Config) : Prop where
  good : GoodState c.σ
  tick : c.tick < 2
  minstret : ∃ w, c.σ.regs.get? Register.minstret = some w
  code0 : Code.Caml_modifyLoaded c.σ.mem
  registers : GHolds c.σ (regs a4 a3 a5 sp)
  route : Route c.σ.mem a4 a3 a5 sp b1 b2 b3 b4 b5 b6

/-- **The chain run.** -/
theorem run {a4 a3 a5 sp : BitVec 64} {b1 b2 b3 b4 b5 b6 : List (BitVec 8)} {c : Config} (input : Input a4 a3 a5 sp b1 b2 b3 b4 b5 b6 c) :
    FnSummary pc (fun d => d = c) (BlockPost blocks pc (regs a4 a3 a5 sp) (loads b1 b2 b3 b4 b5 b6) c) :=
  block_summary blocks pc _ _ c
    ⟨input.good, input.minstret, input.registers, by change KeysOK [14, 13, 15, 2]; decide,
      chainPlan_facts (code_facts input.code0) (access input.route), chain_ok, input.tick⟩

theorem log (a4 a3 a5 sp : BitVec 64) (b1 b2 b3 b4 b5 b6 : List (BitVec 8)) :
    (evalBlocks blocks (SegEvalState.init (regs a4 a3 a5 sp) (loads b1 b2 b3 b4 b5 b6))).log =
      [((sp + BitVec.ofNat 64 8).toNat, 8, a5), ((sp + BitVec.ofNat 64 0).toNat, 8, (bytesVal .ld b4))] := by
  simp only [blocks, loads, regs, evalBlocks, evalBlock, SegEvalState.init, block0_regs, block0_loads, block0_log, block1_regs, block1_loads, block1_log, block2_regs, block2_loads, block2_log, block3_regs, block3_loads, block3_log, block4_regs, block4_loads, block4_log,
    List.nil_append, List.cons_append, List.append_nil]
theorem registers (a4 a3 a5 sp : BitVec 64) (b1 b2 b3 b4 b5 b6 : List (BitVec 8)) :
    (evalBlocks blocks (SegEvalState.init (regs a4 a3 a5 sp) (loads b1 b2 b3 b4 b5 b6))).regs =
      state5 a4 a3 a5 sp (bytesVal .ld b1) (bytesVal .ld b2) (bytesVal .ld b3) (bytesVal .ld b4) (bytesVal .ld b5) (bytesVal .ld b6) := by
  simp only [blocks, loads, regs, evalBlocks, evalBlock, SegEvalState.init, block0_regs, block0_loads, block0_log, block1_regs, block1_loads, block1_log, block2_regs, block2_loads, block2_log, block3_regs, block3_loads, block3_log, block4_regs, block4_loads, block4_log]
theorem written : ∀ n ∈ wrChain blocks, n ∈ [10, 12, 13, 14] := by decide

def call : CallInstr := ⟨0x8000aa84#64, 0xbd1ff0ef#32, 0xef#8, 0xf0#8, 0x1f#8, 0xbd#8, 0x1ffbd0#21⟩
theorem call_shape : CallShape call := by constructor <;> decide
theorem call_decode : CallDecode call := by
  intro s hm hp he
  exact Vsa.Sim.ElfDecode.decode_bd1ff0ef s hm hp he
theorem call_target : call.target = 0x8000a654#64 := by decide
theorem call_link : call.link = 0x8000aa88#64 := by decide
theorem call_pins {c : Config} (h : Code.Caml_modifyLoaded c.σ.mem) : CallPins call c := by
  obtain ⟨h0, h1, h2, h3⟩ := Code.caml_modify_at_8000aa84 h
  exact ⟨h0, h1, h2, h3⟩

theorem endpoint (a4 a3 a5 sp : BitVec 64) (lds : List (List (BitVec 8))) :
    evalBlocksPC pc (SegEvalState.init (regs a4 a3 a5 sp) lds) blocks = call.pc := rfl

end OCaml.Vm.Gc.BarrierFull
