/-- The route's scalar observations: each load's window and byte pins at its
block-start memory, each store's window, and each branch choice. -/
structure Route (mem : Std.ExtHashMap Nat (BitVec 8)) (sp ra a0 a1 : BitVec 64) (b1 : List (BitVec 8)) : Prop where
  write1 : WriteWindow ((sp + -32#64) + BitVec.ofNat 64 24) 8
  read1 : ReadWindow (a0 + BitVec.ofNat 64 0) 8
  pins1 : LPins8 (mem0 mem b1 sp ra a0 a1) (a0 + BitVec.ofNat 64 0).toNat b1
  apart1_1 : (a0 + BitVec.ofNat 64 0).toNat + 8 ≤ ((sp + -32#64) + BitVec.ofNat 64 24).toNat ∨ ((sp + -32#64) + BitVec.ofNat 64 24).toNat + 8 ≤ (a0 + BitVec.ofNat 64 0).toNat
  write2 : WriteWindow ((a0 + BitVec.ofNat 64 0) + BitVec.ofNat 64 0) 8
  control0 : (bytesVal .ld b1) &&& 1#64 ≠ 0x0#64

