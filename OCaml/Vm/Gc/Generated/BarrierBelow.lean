    (r : Route mem a0 b1 b2 b3) : ChainAccess mem (regs a0) (loads b1 b2 b3) blocks := by
  simp only [loads, regs]
  apply ChainAccess.cons ⟨block0_access (mem0 mem b1 b2 b3 a0) a0 b1 b2 _ r.read1 r.pins1 r.read2 r.pins2,
    block0_control a0 b1 b2 _ r.control0⟩
  rw [block0_log, block0_regs, block0_loads, writeLog_nil']
