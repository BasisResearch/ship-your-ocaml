  apply ChainAccess.cons ⟨block1_access (mem1 mem b1 b2 b3 a0) a0 (bytesVal .ld b1) (bytesVal .ld b2) b3 _ r.read3 r.pins3,
    block1_control a0 (bytesVal .ld b1) (bytesVal .ld b2) b3 _ r.control1⟩
  rw [block1_log, block1_regs, block1_loads, writeLog_nil']
  exact ChainAccess.nil

structure Input (a0 : BitVec 64) (b1 b2 b3 : List (BitVec 8)) (c : Config) : Prop where
  good : GoodState c.σ
  tick : c.tick < 2
  minstret : ∃ w, c.σ.regs.get? Register.minstret = some w
  code0 : Code.Caml_modifyLoaded c.σ.mem
  registers : GHolds c.σ (regs a0)
  route : Route c.σ.mem a0 b1 b2 b3

/-- **The chain run.** -/
theorem run {a0 : BitVec 64} {b1 b2 b3 : List (BitVec 8)} {c : Config} (input : Input a0 b1 b2 b3 c) :
    FnSummary pc (fun d => d = c) (BlockPost blocks pc (regs a0) (loads b1 b2 b3) c) :=
  block_summary blocks pc _ _ c
    ⟨input.good, input.minstret, input.registers, by change KeysOK [10]; decide,
      chainPlan_facts (code_facts input.code0) (access input.route), chain_ok, input.tick⟩

