/-- **The chain run.** -/
theorem run {sp : BitVec 64} {b1 b2 b3 b4 : List (BitVec 8)} {c : Config} (input : Input sp b1 b2 b3 b4 c) :
    FnSummary pc (fun d => d = c) (BlockPost blocks pc (regs sp) (loads b1 b2 b3 b4) c) :=
  block_summary blocks pc _ _ c
    ⟨input.good, input.minstret, input.registers, by change KeysOK [2]; decide,
      chainPlan_facts (code_facts input.code0) (access input.route), chain_ok, input.tick⟩

