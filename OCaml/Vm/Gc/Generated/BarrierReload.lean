  write2 : WriteWindow ((bytesVal .ld b3) + BitVec.ofNat 64 0) 8
  read4 : ReadWindow (sp + BitVec.ofNat 64 24) 8
  pins4 : LPins8 (mem2 mem b1 b2 b3 b4 sp) (sp + BitVec.ofNat 64 24).toNat b4
  control2 : ((bytesVal .ld b4)).toNat % 4 = 0

