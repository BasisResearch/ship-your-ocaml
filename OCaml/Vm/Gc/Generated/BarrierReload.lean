    (r : Route mem sp b1 b2 b3 b4) : ChainAccess mem (regs sp) (loads b1 b2 b3 b4) blocks := by
  simp only [loads, regs]
  apply ChainAccess.cons ⟨block0_access (mem0 mem b1 b2 b3 b4 sp) sp b1 b2 b3 _ r.read1 r.pins1 r.read2 r.pins2 r.read3 r.pins3,
    block0_control sp b1 b2 b3 _⟩
  rw [block0_log, block0_regs, block0_loads, writeLog_nil']
  change ChainAccess (mem1 mem b1 b2 b3 b4 sp) _ _ _
  apply ChainAccess.cons ⟨block1_access (mem1 mem b1 b2 b3 b4 sp) sp (bytesVal .ld b1) (bytesVal .ld b2) (bytesVal .ld b3)  _ r.write1 r.write2,
    block1_control sp (bytesVal .ld b1) (bytesVal .ld b2) (bytesVal .ld b3)  _⟩
  rw [block1_log, block1_regs, block1_loads]
  change ChainAccess (mem2 mem b1 b2 b3 b4 sp) _ _ _
  apply ChainAccess.cons ⟨block2_access (mem2 mem b1 b2 b3 b4 sp) sp (bytesVal .ld b1) (bytesVal .ld b2) (bytesVal .ld b3) b4 _ r.read4 r.pins4,
    block2_control sp (bytesVal .ld b1) (bytesVal .ld b2) (bytesVal .ld b3) b4 _ r.control2⟩
  rw [block2_log, block2_regs, block2_loads, writeLog_nil']
  exact ChainAccess.nil

