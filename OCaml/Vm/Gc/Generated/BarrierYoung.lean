  apply ChainAccess.cons ⟨block1_access (mem1 mem b1 b2 b3 a0 a1 ra) a0 a1 ra (bytesVal .ld b1) (bytesVal .ld b2) b3 _ r.read3 r.pins3,
    block1_control a0 a1 ra (bytesVal .ld b1) (bytesVal .ld b2) b3 _ r.control1⟩
  rw [block1_log, block1_regs, block1_loads, writeLog_nil']
  change ChainAccess (mem2 mem b1 b2 b3 a0 a1 ra) _ _ _
