/-- **The chain run.** -/
theorem run {a0 a1 ra : BitVec 64} {b1 b2 b3 : List (BitVec 8)} {c : Config} (input : Input a0 a1 ra b1 b2 b3 c) :
    FnSummary pc (fun d => d = c) (BlockPost blocks pc (regs a0 a1 ra) (loads b1 b2 b3) c) :=
  block_summary blocks pc _ _ c
    ⟨input.good, input.minstret, input.registers, by change KeysOK [10, 11, 1]; decide,
      chainPlan_facts (code_facts input.code0) (access input.route), chain_ok, input.tick⟩

