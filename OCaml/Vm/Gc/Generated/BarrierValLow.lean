/-- The route's scalar observations: each load's window and byte pins at its
block-start memory, each store's window, and each branch choice. -/
structure Route (mem : Std.ExtHashMap Nat (BitVec 8)) (a4 a3 : BitVec 64) (b1 b2 b3 : List (BitVec 8)) : Prop where
  control0 : a4 &&& 1#64 = 0x0#64
  read1 : ReadWindow (a3 + BitVec.ofNat 64 0) 8
  pins1 : LPins8 (mem1 mem b1 b2 b3 a4 a3) (a3 + BitVec.ofNat 64 0).toNat b1
  read2 : ReadWindow ((bytesVal .ld b1) + BitVec.ofNat 64 40) 8
  pins2 : LPins8 (mem1 mem b1 b2 b3 a4 a3) ((bytesVal .ld b1) + BitVec.ofNat 64 40).toNat b2
  control1 : (a4).toNat < ((bytesVal .ld b2)).toNat
  read3 : ReadWindow ((bytesVal .ld b1) + BitVec.ofNat 64 32) 8
  pins3 : LPins8 (mem2 mem b1 b2 b3 a4 a3) ((bytesVal .ld b1) + BitVec.ofNat 64 32).toNat b3
  control2 : (a4).toNat ≤ ((bytesVal .ld b3)).toNat

theorem access {mem : Std.ExtHashMap Nat (BitVec 8)} {a4 a3 : BitVec 64} {b1 b2 b3 : List (BitVec 8)}
    (r : Route mem a4 a3 b1 b2 b3) : ChainAccess mem (regs a4 a3) (loads b1 b2 b3) blocks := by
  simp only [loads, regs]
  apply ChainAccess.cons ⟨block0_access (mem0 mem b1 b2 b3 a4 a3) a4 a3  _ ,
    block0_control a4 a3  _ r.control0⟩
  rw [block0_log, block0_regs, block0_loads, writeLog_nil']
  change ChainAccess (mem1 mem b1 b2 b3 a4 a3) _ _ _
  apply ChainAccess.cons ⟨block1_access (mem1 mem b1 b2 b3 a4 a3) a4 a3 b1 b2 _ r.read1 r.pins1 r.read2 r.pins2,
    block1_control a4 a3 b1 b2 _ r.control1⟩
  rw [block1_log, block1_regs, block1_loads, writeLog_nil']
  change ChainAccess (mem2 mem b1 b2 b3 a4 a3) _ _ _
  apply ChainAccess.cons ⟨block2_access (mem2 mem b1 b2 b3 a4 a3) a4 a3 (bytesVal .ld b1) (bytesVal .ld b2) b3 _ r.read3 r.pins3,
    block2_control a4 a3 (bytesVal .ld b1) (bytesVal .ld b2) b3 _ r.control2⟩
  rw [block2_log, block2_regs, block2_loads, writeLog_nil']
  exact ChainAccess.nil

structure Input (a4 a3 : BitVec 64) (b1 b2 b3 : List (BitVec 8)) (c : Config) : Prop where
  good : GoodState c.σ
  tick : c.tick < 2
  minstret : ∃ w, c.σ.regs.get? Register.minstret = some w
  code0 : Code.Caml_modifyLoaded c.σ.mem
  registers : GHolds c.σ (regs a4 a3)
  route : Route c.σ.mem a4 a3 b1 b2 b3

/-- **The chain run.** -/
theorem run {a4 a3 : BitVec 64} {b1 b2 b3 : List (BitVec 8)} {c : Config} (input : Input a4 a3 b1 b2 b3 c) :
    FnSummary pc (fun d => d = c) (BlockPost blocks pc (regs a4 a3) (loads b1 b2 b3) c) :=
  block_summary blocks pc _ _ c
    ⟨input.good, input.minstret, input.registers, by change KeysOK [14, 13]; decide,
      chainPlan_facts (code_facts input.code0) (access input.route), chain_ok, input.tick⟩

