  change ChainAccess (mem1 mem b1 b2 b3 sp s0 s3 ra s2 a0 s1) _ _ _
  apply ChainAccess.cons ⟨block1_access (mem1 mem b1 b2 b3 sp s0 s3 ra s2 a0 s1) sp s0 s3 ra s2 a0 s1 b1 _ r.write1 r.write2 r.write3 r.write4 r.read1 r.pins1 r.apart1_1 r.apart1_2 r.apart1_3 r.apart1_4,
    block1_control sp s0 s3 ra s2 a0 s1 b1 _ r.control1⟩
  rw [block1_log, block1_regs, block1_loads]
  change ChainAccess (mem2 mem b1 b2 b3 sp s0 s3 ra s2 a0 s1) _ _ _
  apply ChainAccess.cons ⟨block2_access (mem2 mem b1 b2 b3 sp s0 s3 ra s2 a0 s1) sp s0 s3 ra s2 a0 s1 (bytesVal .ld b1) b2 b3 _ r.read2 r.pins2 r.write5 r.read3 r.pins3 r.apart3_5 r.write6 r.write7,
    block2_control sp s0 s3 ra s2 a0 s1 (bytesVal .ld b1) b2 b3 _⟩
  rw [block2_log, block2_regs, block2_loads]
  exact ChainAccess.nil

structure Input (sp s0 s3 ra s2 a0 s1 : BitVec 64) (b1 b2 b3 : List (BitVec 8)) (c : Config) : Prop where
  good : GoodState c.σ
  tick : c.tick < 2
  minstret : ∃ w, c.σ.regs.get? Register.minstret = some w
  code0 : Code.Caml_realloc_ref_tableLoaded c.σ.mem
  code1 : Code.Realloc_generic_table_isra_0Loaded c.σ.mem
  registers : GHolds c.σ (regs sp s0 s3 ra s2 a0 s1)
  route : Route c.σ.mem sp s0 s3 ra s2 a0 s1 b1 b2 b3

/-- **The chain run.** -/
theorem run {sp s0 s3 ra s2 a0 s1 : BitVec 64} {b1 b2 b3 : List (BitVec 8)} {c : Config} (input : Input sp s0 s3 ra s2 a0 s1 b1 b2 b3 c) :
    FnSummary pc (fun d => d = c) (BlockPost blocks pc (regs sp s0 s3 ra s2 a0 s1) (loads b1 b2 b3) c) :=
  block_summary blocks pc _ _ c
    ⟨input.good, input.minstret, input.registers, by change KeysOK [2, 8, 19, 1, 18, 10, 9]; decide,
      chainPlan_facts (code_facts input.code0 input.code1) (access input.route), chain_ok, input.tick⟩

theorem log (sp s0 s3 ra s2 a0 s1 : BitVec 64) (b1 b2 b3 : List (BitVec 8)) :
    (evalBlocks blocks (SegEvalState.init (regs sp s0 s3 ra s2 a0 s1) (loads b1 b2 b3))).log =
      [(((sp + -64#64) + BitVec.ofNat 64 48).toNat, 8, s0), (((sp + -64#64) + BitVec.ofNat 64 24).toNat, 8, s3), (((sp + -64#64) + BitVec.ofNat 64 56).toNat, 8, ra), (((sp + -64#64) + BitVec.ofNat 64 32).toNat, 8, s2), (((sp + -64#64) + BitVec.ofNat 64 40).toNat, 8, s1), ((a0 + BitVec.ofNat 64 48).toNat, 8, 0x100#64), ((a0 + BitVec.ofNat 64 40).toNat, 8, (bytesVal .ld b3) >>> 3)] := by
  simp only [blocks, loads, regs, evalBlocks, evalBlock, SegEvalState.init, block0_regs, block0_loads, block0_log, block1_regs, block1_loads, block1_log, block2_regs, block2_loads, block2_log,
    List.nil_append, List.cons_append, List.append_nil]
theorem registers (sp s0 s3 ra s2 a0 s1 : BitVec 64) (b1 b2 b3 : List (BitVec 8)) :
    (evalBlocks blocks (SegEvalState.init (regs sp s0 s3 ra s2 a0 s1) (loads b1 b2 b3))).regs =
      state3 sp s0 s3 ra s2 a0 s1 (bytesVal .ld b1) (bytesVal .ld b2) (bytesVal .ld b3) := by
  simp only [blocks, loads, regs, evalBlocks, evalBlock, SegEvalState.init, block0_regs, block0_loads, block0_log, block1_regs, block1_loads, block1_log, block2_regs, block2_loads, block2_log]
theorem written : ∀ n ∈ wrChain blocks, n ∈ [2, 8, 10, 11, 12, 13, 14, 15, 18, 19] := by decide

def call : CallInstr := ⟨0x80009774#64, 0x2c12d0ef#32, 0xef#8, 0xd0#8, 0x12#8, 0x2c#8, 0x2dac0#21⟩
theorem call_shape : CallShape call := by constructor <;> decide
theorem call_decode : CallDecode call := by
  intro s hm hp he
  exact Vsa.Sim.ElfDecode.decode_2c12d0ef s hm hp he
theorem call_target : call.target = 0x80037234#64 := by decide
theorem call_link : call.link = 0x80009778#64 := by decide
theorem call_pins {c : Config} (h : Code.Realloc_generic_table_isra_0Loaded c.σ.mem) : CallPins call c := by
  obtain ⟨h0, h1, h2, h3⟩ := Code.realloc_generic_table_isra_0_at_80009774 h
  exact ⟨h0, h1, h2, h3⟩

theorem endpoint (sp s0 s3 ra s2 a0 s1 : BitVec 64) (lds : List (List (BitVec 8))) :
    evalBlocksPC pc (SegEvalState.init (regs sp s0 s3 ra s2 a0 s1) lds) blocks = call.pc := rfl

