import OCaml.Vm.Sim.StackStore
import OCaml.Vm.Sim.ClosureOffset
import OCaml.Vm.Sim.PushoffsetclosureSegment
import OCaml.Vm.Sim.PushoffsetclosurePins

/-! GENERATED by scripts/gen_push_arms.py. Represented stack write. -/
namespace OCaml.Vm.Sim
set_option autoImplicit false
open OCaml.Bytecode Vsa.Machine Vsa.Sim LeanRV64DExecutable LeanRV64DExecutable.Functions
open OCaml.Vm.Primitives

/-- PUSHOFFSETCLOSURE saves the accumulator and restores the complete represented result.
Stack placement/separation and runtime window stability remain explicit obligations. -/
theorem pushoffsetclosure_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {w : BitVec 64} {operandWord : BitVec 32} {l a k dest : Nat}
    (stable : WindowStable L.runtimeOk [⟨sp - 8, sp⟩])
    (h : ArmInput L P s .PUSHOFFSETCLOSURE c pl cp sp high)
    (space : PushWriteOk P s c pl cp sp w)
    (operand : OperandAt P pl (s.pc + 1) operandWord)
    (selected : ClosureOffset s pl operandWord.toInt l a k dest)
    (pushed : valWord pl s.accu = some w) :
    ∃ c', Plus c c' ∧ Running L P
      {s with pc := s.pc + 2, accu := .ptr l dest, stack := s.accu :: s.stack} c' := by
  have source := represented_register h.accu pushed
  have environment := represented_register h.env selected.sourceWord
  apply push_value_arm stable h space pushed selected.resultWord selected.root
  intro d dp
  have code : sp - 8 + 8 ≤ 0x80002040 ∨ 0x8000205c ≤ sp - 8 :=
    space.code (by decide) (by decide)
  obtain ⟨memoryAfter, memoryEq⟩ : ∃ m : Std.ExtHashMap Nat (BitVec 8),
      m = writeLog d.σ.mem (pushLog sp w) := ⟨_, rfl⟩
  have read := space.operand_read32 h.code operand (memoryEq.trans
    (congrArg (fun m => writeLog m (pushLog sp w)) dp.memory))
  have address : Sail.shift_bits_left (sign_extend (m := 64) operandWord)
      (Sail.BitVec.extractLsb (0x03#6) 5 0) + BitVec.ofNat 64 (a + 8 * k) =
      BitVec.ofNat 64 (a + 8 * dest) := by
    rw [signed_index_word, BitVec.add_comm]
    exact pointer_offset_word a k dest operandWord.toInt selected.target
  have bp : SegSt (0x80002040#64)
      [⟨Register.x9, BitVec.ofNat 64 sp⟩,
       ⟨Register.x21, w⟩,
       ⟨Register.x8, BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)⟩,
       ⟨Register.x25, BitVec.ofNat 64 (a + 8 * k)⟩]
      (fun σ => Vsa.Sim.Code.CamlPushoffsetclosureLoaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc,
      ⟨(dp.frame.frame Register.x9 (by decide)).trans h.spReg,
       (dp.frame.frame Register.x21 (by decide)).trans source,
       (dp.frame.frame Register.x8 (by decide)).trans h.pc,
       (dp.frame.frame Register.x25 (by decide)).trans environment, trivial⟩,
      dp.good.minstret, dp.tick, pushoffsetclosure_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have run := tr_pushoffsetclosure (BitVec.ofNat 64 sp) (w) (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)) (BitVec.ofNat 64 (a + 8 * k)) d.σ.mem d.σ
  simp only [push_address space.room] at run
  have body := run space.window.lower space.window.upper
    space.window.htif space.window.aligned (by simpa only [space.toNat] using code)
    memoryAfter (by rw [space.toNat]; exact memoryEq)
  simp only [show sign_extend (m := 64) (0x004#12) = 4#64 from by decide,
    codePc_succ, operand.geometry.toNat, read, address] at body
  obtain ⟨nb, after, _, hb, post⟩ := body
    operand.geometry.lower operand.geometry.upper operand.geometry.htif d bp
  obtain ⟨_, hm, frame⟩ := post.extra
  refine ⟨nb, after, hb, post.good, post.pcAt, ?_, ?_, ?_, hm.trans memoryEq, frame.out, ?_⟩
  · have hp : gpr after Layout.reg_pc = some
        (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 8#64) :=
      PinsHold.get post.pins ⟨1, by simp⟩
    simpa only [show BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 8#64 =
      BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 2)) from codePc_add pl s.pc 2] using hp
  · exact PinsHold.get post.pins ⟨2, by simp⟩
  · exact PinsHold.get post.pins ⟨0, by simp⟩
  · intro r hr
    exact frame.frame r (by revert r; decide)

end OCaml.Vm.Sim
