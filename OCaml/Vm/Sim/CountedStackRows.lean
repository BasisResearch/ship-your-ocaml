    {Ready : Nat → Config → Prop} {state Customs : Config → Nat → Prop}
    (custom : Gc.CustomMemCall Ready state Customs) (fits : OCaml.Fits Gc.f1Layout.budget P) :
    OCaml.OpArm P (CountedLoopAt Customs Gc.f1Layout P) .ACC1 :=
  counted_stack_row custom (fun _ rf stable => acc1_row stable fits g1_capacity)
    (fun _ i _ opcode effect => counted_acc1_channels (P := P) (args := i.args) (by cases i; cases opcode; exact effect))

