/-- BcSem channel preservation for PUSH; physical framing is independent. -/
theorem counted_push_channels {P : Prog} {s s' : St} {args : List Int}
    (effect : stepI P s ⟨.PUSH, args⟩ = .next s') : s'.world.chans = s.world.chans := by
  cases args
  all_goals
    simp only [stepI, opt] at effect
    repeat' split at effect
    all_goals cases effect <;> rfl

