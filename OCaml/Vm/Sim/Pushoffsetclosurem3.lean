/-- PUSHOFFSETCLOSUREM3 saves the accumulator and restores the complete represented result.
Stack placement/separation and runtime window stability remain explicit obligations. -/
theorem pushoffsetclosurem3_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {w : BitVec 64} {l a k dest : Nat}
    (stable : WindowStable L.runtimeOk [⟨sp - 8, sp⟩])
    (h : ArmInput L P s .PUSHOFFSETCLOSUREM3 c pl cp sp high)
    (space : PushWriteOk P s c pl cp sp w)
    (selected : ClosureOffset s pl (-3) l a k dest)
    (pushed : valWord pl s.accu = some w) :
    ∃ c', Plus c c' ∧ Running L P
      {s with pc := s.pc + 1, accu := .ptr l dest, stack := s.accu :: s.stack} c' := by
  have source := represented_register h.accu pushed
  have environment := represented_register h.env selected.sourceWord
  apply push_value_arm stable h space pushed selected.resultWord selected.root
  intro d dp
  have code : sp - 8 + 8 ≤ 0x80002070 ∨ 0x80002084 ≤ sp - 8 :=
    space.code (by decide) (by decide)
  obtain ⟨memoryAfter, memoryEq⟩ : ∃ m : Std.ExtHashMap Nat (BitVec 8),
      m = writeLog d.σ.mem (pushLog sp w) := ⟨_, rfl⟩
  have address : BitVec.ofNat 64 (a + 8 * k) + sign_extend (m := 64) (0xfe8#12) =
      BitVec.ofNat 64 (a + 8 * dest) := by
    rw [show sign_extend (m := 64) (0xfe8#12) = BitVec.ofInt 64 (8 * (-3)) from by decide]
    exact pointer_offset_word a k dest (-3) selected.target
  have bp : SegSt (0x80002070#64)
      [⟨Register.x9, BitVec.ofNat 64 sp⟩,
       ⟨Register.x21, w⟩,
       ⟨Register.x23, BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64⟩,
       ⟨Register.x25, BitVec.ofNat 64 (a + 8 * k)⟩]
      (fun σ => Vsa.Sim.Code.CamlPushoffsetclosurem3Loaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc,
      ⟨(dp.frame.frame Register.x9 (by decide)).trans h.spReg,
       (dp.frame.frame Register.x21 (by decide)).trans source,
       dp.nextCode,
       (dp.frame.frame Register.x25 (by decide)).trans environment, trivial⟩,
      dp.good.minstret, dp.tick, pushoffsetclosurem3_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have run := tr_pushoffsetclosurem3 (BitVec.ofNat 64 sp) (w) (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64) (BitVec.ofNat 64 (a + 8 * k)) d.σ.mem d.σ
  simp only [push_address space.room, address] at run
  obtain ⟨nb, after, _, hb, post⟩ := run space.window.lower space.window.upper
    space.window.htif space.window.aligned (by simpa only [space.toNat] using code)
    memoryAfter (by rw [space.toNat]; exact memoryEq) d bp
  obtain ⟨_, hm, frame⟩ := post.extra
  refine ⟨nb, after, hb, post.good, post.pcAt, ?_, ?_, ?_, hm.trans memoryEq, frame.out, ?_⟩
  · have hp : gpr after Layout.reg_pc = some
        ((BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64) + sign_extend (m := 64) (0x000#12)) :=
      PinsHold.get post.pins ⟨1, by simp⟩
    simpa only [show sign_extend (m := 64) (0x000#12) = 0#64 from by decide,
      BitVec.add_zero, codePc_succ] using hp
  · exact PinsHold.get post.pins ⟨2, by simp⟩
  · exact PinsHold.get post.pins ⟨0, by simp⟩
  · intro r hr
    exact frame.frame r (by revert r; decide)

end OCaml.Vm.Sim
