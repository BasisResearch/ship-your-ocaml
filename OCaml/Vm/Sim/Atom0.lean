/-! GENERATED by scripts/gen_atom_arms.py. Atom pointers through the runtime binding. -/
namespace OCaml.Vm.Sim
set_option autoImplicit false
open OCaml.Bytecode Vsa.Machine Vsa.Sim LeanRV64DExecutable LeanRV64DExecutable.Functions
open OCaml.Vm.Primitives

/-- ATOM0 reads the allocated table pointer and restores the represented atom.
All fixed data addresses come from Layout; dispatch and runtime framing remain explicit. -/
theorem atom0_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat}
    (stable : MemoryStable L.runtimeOk)
    (h : ArmInput L P s .ATOM0 c pl cp sp high)
    : ∃ c', Plus c c' ∧ Running L P {s with pc := s.pc + 1, accu := .atom (0)} c' := by
  apply accu_arm stable h (atom_word_of_binding h.atomBase (0)) (fun _ hl => by cases hl)
  intro d dp
  have table : RamReadAt Layout.sym_caml_atom_table 8 := ⟨by decide, by decide, by decide⟩
  have address : (((0x80001fcc#64) + (sign_extend (m := 64) ((0x00063#20) +++ 0x000#12))) + sign_extend (m := 64) (0x9d4#12)) = BitVec.ofNat 64 Layout.sym_caml_atom_table := by decide
  have bp : SegSt (0x80001fcc#64)
      [⟨Register.x23, BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64⟩]
      (fun σ => Vsa.Sim.Code.CamlAtom0Loaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc, ⟨dp.nextCode, trivial⟩,
      dp.good.minstret, dp.tick, atom0_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have run := tr_atom0 (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64) d.σ.mem d.σ
  simp only [address,
    table.toNat,
    show sign_extend (m := 64) (0x008#12) = 8#64 from by decide,
    show sign_extend (m := 64) (0x000#12) = 0#64 from by decide,
    BitVec.add_zero] at run
  obtain ⟨nb, after, _, hb, post⟩ := run table.lower table.upper table.htif d bp
  obtain ⟨_, hm, frame⟩ := post.extra
  refine ⟨nb, after, hb, post.good, post.pcAt, ?_, ?_, hm, frame.out,
    immediate_preserved frame (by decide)⟩
  · have hp : gpr after Layout.reg_pc = some
        (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64) := PinsHold.get post.pins ⟨1, by simp⟩
    simpa only [show BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64 =
      BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 1)) from codePc_add pl s.pc 1] using hp
  · have hp : gpr after Layout.reg_accu = some
        (sign_extend (m := 64) (bytesT8 d.σ.mem Layout.sym_caml_atom_table) +
          BitVec.ofNat 64 (8 * (0) + 8)) := PinsHold.get post.pins ⟨0, by simp⟩
    simpa only [dp.memory, word, bytesT_eight_eq, sign_extend,
      Sail.BitVec.signExtend, BitVec.signExtend_eq] using hp

end OCaml.Vm.Sim
