import OCaml.Vm.Sim.BranchifJump
import OCaml.Vm.Sim.BranchifNext

/-! GENERATED by scripts/gen_conditional_arms.py. Conditional branch composition. -/
namespace OCaml.Vm.Sim
set_option autoImplicit false
open OCaml.Bytecode Vsa.Machine
open OCaml.Vm.Primitives

/-- Both paths of BRANCHIF implement its successful semantic step.
Alignment and exclusion of raw values (BcSem's guard) identify the native
false word. -/
theorem branchif_arm {L : OCaml.Layout} {P : Prog} {s s' : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {w : BitVec 32}
    (stable : MemoryStable L.runtimeOk)
    (h : ArmInput L P s .BRANCHIF c pl cp sp high)
    (aligned : EvenPlace pl)
    (operand : OperandAt P pl (s.pc + 1) w)
    (step : stepI P s ⟨.BRANCHIF, [w.toInt]⟩ = .next s') :
    ∃ c', Plus c c' ∧ Running L P s' c' := by
  have raw : s.accu.isRaw = false := by
    cases hr : s.accu.isRaw
    · rfl
    · simp [stepI, hr] at step
  have notRaw : ∀ x, s.accu ≠ .raw x := fun x hx => by simp [hx, Val.isRaw] at raw
  by_cases test : s.accu = .int (0#63)
  ·
    have state : {s with pc := s.pc + 2} = s' := by
      simpa [stepI, raw, Val.isRaw, test, St.adv] using step
    rw [← state]
    exact branchif_next_arm stable h test
  ·
    cases ht : target s.pc 0 w.toInt with
    | none => simp [stepI, raw, Val.isRaw, test, ht, opt] at step
    | some dest =>
      have state : {s with pc := dest} = s' := by
        simpa [stepI, raw, Val.isRaw, test, ht, opt] using step
      rw [← state]
      exact branchif_jump_arm stable h aligned notRaw test operand ht

end OCaml.Vm.Sim
