    (source : valWord pl s.accu = some base)
    (stack : s.stack = .int n :: v :: rest)
    (encoded : valWord pl v = some value)
    (stackRead : RamReadAt sp 8)
    (valueRead : RamReadAt (sp + 8) 8)
    (callee : ModifyCallee L P s {s with pc := s.pc + 1, accu := .unit, heap := heap, stack := rest} pl cp sp (sp + 16) high 8
      (0x80002260#64) (BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 1))) (BitVec.ofNat 64 sp) (BitVec.ofNat 64 (8 * n.toNat) + base) value) :
    ∃ after, Plus c after ∧ Running L P {s with pc := s.pc + 1, accu := .unit, heap := heap, stack := rest} after := by
  apply dispatch_compose h.dispatch
  intro d dp
  obtain ⟨count, call, run, input⟩ := setvectitem_setup stable h source stack encoded stackRead valueRead dp
  have start : Vsa.Logic.Triple (fun e => e = d)
      (fun e => PCAt (0x8000a9a8#64) e ∧ ModifyInput L P s pl cp sp high 8
        (0x80002260#64) (BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 1))) (BitVec.ofNat 64 sp) (BitVec.ofNat 64 (8 * n.toNat) + base) value e) := by
    rintro e rfl
    exact ⟨call, run.toSteps, input.entry, input⟩
  obtain ⟨after, run, result⟩ := (callSeg start callee.summary.run
    (setvectitem_return stable (rfl) (by simp [BitVec.ofNat_add]))) d rfl
  exact ⟨_, after, run.toN_of_stepsField, result⟩

