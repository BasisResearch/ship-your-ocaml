  apply accu_arm stable h selected.resultWord selected.root
  intro d dp
  have address : BitVec.ofNat 64 (a + 8 * k) + sign_extend (m := 64) (0xfe8#12) =
      BitVec.ofNat 64 (a + 8 * dest) := by
    rw [show sign_extend (m := 64) (0xfe8#12) = BitVec.ofInt 64 (8 * (-3)) from by decide]
    exact pointer_offset_word a k dest (-3) selected.target
  have bp : SegSt (0x80002078#64)
      [⟨Register.x23, BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64⟩,
       ⟨Register.x25, BitVec.ofNat 64 (a + 8 * k)⟩]
      (fun σ => Vsa.Sim.Code.CamlOffsetclosurem3Loaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc,
      ⟨dp.nextCode,
       (dp.frame.frame Register.x25 (by decide)).trans source, trivial⟩,
      dp.good.minstret, dp.tick, offsetclosurem3_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have run := tr_offsetclosurem3 (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64)
    (BitVec.ofNat 64 (a + 8 * k)) d.σ.mem d.σ
  simp only [address] at run
  obtain ⟨nb, after, _, hb, post⟩ := run d bp
  obtain ⟨_, hm, frame⟩ := post.extra
  refine ⟨nb, after, hb, post.good, post.pcAt, ?_, ?_, hm, frame.out,
    immediate_preserved frame (by decide)⟩
  · have hp : gpr after Layout.reg_pc = some
        ((BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64) + sign_extend (m := 64) (0x000#12)) :=
      PinsHold.get post.pins ⟨1, by simp⟩
