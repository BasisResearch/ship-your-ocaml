/-- OFFSETCLOSURE adjusts the environment pointer while retaining the same live allocation.
The semantic target equation supplies the nonnegative resulting field offset. -/
theorem offsetclosure_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high l a k dest : Nat} {w : BitVec 32}
    (stable : MemoryStable L.runtimeOk)
    (h : ArmInput L P s .OFFSETCLOSURE c pl cp sp high)
    (operand : OperandAt P pl (s.pc + 1) w)
    (selected : ClosureOffset s pl w.toInt l a k dest) :
    ∃ c', Plus c c' ∧ Running L P
      {s with pc := s.pc + 2, accu := .ptr l dest} c' := by
  have source := represented_register h.env selected.sourceWord
  apply accu_arm stable h selected.resultWord selected.root
  intro d dp
  have read : bytesT4 d.σ.mem (pl.codeBase + 4 * (s.pc + 1)) = w :=
    operand.read32 h.code dp.memory
  have address : Sail.shift_bits_left (sign_extend (m := 64) w)
      (Sail.BitVec.extractLsb (0x03#6) 5 0) + BitVec.ofNat 64 (a + 8 * k) =
      BitVec.ofNat 64 (a + 8 * dest) := by
    rw [signed_index_word, BitVec.add_comm]
    exact pointer_offset_word a k dest w.toInt selected.target
  have bp : SegSt (0x80002048#64)
      [⟨Register.x8, BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)⟩,
       ⟨Register.x25, BitVec.ofNat 64 (a + 8 * k)⟩]
      (fun σ => Vsa.Sim.Code.CamlOffsetclosureLoaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc,
      ⟨(dp.frame.frame Register.x8 (by decide)).trans h.pc,
       (dp.frame.frame Register.x25 (by decide)).trans source, trivial⟩,
      dp.good.minstret, dp.tick, offsetclosure_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have run := tr_offsetclosure (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc))
    (BitVec.ofNat 64 (a + 8 * k)) d.σ.mem d.σ
  simp only [show sign_extend (m := 64) (0x004#12) = 4#64 from by decide,
    codePc_succ, operand.geometry.toNat, read, address] at run
  obtain ⟨nb, after, _, hb, post⟩ := run operand.geometry.lower operand.geometry.upper operand.geometry.htif d bp
  obtain ⟨_, hm, frame⟩ := post.extra
  refine ⟨nb, after, hb, post.good, post.pcAt, ?_, ?_, hm, frame.out,
    immediate_preserved frame (by decide)⟩
  · have hp : gpr after Layout.reg_pc = some
        (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + sign_extend (m := 64) (0x008#12)) :=
      PinsHold.get post.pins ⟨1, by simp⟩
    simpa only [show sign_extend (m := 64) (0x008#12) = 8#64 from by decide,
      show BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 8#64 =
        BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 2)) from codePc_add pl s.pc 2] using hp
  · exact PinsHold.get post.pins ⟨0, by simp⟩

end OCaml.Vm.Sim
