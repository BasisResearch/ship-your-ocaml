  | false =>
    simp only [test, Val.ofBool] at state
    rw [← state]
    exact ultint_false_arm stable h accu stack read test
  | true =>
    simp only [test, Val.ofBool] at state
    rw [← state]
    exact ultint_true_arm stable h accu stack read test

end OCaml.Vm.Sim
