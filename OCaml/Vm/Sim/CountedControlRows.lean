/-! GENERATED by scripts/gen_counted_control_rows.py. Counted control rows and exact remaining F1 opcode census.
Native execution and all use-site guards come from existing checked rows. -/

namespace OCaml.Vm.Sim
set_option autoImplicit false
open OCaml.Bytecode Vsa.Machine OCaml.Vm.Primitives

/-- Exactly the ordinary control rows generated here. -/
def countedControlOpcode : Opcode → Bool
  | .APPLY => true
  | .APPLY1 => true
  | .APPLY2 => true
  | .APPLY3 => true
  | .APPTERM => true
  | .APPTERM1 => true
  | .APPTERM2 => true
  | .APPTERM3 => true
  | .RESTART => true
  | .CHECK_SIGNALS => true
  | .RAISE => true
  | .RERAISE => true
  | .RAISE_NOTRACE => true
  | .DIVINT => true
  | .MODINT => true
  | .STOP => true
  | _ => false

/-- BcSem channel preservation for APPLY; physical framing is independent. -/
theorem counted_apply_channels {P : Prog} {s s' : St} {args : List Int}
    (effect : stepI P s ⟨.APPLY, args⟩ = .next s') : s'.world.chans = s.world.chans := by
  rcases args with _ | ⟨a, _ | ⟨b, rest⟩⟩
  all_goals
    simp only [stepI] at effect
    repeat' first
      | have channels := counted_enter_channels effect
        exact channels
      | (cases effect <;> rfl)
      | split at effect

