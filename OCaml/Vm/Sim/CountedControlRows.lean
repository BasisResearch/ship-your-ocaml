/-- STOP retains the entry's actual exit globals and HTIF idleness. A halt
has no successor count obligation in counted_row. -/
theorem counted_stop_row {P : Prog} {Customs : Config → Nat → Prop}
    (good : OCaml.GoodF1 P) :
    OCaml.OpArm P (CountedLoopAt Customs Gc.f1Layout P) .STOP :=
  counted_row (fun _ _ => stop_row good
    (fun _ _ _ h => Gc.f1_exitGlobals h.running.platform.runtime.1)
    (fun _ _ _ h => h.running.loop.htifIdle))
    (fun _ i _ opcode effect => counted_stop_channels (P := P) (args := i.args)
      (by cases i; cases opcode; exact effect))

/-- The union records supported OpArm families, relative to their named
suppliers. It does not assert full F1 table closure. -/
def countedOrdinaryOpcode (op : Opcode) : Bool :=
  countedStackOpcode op || countedMemoryOpcode op || countedControlOpcode op || countedAllocOpcode op || op == .OFFSETREF

/-- Every opcode counted by the census has its actual complete row. This
partial table retains the named custom supplier and real GoodF1/Fits guards. -/
theorem counted_supported_row {P : Prog} {op : Opcode}
    {Ready : Nat → Config → Prop} {state Customs : Config → Nat → Prop}
    (custom : Gc.CustomMemCall Ready state Customs)
    (fits : OCaml.Fits Gc.f1Layout.budget P) (good : OCaml.GoodF1 P)
    (supported : countedOrdinaryOpcode op = true) :
    OCaml.OpArm P (CountedLoopAt Customs Gc.f1Layout P) op := by
  cases op with
  | ACC0 => exact counted_acc0_row custom fits
  | ACC1 => exact counted_acc1_row custom fits
  | ACC2 => exact counted_acc2_row custom fits
  | ACC3 => exact counted_acc3_row custom fits
  | ACC4 => exact counted_acc4_row custom fits
  | ACC5 => exact counted_acc5_row custom fits
  | ACC6 => exact counted_acc6_row custom fits
  | ACC7 => exact counted_acc7_row custom fits
  | ACC => exact counted_acc_row custom fits
  | PUSH => exact counted_push_row custom fits
  | PUSHACC0 => exact counted_pushacc0_row custom fits
  | PUSHACC1 => exact counted_pushacc1_row custom fits
  | PUSHACC2 => exact counted_pushacc2_row custom fits
  | PUSHACC3 => exact counted_pushacc3_row custom fits
  | PUSHACC4 => exact counted_pushacc4_row custom fits
  | PUSHACC5 => exact counted_pushacc5_row custom fits
  | PUSHACC6 => exact counted_pushacc6_row custom fits
  | PUSHACC7 => exact counted_pushacc7_row custom fits
  | PUSHACC => exact counted_pushacc_row custom fits
  | POP => exact counted_pop_row custom
  | ASSIGN => exact counted_assign_row custom fits
  | ENVACC1 => exact counted_envacc1_row custom
  | ENVACC2 => exact counted_envacc2_row custom
  | ENVACC3 => exact counted_envacc3_row custom
  | ENVACC4 => exact counted_envacc4_row custom
  | ENVACC => exact counted_envacc_row custom
  | PUSHENVACC1 => exact counted_pushenvacc1_row custom fits
  | PUSHENVACC2 => exact counted_pushenvacc2_row custom fits
  | PUSHENVACC3 => exact counted_pushenvacc3_row custom fits
  | PUSHENVACC4 => exact counted_pushenvacc4_row custom fits
  | PUSHENVACC => exact counted_pushenvacc_row custom fits
  | PUSH_RETADDR => exact counted_push_retaddr_row custom fits
  | APPLY => exact counted_apply_row custom fits
  | APPLY1 => exact counted_apply1_row custom fits
  | APPLY2 => exact counted_apply2_row custom fits
  | APPLY3 => exact counted_apply3_row custom fits
  | APPTERM => exact counted_appterm_row custom fits
  | APPTERM1 => exact counted_appterm1_row custom fits
  | APPTERM2 => exact counted_appterm2_row custom fits
  | APPTERM3 => exact counted_appterm3_row custom fits
  | RETURN => exact counted_return_row f1_memoryStable custom.accounting fits
  | RESTART => exact counted_restart_row custom fits
  | GRAB => exact counted_grab_row custom fits
  | CLOSURE => exact counted_closure_row custom fits good
  | CLOSUREREC => exact counted_closurerec_row custom fits good
  | OFFSETCLOSUREM3 => exact counted_offsetclosurem3_row custom
  | OFFSETCLOSURE0 => exact counted_offsetclosure0_row custom
  | OFFSETCLOSURE3 => exact counted_offsetclosure3_row custom
  | OFFSETCLOSURE => exact counted_offsetclosure_row custom
  | PUSHOFFSETCLOSUREM3 => exact counted_pushoffsetclosurem3_row custom fits
  | PUSHOFFSETCLOSURE0 => exact counted_pushoffsetclosure0_row custom fits
  | PUSHOFFSETCLOSURE3 => exact counted_pushoffsetclosure3_row custom fits
  | PUSHOFFSETCLOSURE => exact counted_pushoffsetclosure_row custom fits
  | GETGLOBAL => exact counted_getglobal_row custom
  | PUSHGETGLOBAL => exact counted_pushgetglobal_row custom fits
  | GETGLOBALFIELD => exact counted_getglobalfield_row custom
  | PUSHGETGLOBALFIELD => exact counted_pushgetglobalfield_row custom fits
  | SETGLOBAL => cases supported
  | ATOM0 => exact counted_atom0_row f1_memoryStable custom.accounting
  | ATOM => exact counted_atom_row f1_memoryStable custom.accounting
  | PUSHATOM0 => exact counted_pushatom0_row custom fits
  | PUSHATOM => exact counted_pushatom_row custom fits
  | MAKEBLOCK => exact counted_makeblock_row custom fits good
  | MAKEBLOCK1 => exact counted_makeblock1_row custom fits
  | MAKEBLOCK2 => exact counted_makeblock2_row custom fits
  | MAKEBLOCK3 => exact counted_makeblock3_row custom fits
  | MAKEFLOATBLOCK => cases supported
  | GETFIELD0 => exact counted_getfield0_row custom
  | GETFIELD1 => exact counted_getfield1_row custom
  | GETFIELD2 => exact counted_getfield2_row custom
  | GETFIELD3 => exact counted_getfield3_row custom
  | GETFIELD => exact counted_getfield_row custom
  | GETFLOATFIELD => cases supported
  | SETFIELD0 => cases supported
  | SETFIELD1 => cases supported
  | SETFIELD2 => cases supported
  | SETFIELD3 => cases supported
  | SETFIELD => cases supported
  | SETFLOATFIELD => cases supported
  | VECTLENGTH => cases supported
  | GETVECTITEM => cases supported
  | SETVECTITEM => cases supported
  | GETBYTESCHAR => cases supported
  | SETBYTESCHAR => cases supported
  | BRANCH => exact counted_branch_row f1_memoryStable custom.accounting
  | BRANCHIF => exact counted_branchif_row f1_memoryStable custom.accounting
