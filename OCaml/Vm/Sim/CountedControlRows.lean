/-- Counted APPLY through the actual shared runtime frame. -/
theorem counted_apply_row {P : Prog}
    {Ready : Nat → Config → Prop} {state Customs : Config → Nat → Prop}
    (custom : Gc.CustomMemCall Ready state Customs) (fits : OCaml.Fits Gc.f1Layout.budget P) :
    OCaml.OpArm P (CountedLoopAt Customs Gc.f1Layout P) .APPLY :=
  counted_stack_row custom (fun _ rf stable => apply_row stable rf fits g1_capacity)
    (fun _ i _ opcode effect => counted_apply_channels (P := P) (args := i.args)
      (by cases i; cases opcode; exact effect))

