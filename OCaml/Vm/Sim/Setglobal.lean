    (stable : MemoryStable L.runtimeOk) (h : ArmInput L P s .SETGLOBAL c pl cp sp high)
    (operand : OperandAt P pl (s.pc + 1) ofs)
    (nonnegative : 0 ≤ ofs.toInt)
    (source : valWord pl P.globals = some base)
    (encoded : valWord pl s.accu = some value)
    (callee : ModifyCallee L P s {s with pc := s.pc + 2, accu := .unit, heap := heap, stack := s.stack} pl cp sp sp high 8
      (0x800025c8#64) (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)) (BitVec.ofNat 64 sp) (BitVec.ofNat 64 (8 * ofs.toInt.toNat) + base) value) :
    ∃ after, Plus c after ∧ Running L P {s with pc := s.pc + 2, accu := .unit, heap := heap, stack := s.stack} after := by
  apply dispatch_compose h.dispatch
  intro d dp
  obtain ⟨count, call, run, input⟩ := setglobal_setup stable h operand nonnegative source encoded dp
  have start : Vsa.Logic.Triple (fun e => e = d)
      (fun e => PCAt (0x8000a9a8#64) e ∧ ModifyInput L P s pl cp sp high 8
        (0x800025c8#64) (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)) (BitVec.ofNat 64 sp) (BitVec.ofNat 64 (8 * ofs.toInt.toNat) + base) value e) := by
    rintro e rfl
    exact ⟨call, run.toSteps, input.entry, input⟩
  obtain ⟨after, run, result⟩ := (callSeg start callee.summary.run
    (setglobal_return stable (codePc_add pl s.pc 2) (rfl))) d rfl
  exact ⟨_, after, run.toN_of_stepsField, result⟩

