/-- **The OFFSETCLOSUREM3 row.** -/
theorem offsetclosurem3_row {L : OCaml.Layout} {P : Prog} (stable : MemoryStable L.runtimeOk)
    (code : ∀ s c, Reach P s → OCaml.LoopAt L P s c → DispatchCode P s .OFFSETCLOSUREM3) :
    OCaml.OpArm P (OCaml.LoopAt L P) .OFFSETCLOSUREM3 := by
  intro s c i reach h _ op _
  obtain ⟨o, args⟩ := i
  cases op
  cases args with
  | cons a as => exact trivial
  | nil =>
    apply OCaml.ArmOutcome.of_next
    · intro s' step
      exact closure_offset_next (d := (-3)) (width := 1)
        (fun _ _ _ _ _ _ _ _ input sel => offsetclosurem3_arm stable input sel) h (code s c reach h) step
    · intro e w step
      change (match s.env with
        | .ptr l k => if (k : Int) + (-3) < 0 then Res.wrong else
            .next { (s.adv 1) with accu := .ptr l ((k : Int) + (-3)).toNat }
        | _ => .wrong) = .halt e w at step
      split at step
      · split at step <;> simp_all
      · cases step

