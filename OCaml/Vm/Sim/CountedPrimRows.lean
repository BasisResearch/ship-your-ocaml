    (nonnegative : 0 ≤ index.toInt) (primitive : P.prims[index.toInt.toNat]? = some name)
    (supported : (name, 1) ∈ countedPrimCases)
    (sem : primF1Impl name [s.accu] s.heap s.world = .ok v heap world) :
    ∃ after, OCaml.Plus c after ∧ CountedLoopAt Customs Gc.f1Layout P
      {s with pc := s.pc + 2, accu := v, heap := heap, world := world} after := by
  have member : name ∈ primsF1 := by
    simp only [countedPrimCases, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at supported
    rcases supported with ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩
    all_goals decide
  exact counted_c_call1_success custom fits reach h decoded nonnegative primitive
    member sem (counted_supported_prim_returns custom supported)

