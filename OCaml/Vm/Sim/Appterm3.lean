/-- The represented tail call matches the successful bytecode transition. -/
theorem appterm3_step_arm {L : OCaml.Layout} {P : Prog} {s s' : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high l a k dest : Nat} {slot : BitVec 32}
    (stable : WindowStable L.runtimeOk [⟨tailcallStart sp 3 slot.toInt.toNat, sp + 8 * slot.toInt.toNat⟩])
    (h : ArmInput L P s .APPTERM3 c pl cp sp high)
    (operand : OperandAt P pl (s.pc + 1) slot) (nonnegative : 0 ≤ slot.toInt)
    (field : FieldSelection s.heap pl s.accu 0 (.code dest) l a k)
    (geometry : RamReadAt (a + 8 * k) 8) (ready : EnterReady c (tailcallStart sp 3 slot.toInt.toNat))
    (space : TailcallWriteOk P s c pl cp sp high slot.toInt.toNat (stackWords c sp 3)) (step : stepI P s ⟨.APPTERM3, [slot.toInt]⟩ = .next s') :
    ∃ after, Plus c after ∧ Running L P s' after := by
  have length : (stackWords c sp 3).length = 3 := by simp [stackWords]
  have fits : 3 ≤ slot.toInt.toNat := by simpa only [length] using space.fits
  have valid : ¬ (slot.toInt < 3 ∨ s.stack.length < slot.toInt.toNat) := by
    have bound := space.bound
    omega
  have state : tailcallState s 3 slot.toInt.toNat dest = s' := by
    have count : s.extra + 3 - 1 = s.extra + 2 := by omega
    simp only [stepI, valid, ite_false, enter, field.selected, opt, Res.next.injEq] at step
    simpa only [tailcallState, count, Nat.add_zero] using step
  rw [← state]
  exact appterm3_arm stable h operand nonnegative field geometry ready space

