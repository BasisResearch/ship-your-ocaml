namespace OCaml.Vm.Sim
set_option autoImplicit false
open OCaml.Bytecode Vsa.Machine Vsa.Sim OCaml.Vm.Primitives

/-- **The PUSH row**: push the accumulator from any loop head of the budget. -/
theorem push_row {L : OCaml.Layout} {B : OCaml.Budget} {P : Prog} {high0 dom0 : Nat}
    (rf : RuntimeFrame L high0 dom0) (fits : OCaml.Fits B P) (capacity : StackCapacity B) :
    OCaml.OpArm P (OCaml.LoopAt L P) .PUSH := by
  intro s c i reach h hd op _
  obtain ⟨o, args⟩ := i
  cases op
  cases args with
  | cons a as => exact trivial
  | nil =>
    apply OCaml.ArmOutcome.of_next
    · intro s' step
      cases step
      exact push_next rf (fun _ _ _ _ _ stable input space pushed => push_arm stable input space pushed)
        h (decode_fetch hd).1 (stack_fits fits capacity reach)
    · intro e w step
      cases step

