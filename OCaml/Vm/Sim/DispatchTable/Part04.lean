    have hb := h.rodata 23301 (by decide)
    have he : Image.rodataByte 23301 = (0xa8#8) := by decide +kernel
    rw [he] at hb
    exact hb
  have h2 : c.σ.mem[((Layout.jumpTable + 4 * Opcode.LSRINT.toNat) + 2)]? = some (0xfa#8) := by
    have hb := h.rodata 23302 (by decide)
    have he : Image.rodataByte 23302 = (0xfa#8) := by decide +kernel
    rw [he] at hb
    exact hb
  have h3 : c.σ.mem[((Layout.jumpTable + 4 * Opcode.LSRINT.toNat) + 3)]? = some (0xff#8) := by
    have hb := h.rodata 23303 (by decide)
    have he : Image.rodataByte 23303 = (0xff#8) := by decide +kernel
    rw [he] at hb
    exact hb
  simp only [word32, bytesT_four_eq, bytesT4, h0, h1, h2, h3, Option.getD_some] <;> decide

theorem dispatchTarget_lsrint :
    sign_extend (m := 64) (dispatchOffset .LSRINT) + BitVec.ofNat 64 Layout.jumpTable =
      BitVec.ofNat 64 (dispatchTarget .LSRINT) := by decide

theorem dispatchIndex_lsrint :
    Sail.shift_bits_left (sign_extend (m := 64) (BitVec.ofNat 32 Opcode.LSRINT.toNat))
      (Sail.BitVec.extractLsb (0x02#6) 5 0) + BitVec.ofNat 64 Layout.jumpTable =
      BitVec.ofNat 64 (Layout.jumpTable + 4 * Opcode.LSRINT.toNat) := by apply BitVec.eq_of_toNat_eq; decide

end OCaml.Vm.Sim
