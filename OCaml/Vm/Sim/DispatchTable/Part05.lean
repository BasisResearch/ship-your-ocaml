    have he : Image.rodataByte 45486 = (0xfa#8) := by decide +kernel
    rw [he] at hb
    exact hb
  have h3 : c.σ.mem[((Layout.jumpTable + 4 * Opcode.STOP.toNat) + 3)]? = some (0xff#8) := by
    have hb := h.rodata 45487 (by decide)
    have he : Image.rodataByte 45487 = (0xff#8) := by decide +kernel
    rw [he] at hb
    exact hb
  simp only [word32, bytesT_four_eq, bytesT4, h0, h1, h2, h3, Option.getD_some] <;> decide

theorem dispatchTarget_stop :
    sign_extend (m := 64) (dispatchOffset .STOP) + BitVec.ofNat 64 Layout.jumpTable =
      BitVec.ofNat 64 (dispatchTarget .STOP) := by decide

theorem dispatchIndex_stop :
    Sail.shift_bits_left (sign_extend (m := 64) (BitVec.ofNat 32 Opcode.STOP.toNat))
      (Sail.BitVec.extractLsb (0x02#6) 5 0) + BitVec.ofNat 64 Layout.jumpTable =
      BitVec.ofNat 64 (Layout.jumpTable + 4 * Opcode.STOP.toNat) := by apply BitVec.eq_of_toNat_eq; decide

end OCaml.Vm.Sim
