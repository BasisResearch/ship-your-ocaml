    (((((((Steps.single hs1).trans (Steps.single hs2)).trans (Steps.single hs3)).trans (Steps.single hs4)).trans (Steps.single hs5)).trans (Steps.single hs6)).trans (Steps.single hs7)).trans (Steps.single hs8)
  have hwhole : StepFrameOut ((Register.x15 :: noiseRegs) ++ (Register.x21 :: noiseRegs) ++ (Register.x21 :: noiseRegs) ++ (Register.x8 :: noiseRegs) ++ (Register.x15 :: noiseRegs) ++ (Register.x15 :: noiseRegs) ++ (Register.x21 :: noiseRegs) ++ noiseRegs) σ0 σ8 := by
    rw [← hinitial]
    chain_frame_out [hobs1, hobs2, hobs3, hobs4, hobs5, hobs6, hobs7, hobs8]
  have hcount : Vsa.Machine.StepsN 8 c ⟨σ8, i8, c.steps + 1 + 1 + 1 + 1 + 1 + 1 + 1 + 1⟩ :=
    hsteps8.toN_of_stepsEq rfl
  exact ⟨8, ⟨σ8, i8, c.steps + 1 + 1 + 1 + 1 + 1 + 1 + 1 + 1⟩, Nat.le_refl _, hcount,
    ⟨hG8, hpc8, hp8, ⟨vmi8, hmi8⟩, hi8, ⟨hload8, hmemE8, hwhole⟩⟩⟩

end Vsa.Sim
