import OCaml.Vm.Sim.StackStore
import OCaml.Vm.Sim.FieldRead
import OCaml.Vm.Sim.Pushenvacc1Segment
import OCaml.Vm.Sim.Pushenvacc1Pins

/-! GENERATED by scripts/gen_push_arms.py. Represented stack write. -/
namespace OCaml.Vm.Sim
set_option autoImplicit false
open OCaml.Bytecode Vsa.Machine Vsa.Sim LeanRV64DExecutable LeanRV64DExecutable.Functions
open OCaml.Vm.Primitives

/-- PUSHENVACC1 saves the accumulator and restores the complete represented result.
Stack placement/separation and runtime window stability remain explicit obligations. -/
theorem pushenvacc1_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {w : BitVec 64} {l a k : Nat} {v : Val}
    (stable : WindowStable L.runtimeOk [⟨sp - 8, sp⟩])
    (h : ArmInput L P s .PUSHENVACC1 c pl cp sp high)
    (space : PushWriteOk P s c pl cp sp w)
    (selected : FieldSelection s.heap pl s.env 1 v l a k)
    (read : RamReadAt (a + 8 * (k + 1)) 8)
    (pushed : valWord pl s.accu = some w) :
    ∃ c', Plus c c' ∧ Running L P
      {s with pc := s.pc + 1, accu := v, stack := s.accu :: s.stack} c' := by
  have source := represented_register h.accu pushed
  have value := FieldSelection.read h.toVmReprAt (by simp [roots]) selected
  have environment := represented_register h.env selected.sourceWord
  apply push_value_arm stable h space pushed value.word value.root
  intro d dp
  have code : sp - 8 + 8 ≤ 0x80002398 ∨ 0x800023ac ≤ sp - 8 :=
    space.code (by decide) (by decide)
  obtain ⟨memoryAfter, memoryEq⟩ : ∃ m : Std.ExtHashMap Nat (BitVec 8),
      m = writeLog d.σ.mem (pushLog sp w) := ⟨_, rfl⟩
  have address : BitVec.ofNat 64 (a + 8 * k) + sign_extend (m := 64) (0x008#12) =
      BitVec.ofNat 64 (a + 8 * (k + 1)) := by
    rw [show sign_extend (m := 64) (0x008#12) = BitVec.ofNat 64 (8 * 1) from by decide]
    simp only [Nat.mul_add, ← Nat.add_assoc, BitVec.ofNat_add]
  have bp : SegSt (0x80002398#64)
      [⟨Register.x9, BitVec.ofNat 64 sp⟩,
       ⟨Register.x21, w⟩,
       ⟨Register.x25, BitVec.ofNat 64 (a + 8 * k)⟩,
       ⟨Register.x23, BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64⟩]
      (fun σ => Vsa.Sim.Code.CamlPushenvacc1Loaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc,
      ⟨(dp.frame.frame Register.x9 (by decide)).trans h.spReg,
       (dp.frame.frame Register.x21 (by decide)).trans source,
       (dp.frame.frame Register.x25 (by decide)).trans environment,
       dp.nextCode, trivial⟩,
      dp.good.minstret, dp.tick, pushenvacc1_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have run := tr_pushenvacc1 (BitVec.ofNat 64 sp) (w) (BitVec.ofNat 64 (a + 8 * k)) (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64) d.σ.mem d.σ
  simp only [push_address space.room, address, read.toNat] at run
  obtain ⟨nb, after, _, hb, post⟩ := run space.window.lower space.window.upper
    space.window.htif space.window.aligned (by simpa only [space.toNat] using code)
    memoryAfter (by rw [space.toNat]; exact memoryEq)
    read.lower read.upper read.htif d bp
  obtain ⟨_, hm, frame⟩ := post.extra
  refine ⟨nb, after, hb, post.good, post.pcAt, ?_, ?_, ?_, hm.trans memoryEq, frame.out, ?_⟩
  · have hp : gpr after Layout.reg_pc = some
        ((BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64) + sign_extend (m := 64) (0x000#12)) :=
      PinsHold.get post.pins ⟨1, by simp⟩
    simpa only [show sign_extend (m := 64) (0x000#12) = 0#64 from by decide,
      BitVec.add_zero, codePc_succ] using hp
  · exact PinsHold.get post.pins ⟨0, by simp⟩
  · have hp : gpr after Layout.reg_accu = some
        (sign_extend (m := 64) (bytesT8 memoryAfter (a + 8 * (k + 1)))) :=
      PinsHold.get post.pins ⟨2, by simp⟩
    have same := selected.word_frame (payload_of_repr h.toVmReprAt) (by simp [roots])
      space.payload (hm.trans (memoryEq.trans
        (congrArg (fun m => writeLog m (pushLog sp w)) dp.memory)))
      (frame.out.trans dp.frame.out)
    have current : gpr after Layout.reg_accu = some (word after (a + 8 * (k + 1))) := by
      simpa only [word, hm, bytesT_eight_eq, sign_extend,
        Sail.BitVec.signExtend, BitVec.signExtend_eq] using hp
    simpa only [same] using current
  · intro r hr
    exact frame.frame r (by revert r; decide)

end OCaml.Vm.Sim
