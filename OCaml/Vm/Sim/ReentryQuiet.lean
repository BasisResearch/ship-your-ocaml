    h.savedRootsRead.toNat, h.rootsWrite.read.toNat, (h.reads Layout.off_trapsp (by decide)).toNat, (h.reads Layout.off_trap_barrier (by decide)).toNat, (h.reads Layout.off_extern_sp (by decide)).toNat, (h.reads Layout.off_exn_bucket (by decide)).toNat, (h.reads Layout.off_backtrace_active (by decide)).toNat] at domainStep
