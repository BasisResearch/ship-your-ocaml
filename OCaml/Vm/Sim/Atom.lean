/-- ATOM reads the allocated table pointer and restores the represented atom.
All fixed data addresses come from Layout; dispatch and runtime framing remain explicit. -/
theorem atom_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {w : BitVec 32}
    (stable : MemoryStable L.runtimeOk)
    (h : ArmInput L P s .ATOM c pl cp sp high)
    (operand : OperandAt P pl (s.pc + 1) w)
    (nonnegative : 0 ≤ w.toInt)
    : ∃ c', Plus c c' ∧ Running L P {s with pc := s.pc + 2, accu := .atom (w.toInt.toNat)} c' := by
  apply accu_arm stable h (atom_word_of_binding h.atomBase (w.toInt.toNat)) (fun _ hl => by cases hl)
  intro d dp
  have table : RamReadAt Layout.sym_caml_atom_table 8 := ⟨by decide, by decide, by decide⟩
  have address : (((0x80001fa8#64) + (sign_extend (m := 64) ((0x00063#20) +++ 0x000#12))) + sign_extend (m := 64) (0x9f8#12)) = BitVec.ofNat 64 Layout.sym_caml_atom_table := by decide
  have read : bytesT4 d.σ.mem (pl.codeBase + 4 * (s.pc + 1)) = w :=
    operand.read32 h.code dp.memory
  have bp : SegSt (0x80001fa4#64)
      [⟨Register.x8, BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)⟩]
      (fun σ => Vsa.Sim.Code.CamlAtomLoaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc, ⟨(dp.frame.frame Register.x8 (by decide)).trans h.pc, trivial⟩,
      dp.good.minstret, dp.tick, atom_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have run := tr_atom (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)) d.σ.mem d.σ
  simp only [address,
    table.toNat,
    show sign_extend (m := 64) (0x008#12) = 8#64 from by decide,
    show sign_extend (m := 64) (0x004#12) = 4#64 from by decide,
    codePc_succ,
    operand.geometry.toNat,
    read,
    atom_index_offset w nonnegative] at run
  obtain ⟨nb, after, _, hb, post⟩ := run operand.geometry.lower operand.geometry.upper operand.geometry.htif table.lower table.upper table.htif d bp
  obtain ⟨_, hm, frame⟩ := post.extra
  refine ⟨nb, after, hb, post.good, post.pcAt, ?_, ?_, hm, frame.out,
    immediate_preserved frame (by decide)⟩
  · have hp : gpr after Layout.reg_pc = some
        (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 8#64) := PinsHold.get post.pins ⟨2, by simp⟩
    simpa only [show BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 8#64 =
      BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 2)) from codePc_add pl s.pc 2] using hp
  · have hp : gpr after Layout.reg_accu = some
        (sign_extend (m := 64) (bytesT8 d.σ.mem Layout.sym_caml_atom_table) +
          BitVec.ofNat 64 (8 * (w.toInt.toNat) + 8)) := PinsHold.get post.pins ⟨0, by simp⟩
    simpa only [dp.memory, word, bytesT_eight_eq, sign_extend,
      Sail.BitVec.signExtend, BitVec.signExtend_eq] using hp

