/-- Compose native setup, the GC lane's named barrier, and native represented return. -/
theorem setfield_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {base value : BitVec 64} {ofs : BitVec 32} {v : Val} {rest : List Val} {heap : Heap}
    (stable : MemoryStable L.runtimeOk) (h : ArmInput L P s .SETFIELD c pl cp sp high)
    (operand : OperandAt P pl (s.pc + 1) ofs)
    (nonnegative : 0 ≤ ofs.toInt)
    (source : valWord pl s.accu = some base)
    (stack : s.stack = v :: rest)
    (encoded : valWord pl v = some value)
    (stackRead : RamReadAt sp 8)
    (callee : ModifyCallee L P s {s with pc := s.pc + 2, accu := .unit, heap := heap, stack := rest} pl cp sp (sp + 8) high 8
      (0x8000214c#64) (BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 2))) (BitVec.ofNat 64 sp) (BitVec.ofNat 64 (8 * ofs.toInt.toNat) + base) value) :
    ∃ after, Plus c after ∧ Running L P {s with pc := s.pc + 2, accu := .unit, heap := heap, stack := rest} after := by
  apply dispatch_compose h.dispatch
  intro d dp
  obtain ⟨count, call, run, input⟩ := setfield_setup stable h operand nonnegative source stack encoded stackRead dp
  have start : Vsa.Logic.Triple (fun e => e = d)
      (fun e => PCAt (0x8000a9a8#64) e ∧ ModifyInput L P s pl cp sp high 8
        (0x8000214c#64) (BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 2))) (BitVec.ofNat 64 sp) (BitVec.ofNat 64 (8 * ofs.toInt.toNat) + base) value e) := by
    rintro e rfl
    exact ⟨call, run.toSteps, input.entry, input⟩
  obtain ⟨after, run, result⟩ := (callSeg start callee.summary.run
    (setfield_return stable (rfl) (by simp [BitVec.ofNat_add]))) d rfl
  exact ⟨_, after, run.toN_of_stepsField, result⟩

/-- Match the actual successful bytecode field update to the represented arm. -/
theorem setfield_step_arm {L : OCaml.Layout} {P : Prog} {s s' : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {base value : BitVec 64} {ofs : BitVec 32} {v : Val} {rest : List Val} {heap : Heap}
    (stable : MemoryStable L.runtimeOk) (h : ArmInput L P s .SETFIELD c pl cp sp high)
    (operand : OperandAt P pl (s.pc + 1) ofs)
    (nonnegative : 0 ≤ ofs.toInt)
    (source : valWord pl s.accu = some base)
    (stack : s.stack = v :: rest)
    (encoded : valWord pl v = some value)
    (stackRead : RamReadAt sp 8)
    (callee : ModifyCallee L P s {s with pc := s.pc + 2, accu := .unit, heap := heap, stack := rest} pl cp sp (sp + 8) high 8
      (0x8000214c#64) (BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 2))) (BitVec.ofNat 64 sp) (BitVec.ofNat 64 (8 * ofs.toInt.toNat) + base) value)
    (update : setField? s.heap s.accu ofs.toInt.toNat v = some heap)
    (step : stepI P s ⟨.SETFIELD, [ofs.toInt]⟩ = .next s') :
    ∃ after, Plus c after ∧ Running L P s' after := by
  have state : {s with pc := s.pc + 2, accu := .unit, heap := heap, stack := rest} = s' := by
    simpa [stepI, stack, update, opt, St.adv] using Res.unguard step
  rw [← state]
  exact setfield_arm stable h operand nonnegative source stack encoded stackRead callee

