/-- The native caller prepares the represented barrier input and consumes one physical stack word. -/
theorem setfield1_setup {L : OCaml.Layout} {P : Prog} {s : St} {c d : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {base value : BitVec 64} {v : Val} {rest : List Val}
    (stable : MemoryStable L.runtimeOk) (h : ArmInput L P s .SETFIELD1 c pl cp sp high)
    (source : valWord pl s.accu = some base) (stack : s.stack = v :: rest)
    (encoded : valWord pl v = some value) (read : ReadWindow (BitVec.ofNat 64 sp) 8)
    (dp : DispatchPost c .SETFIELD1 (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)) d) :
    ∃ n after, StepsN n d after ∧ ModifyInput L P s pl cp sp high 23
      (0x800021a0#64) (BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 1))) (BitVec.ofNat 64 sp + 8#64) (base + 8#64) value after := by
  have accu := represented_register h.accu source
  have selected : s.stack[0]? = some v := by simp only [stack, List.getElem?_cons_zero]
  have wordEq : word c sp = value := by
    have repr := h.stack.2 0 v selected
    simpa only [Nat.mul_zero, Nat.add_zero] using Option.some.inj (repr.symm.trans encoded)
  have natAddress : (BitVec.ofNat 64 sp).toNat = sp := by
    simpa only [Nat.mul_zero, Nat.add_zero] using stack_slot_nat h.toVmReprAt selected
  have loaded : sign_extend (m := 64) (bytesT8 d.σ.mem (BitVec.ofNat 64 sp).toNat) = value := by
    simpa only [natAddress, dp.memory, word, bytesT_eight_eq, sign_extend,
      Sail.BitVec.signExtend, BitVec.signExtend_eq] using wordEq
  have bp : SegSt (0x80002190#64) [⟨Register.x9, BitVec.ofNat 64 sp⟩, ⟨Register.x21, base⟩]
      (fun σ => Vsa.Sim.Code.CamlSetfield1PrefixLoaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc, ⟨(dp.frame.frame Register.x9 (by decide)).trans h.spReg,
      (dp.frame.frame Register.x21 (by decide)).trans accu, trivial⟩,
      dp.good.minstret, dp.tick, setfield1_prefix_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have native := tr_setfield1_prefix (BitVec.ofNat 64 sp) base d.σ.mem d.σ
  simp only [show sign_extend (m := 64) (0x000#12) = 0#64 from rfl, BitVec.add_zero] at native
  obtain ⟨n, after, _, run, post⟩ := native read.lower read.upper read.htif value (by rw [loaded]) d bp
  obtain ⟨_, memory, frame⟩ := post.extra
  have setup : ModifySetup c 23 (0x800021a0#64) (BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 1))) (BitVec.ofNat 64 sp + 8#64) (base + 8#64) value after := by
    refine {
      good := post.good, image := image_of_writeLog (log := []) (dp.image h.dispatch.image) ⟨trivial, trivial⟩ memory,
      minstret := post.good.minstret, raReg := PinsHold.get post.pins ⟨0, by simp⟩,
      aligned := by decide, tick := post.tick, entry := post.pcAt,
      code := ?_, stack := ?_, slot := ?_, value := PinsHold.get post.pins ⟨3, by simp⟩,
      memory := memory.trans dp.memory, output := frame.out.trans dp.frame.out,
      preserved := fun r hr => (frame.frame r (by revert r; decide)).trans (dp.frame.frame r (by revert r; decide)) }
    · have observed : gpr after 23 = some (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64) :=
        (frame.frame Register.x23 (by decide)).trans dp.nextCode
      simpa only [codePc_succ] using observed
    · have observed : gpr after Layout.reg_sp = some (BitVec.ofNat 64 sp + sign_extend (m := 64) (0x008#12)) :=
        PinsHold.get post.pins ⟨1, by simp⟩
      simpa only [show sign_extend (m := 64) (0x008#12) = 8#64 from by decide] using observed
    · have observed : gpr after 10 = some (base + sign_extend (m := 64) (0x008#12)) :=
        PinsHold.get post.pins ⟨2, by simp⟩
      simpa only [show sign_extend (m := 64) (0x008#12) = 8#64 from by decide, BitVec.add_zero] using observed
  exact ⟨n, after, run, modify_input stable h.toVmReprAt h.running.platform h.dispatch.loop setup⟩

/-- Represented fixed-field mutation, conditional on the GC lane's named barrier summary. -/
theorem setfield1_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {base value : BitVec 64} {v : Val} {rest : List Val} {heap : Heap}
    (stable : MemoryStable L.runtimeOk) (h : ArmInput L P s .SETFIELD1 c pl cp sp high)
    (source : valWord pl s.accu = some base) (stack : s.stack = v :: rest)
    (encoded : valWord pl v = some value) (read : ReadWindow (BitVec.ofNat 64 sp) 8)
    (callee : ModifyCallee L P s {s with pc := s.pc + 1, accu := .unit, heap := heap, stack := rest} pl cp sp (sp + 8) high 23
      (0x800021a0#64) (BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 1))) (BitVec.ofNat 64 sp + 8#64) (base + 8#64) value) :
    ∃ after, Plus c after ∧ Running L P {s with pc := s.pc + 1, accu := .unit, heap := heap, stack := rest} after := by
  apply dispatch_compose h.dispatch
  intro d dp
  obtain ⟨n, call, run, input⟩ := setfield1_setup stable h source stack encoded read dp
  have start : Vsa.Logic.Triple (fun e => e = d)
      (fun e => PCAt (0x8000a9a8#64) e ∧ ModifyInput L P s pl cp sp high 23
        (0x800021a0#64) (BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 1))) (BitVec.ofNat 64 sp + 8#64) (base + 8#64) value e) := by
    rintro e rfl
    exact ⟨call, run.toSteps, input.entry, input⟩
  have stackFits : (BitVec.ofNat 64 sp + 8#64) = BitVec.ofNat 64 (sp + 8) := by simp [BitVec.ofNat_add]
  obtain ⟨after, run, result⟩ := (callSeg start callee.summary.run (setfield1_return stable rfl stackFits)) d rfl
  exact ⟨_, after, run.toN_of_stepsField, result⟩

/-- Match the successful source field update to the composed represented arm. -/
theorem setfield1_step_arm {L : OCaml.Layout} {P : Prog} {s s' : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {base value : BitVec 64} {v : Val} {rest : List Val} {heap : Heap}
    (stable : MemoryStable L.runtimeOk) (h : ArmInput L P s .SETFIELD1 c pl cp sp high)
    (source : valWord pl s.accu = some base) (stack : s.stack = v :: rest)
    (encoded : valWord pl v = some value) (read : ReadWindow (BitVec.ofNat 64 sp) 8)
    (callee : ModifyCallee L P s {s with pc := s.pc + 1, accu := .unit, heap := heap, stack := rest} pl cp sp (sp + 8) high 23
      (0x800021a0#64) (BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 1))) (BitVec.ofNat 64 sp + 8#64) (base + 8#64) value)
    (update : setField? s.heap s.accu 1 v = some heap)
    (step : stepI P s ⟨.SETFIELD1, []⟩ = .next s') :
    ∃ after, Plus c after ∧ Running L P s' after := by
  have state : {s with pc := s.pc + 1, accu := .unit, heap := heap, stack := rest} = s' := by
    simpa only [stepI, stack, update, opt, St.adv, List.length_nil, Nat.add_zero, Res.next.injEq] using step
  rw [← state]
  exact setfield1_arm stable h source stack encoded read callee

