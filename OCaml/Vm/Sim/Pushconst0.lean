        ((0#64) + sign_extend (m := 64) (0x001#12)) :=
      PinsHold.get post.pins ⟨0, by simp⟩
    simpa only [show (0#64) + sign_extend (m := 64) (0x001#12) = tag64 (0#63) from by decide] using hp
