/-- Both generated native paths implement the successful LEINT semantic step. -/
theorem leint_step_arm {L : OCaml.Layout} {P : Prog} {s s' : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat}
    (stable : MemoryStable L.runtimeOk)
    (h : ArmInput L P s .LEINT c pl cp sp high)
    (read : ReadWindow (BitVec.ofNat 64 sp) 8)
    (step : stepI P s ⟨.LEINT, []⟩ = .next s') :
    ∃ c', Plus c c' ∧ Running L P s' c' := by
  have step' : cmpOp s (fun a b => a.sle b) = .next s' := step
  obtain ⟨m, n, rest, accu, stack, state⟩ := cmpOp_next step'
