  | false =>
    simp only [test, Val.ofBool] at state
    rw [← state]
    exact leint_false_arm stable h accu stack read test
  | true =>
    simp only [test, Val.ofBool] at state
    rw [← state]
    exact leint_true_arm stable h accu stack read test

end OCaml.Vm.Sim
