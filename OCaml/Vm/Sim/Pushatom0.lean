/-- PUSHATOM0 saves the accumulator and restores the complete represented result.
Stack placement/separation and runtime window stability remain explicit obligations. -/
theorem pushatom0_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {w : BitVec 64}
    (stable : WindowStable L.runtimeOk [⟨sp - 8, sp⟩])
    (h : ArmInput L P s .PUSHATOM0 c pl cp sp high)
    (space : PushWriteOk P s c pl cp sp w)
    (pushed : valWord pl s.accu = some w) :
    ∃ c', Plus c c' ∧ Running L P
      {s with pc := s.pc + 1, accu := .atom (0), stack := s.accu :: s.stack} c' := by
  have source := represented_register h.accu pushed
  apply push_value_arm stable h space pushed (atom_word_of_binding h.atomBase (0)) (fun _ hl => by cases hl)
  intro d dp
  have code : sp - 8 + 8 ≤ 0x80001fc4 ∨ 0x80001fe0 ≤ sp - 8 :=
    space.code (by decide) (by decide)
  obtain ⟨memoryAfter, memoryEq⟩ : ∃ m : Std.ExtHashMap Nat (BitVec 8),
      m = writeLog d.σ.mem (pushLog sp w) := ⟨_, rfl⟩
  have table : RamReadAt Layout.sym_caml_atom_table 8 := ⟨by decide, by decide, by decide⟩
  have address : (((0x80001fcc#64) + (sign_extend (m := 64) ((0x00063#20) +++ 0x000#12))) + sign_extend (m := 64) (0x9d4#12)) = BitVec.ofNat 64 Layout.sym_caml_atom_table := by decide
  have tableRead := space.word_read space.payload.atomBase (memoryEq.trans
    (congrArg (fun m => writeLog m (pushLog sp w)) dp.memory))
  have bp : SegSt (0x80001fc4#64)
      [⟨Register.x9, BitVec.ofNat 64 sp⟩,
       ⟨Register.x21, w⟩,
       ⟨Register.x23, BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64⟩]
      (fun σ => Vsa.Sim.Code.CamlPushatom0Loaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc,
      ⟨(dp.frame.frame Register.x9 (by decide)).trans h.spReg,
       (dp.frame.frame Register.x21 (by decide)).trans source,
       dp.nextCode, trivial⟩,
      dp.good.minstret, dp.tick, pushatom0_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have run := tr_pushatom0 (BitVec.ofNat 64 sp) (w) (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64) d.σ.mem d.σ
  simp only [push_address space.room] at run
  have body := run space.window.lower space.window.upper
    space.window.htif space.window.aligned (by simpa only [space.toNat] using code)
    memoryAfter (by rw [space.toNat]; exact memoryEq)
  simp only [push_address space.room, address, table.toNat, tableRead, show sign_extend (m := 64) (0x008#12) = 8#64 from by decide] at body
  obtain ⟨nb, after, _, hb, post⟩ := body
    table.lower table.upper table.htif d bp
  obtain ⟨_, hm, frame⟩ := post.extra
  refine ⟨nb, after, hb, post.good, post.pcAt, ?_, ?_, ?_, hm.trans memoryEq, frame.out, ?_⟩
  · have hp : gpr after Layout.reg_pc = some
        ((BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64) + sign_extend (m := 64) (0x000#12)) :=
      PinsHold.get post.pins ⟨1, by simp⟩
    simpa only [show sign_extend (m := 64) (0x000#12) = 0#64 from by decide,
      BitVec.add_zero, codePc_succ] using hp
  · exact PinsHold.get post.pins ⟨2, by simp⟩
  · exact PinsHold.get post.pins ⟨0, by simp⟩
  · intro r hr
    exact frame.frame r (by revert r; decide)

