/-- **The F1 table's premises** from `GoodF1` and the open summaries. -/
theorem f1_premises {P : Prog} (good : OCaml.GoodF1 P) (o : F1CcallOpen P) : F1Premises P where
  c_call1_returns _ := f1_c_call1_returns good o
  c_call2_returns _ := f1_c_call2_returns good o
  c_call3_returns _ := f1_c_call3_returns good o
  c_call4_returns _ := f1_c_call4_returns good o
  c_call5_returns _ := f1_c_call5_returns good o

/-- **Layer A for F1, pinned layout**, from the open C_CALL summaries. -/
theorem ocamlrun_refinement_F1_open (growth : F1GrowthPremises)
    (o : ∀ P, OCaml.GoodF1 P → OCaml.Fits Gc.g1Budget P → GcSafe P → F1CcallOpen P) :
    OCaml.ocamlrun_refinement_F1_Statement Gc.f1Layout Gc.g1Budget :=
  ocamlrun_refinement_F1_pinned growth fun P good fits gc => f1_premises good (o P good fits gc)

