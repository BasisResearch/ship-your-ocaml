/-! GENERATED by scripts/gen_indexed_arms.py. Shared indexed-read bridge. -/
namespace OCaml.Vm.Sim
set_option autoImplicit false
open OCaml.Bytecode Vsa.Machine Vsa.Sim LeanRV64DExecutable LeanRV64DExecutable.Functions
open OCaml.Vm.Primitives

/-- GETFIELD restores a selected represented value. Operand sign and both read
windows are explicit obligations for the eventual invariant-to-arm adapter. -/
theorem getfield_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high l a k : Nat} {v : Val} {w : BitVec 32}
    (stable : MemoryStable L.runtimeOk)
    (h : ArmInput L P s .GETFIELD c pl cp sp high)
    (operand : OperandAt P pl (s.pc + 1) w)
    (nonnegative : 0 ≤ w.toInt)
    (selected : FieldSelection s.heap pl s.accu w.toInt.toNat v l a k)
    (window : RamReadAt (a + 8 * (k + w.toInt.toNat)) 8) :
    ∃ c', Plus c c' ∧ Running L P {s with pc := s.pc + 2, accu := v} c' := by
  have value := FieldSelection.read h.toVmReprAt (by simp [roots]) selected
  have root := value.root
  have source := represented_register h.accu selected.sourceWord
  apply accu_arm stable h value.word root
  intro d dp
  have read : bytesT4 d.σ.mem (pl.codeBase + 4 * (s.pc + 1)) = w :=
    operand.read32 h.code dp.memory
  have address : BitVec.ofNat 64 (a + 8 * k) + BitVec.ofNat 64 (8 * w.toInt.toNat) =
      BitVec.ofNat 64 (a + 8 * (k + w.toInt.toNat)) := by
    simp only [Nat.mul_add, ← Nat.add_assoc, BitVec.ofNat_add]
  have bp : SegSt (0x80002220#64)
      [⟨Register.x8, BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)⟩,
       ⟨Register.x21, BitVec.ofNat 64 (a + 8 * k)⟩]
      (fun σ => Vsa.Sim.Code.CamlGetfieldLoaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc,
      ⟨(dp.frame.frame Register.x8 (by decide)).trans h.pc,
       (dp.frame.frame Register.x21 (by decide)).trans source, trivial⟩,
      dp.good.minstret, dp.tick, getfield_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have run := tr_getfield (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc))
    (BitVec.ofNat 64 (a + 8 * k)) d.σ.mem d.σ
  simp only [show sign_extend (m := 64) (0x004#12) = 4#64 from by decide,
    show sign_extend (m := 64) (0x008#12) = 8#64 from by decide,
    show sign_extend (m := 64) (0x000#12) = 0#64 from by decide,
    BitVec.add_zero, codePc_succ, operand.geometry.toNat, read, index_word w nonnegative,
    show BitVec.ofNat 64 (8 * w.toInt.toNat) + BitVec.ofNat 64 (a + 8 * k) =
      BitVec.ofNat 64 (a + 8 * k) + BitVec.ofNat 64 (8 * w.toInt.toNat) from BitVec.add_comm _ _, 
    address, window.toNat] at run
  obtain ⟨nb, after, _, hb, post⟩ := run operand.geometry.lower operand.geometry.upper
    operand.geometry.htif window.lower window.upper window.htif d bp
  obtain ⟨_, hm, frame⟩ := post.extra
  refine ⟨nb, after, hb, post.good, post.pcAt, ?_, ?_, hm, frame.out,
    immediate_preserved frame (by decide)⟩
  · have hp : gpr after Layout.reg_pc = some
        (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 8#64) :=
      PinsHold.get post.pins ⟨2, by simp⟩
    simpa only [show BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 8#64 =
      BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 2)) from codePc_add pl s.pc 2] using hp
  · have hp : gpr after Layout.reg_accu = some
        (sign_extend (m := 64) (bytesT8 d.σ.mem (a + 8 * (k + w.toInt.toNat)))) :=
      PinsHold.get post.pins ⟨0, by simp⟩
    simpa only [dp.memory, word, bytesT_eight_eq, sign_extend,
      Sail.BitVec.signExtend, BitVec.signExtend_eq] using hp

end OCaml.Vm.Sim
