/-- BcSem channel preservation for SETGLOBAL; physical framing is independent. -/
theorem counted_setglobal_channels {P : Prog} {s s' : St} {args : List Int}
    (effect : stepI P s ⟨.SETGLOBAL, args⟩ = .next s') : s'.world.chans = s.world.chans := by
  rcases args with _ | ⟨a, _ | ⟨b, rest⟩⟩
  all_goals
    simp only [stepI, opt] at effect
    repeat' split at effect
    all_goals cases effect <;> rfl

