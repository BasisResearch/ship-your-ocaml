/-- PUSHGETGLOBAL saves the accumulator and restores the complete represented result.
Stack placement/separation and runtime window stability remain explicit obligations. -/
theorem pushgetglobal_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {w : BitVec 64} {operandWord : BitVec 32} {l a k : Nat} {v : Val}
    (stable : WindowStable L.runtimeOk [⟨sp - 8, sp⟩])
    (h : ArmInput L P s .PUSHGETGLOBAL c pl cp sp high)
    (space : PushWriteOk P s c pl cp sp w)
    (operand : OperandAt P pl (s.pc + 1) operandWord)
    (selected : FieldSelection s.heap pl P.globals operandWord.toInt.toNat v l a k)
    (window : RamReadAt (a + 8 * (k + operandWord.toInt.toNat)) 8)
    (nonnegative : 0 ≤ operandWord.toInt)
    (pushed : valWord pl s.accu = some w) :
    ∃ c', Plus c c' ∧ Running L P
      {s with pc := s.pc + 2, accu := v, stack := s.accu :: s.stack} c' := by
  have source := represented_register h.accu pushed
  have value := FieldSelection.read h.toVmReprAt (by simp [roots]) selected
  have globalWord : word c Layout.sym_caml_global_data = BitVec.ofNat 64 (a + 8 * k) :=
    Option.some.inj (h.globals.symm.trans selected.sourceWord)
  apply push_value_arm stable h space pushed value.word value.root
  intro d dp
  have code : sp - 8 + 8 ≤ 0x80002018 ∨ 0x80002040 ≤ sp - 8 :=
    space.code (by decide) (by decide)
  obtain ⟨memoryAfter, memoryEq⟩ : ∃ m : Std.ExtHashMap Nat (BitVec 8),
      m = writeLog d.σ.mem (pushLog sp w) := ⟨_, rfl⟩
  have read := space.operand_read32 h.code operand (memoryEq.trans
    (congrArg (fun m => writeLog m (pushLog sp w)) dp.memory))
  have address : BitVec.ofNat 64 (a + 8 * k) + BitVec.ofNat 64 (8 * operandWord.toInt.toNat) =
      BitVec.ofNat 64 (a + 8 * (k + operandWord.toInt.toNat)) := by
    simp only [Nat.mul_add, ← Nat.add_assoc, BitVec.ofNat_add]
  have globalWindow : RamReadAt Layout.sym_caml_global_data 8 := ⟨by decide, by decide, by decide⟩
  have globalAddress : (((0x80002024#64) + (sign_extend (m := 64) ((0x00062#20) +++ 0x000#12))) + sign_extend (m := 64) (0x7c4#12)) = BitVec.ofNat 64 Layout.sym_caml_global_data := by decide
  have globalRead := (space.word_read space.payload.globals (memoryEq.trans
    (congrArg (fun m => writeLog m (pushLog sp w)) dp.memory))).trans globalWord
  have bp : SegSt (0x80002018#64)
      [⟨Register.x9, BitVec.ofNat 64 sp⟩,
       ⟨Register.x21, w⟩,
       ⟨Register.x8, BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)⟩]
      (fun σ => Vsa.Sim.Code.CamlPushgetglobalLoaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc,
      ⟨(dp.frame.frame Register.x9 (by decide)).trans h.spReg,
       (dp.frame.frame Register.x21 (by decide)).trans source,
       (dp.frame.frame Register.x8 (by decide)).trans h.pc, trivial⟩,
      dp.good.minstret, dp.tick, pushgetglobal_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have run := tr_pushgetglobal (BitVec.ofNat 64 sp) (w) (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)) d.σ.mem d.σ
  simp only [push_address space.room] at run
  have body := run space.window.lower space.window.upper
    space.window.htif space.window.aligned (by simpa only [space.toNat] using code)
    memoryAfter (by rw [space.toNat]; exact memoryEq)
  simp only [show sign_extend (m := 64) (0x004#12) = 4#64 from by decide,
    codePc_succ, operand.geometry.toNat, read, globalAddress, globalWindow.toNat, globalRead, show sign_extend (m := 64) (0x000#12) = 0#64 from by decide,
    BitVec.add_zero, index_word operandWord nonnegative,
    show BitVec.ofNat 64 (8 * operandWord.toInt.toNat) + BitVec.ofNat 64 (a + 8 * k) =
      BitVec.ofNat 64 (a + 8 * k) + BitVec.ofNat 64 (8 * operandWord.toInt.toNat) from BitVec.add_comm _ _, address, window.toNat] at body
  obtain ⟨nb, after, _, hb, post⟩ := body
    operand.geometry.lower operand.geometry.upper operand.geometry.htif
    globalWindow.lower globalWindow.upper globalWindow.htif
    window.lower window.upper window.htif d bp
  obtain ⟨_, hm, frame⟩ := post.extra
  refine ⟨nb, after, hb, post.good, post.pcAt, ?_, ?_, ?_, hm.trans memoryEq, frame.out, ?_⟩
  · have hp : gpr after Layout.reg_pc = some
        (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 8#64) :=
      PinsHold.get post.pins ⟨2, by simp⟩
    simpa only [show BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 8#64 =
      BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 2)) from codePc_add pl s.pc 2] using hp
  · exact PinsHold.get post.pins ⟨4, by simp⟩
  · have hp : gpr after Layout.reg_accu = some
        (sign_extend (m := 64) (bytesT8 memoryAfter (a + 8 * (k + operandWord.toInt.toNat)))) :=
      PinsHold.get post.pins ⟨0, by simp⟩
    have same := selected.word_frame (payload_of_repr h.toVmReprAt) (by simp [roots])
      space.payload (hm.trans (memoryEq.trans
        (congrArg (fun m => writeLog m (pushLog sp w)) dp.memory)))
      (frame.out.trans dp.frame.out)
    have current : gpr after Layout.reg_accu = some (word after (a + 8 * (k + operandWord.toInt.toNat))) := by
      simpa only [word, hm, bytesT_eight_eq, sign_extend,
        Sail.BitVec.signExtend, BitVec.signExtend_eq] using hp
    simpa only [same] using current
  · intro r hr
    exact frame.frame r (by revert r; decide)

end OCaml.Vm.Sim
