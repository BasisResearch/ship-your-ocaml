/-- ORINT consumes the represented top stack integer and returns its modular result.
Dispatch readiness, runtime frame and the total-read window remain explicit. -/
theorem orint_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat} {m n : BitVec 63} {rest : List Val}
    (stable : MemoryStable L.runtimeOk)
    (h : ArmInput L P s .ORINT c pl cp sp high)
    (accu : s.accu = .int m) (stack : s.stack = .int n :: rest)
    (read : ReadWindow (BitVec.ofNat 64 sp) 8)
    :
    ∃ c', Plus c c' ∧
      Running L P {s with pc := s.pc + 1, accu := .int (untag (tag64 m ||| tag64 n)), stack := rest} c' := by
  have selected : s.stack[0]? = some (.int n) := by simp only [stack, List.getElem?_cons_zero]
  have source := represented_register h.accu (by rw [accu]; rfl : valWord pl s.accu = some (tag64 m))
  have slot := stack_integer_word h.toVmReprAt stack
  have natAddress : (BitVec.ofNat 64 sp).toNat = sp := by
    simpa only [Nat.mul_zero, Nat.add_zero] using stack_slot_nat h.toVmReprAt selected
  have bound : 1 ≤ s.stack.length := by simp only [stack, List.length_cons]; omega
  have result := consume_arm (pc := s.pc + 1) (count := 1) (n := untag (tag64 m ||| tag64 n)) stable h bound
  simp only [stack, List.drop_succ_cons, List.drop_zero] at result
  apply result
  intro d dp
  have bp : SegSt (0x800035ac#64)
      [⟨Register.x9, BitVec.ofNat 64 sp⟩, ⟨Register.x23, BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64⟩, ⟨Register.x21, tag64 m⟩]
      (fun σ => Vsa.Sim.Code.CamlOrintLoaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc,
      ⟨(dp.frame.frame Register.x9 (by decide)).trans h.spReg, dp.nextCode, (dp.frame.frame Register.x21 (by decide)).trans source, trivial⟩,
      dp.good.minstret, dp.tick, orint_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have run := tr_orint (BitVec.ofNat 64 sp) (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64) (tag64 m) d.σ.mem d.σ
  simp only [show sign_extend (m := 64) (0x000#12) = 0#64 from by decide,
    BitVec.add_zero] at run
  obtain ⟨nb, after, _, hb, post⟩ := run read.lower read.upper read.htif d bp
  obtain ⟨_, hm, frame⟩ := post.extra
  refine ⟨nb, after, hb, post.good, post.pcAt, ?_, ?_, ?_, hm, frame.out,
    fun r hr => frame.frame r ?_⟩
  · have hp : gpr after Layout.reg_pc = some
        (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 4#64) := PinsHold.get post.pins ⟨2, by simp⟩
    simpa only [codePc_succ] using hp
  · have hp : gpr after Layout.reg_sp = some
        (BitVec.ofNat 64 sp + sign_extend (m := 64) (0x008#12)) := PinsHold.get post.pins ⟨1, by simp⟩
    simpa only [show sign_extend (m := 64) (0x008#12) = 8#64 from by decide,
      Nat.mul_one, BitVec.ofNat_add] using hp
  · have loaded : sign_extend (m := 64) (bytesT8 d.σ.mem (BitVec.ofNat 64 sp).toNat) = tag64 n := by
      simpa only [natAddress, dp.memory, word, bytesT_eight_eq, sign_extend,
        Sail.BitVec.signExtend, BitVec.signExtend_eq] using slot
    have hp : gpr after Layout.reg_accu = some (((tag64 m) ||| (sign_extend (m := 64) (bytesT8 d.σ.mem (BitVec.ofNat 64 sp).toNat : BitVec (8 * 8))))) :=
      PinsHold.get post.pins ⟨0, by simp⟩
    rw [loaded] at hp
    have value : gpr after Layout.reg_accu = some (tag64 m ||| tag64 n) := by
      simpa only [show sign_extend (m := 64) (0xfff#12) = -1#64 from by decide,
        show sign_extend (m := 64) (0x001#12) = 1#64 from by decide,
        BitVec.add_neg_eq_sub] using hp
    have retag : tag64 (untag (tag64 m ||| tag64 n)) = (tag64 m ||| tag64 n) :=
      tag_untag_odd _ (by simp [tag64])
    simpa only [retag] using value
  · revert r
    decide

/-- The successful semantic step supplies the integer operands; no separate
input-shape assumptions are needed by callers of this wrapper. -/
theorem orint_step_arm {L : OCaml.Layout} {P : Prog} {s s' : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat}
    (stable : MemoryStable L.runtimeOk)
    (h : ArmInput L P s .ORINT c pl cp sp high)
    (read : ReadWindow (BitVec.ofNat 64 sp) 8)
    (step : stepI P s ⟨.ORINT, []⟩ = .next s') :
    ∃ c', Plus c c' ∧ Running L P s' c' := by
  have step' : intOp s (fun a b => a ||| b) = .next s' := step
  obtain ⟨m, n, rest, accu, stack, state⟩ := intOp_next step'
  rw [← state]
  exact orint_arm stable h accu stack read

end OCaml.Vm.Sim
