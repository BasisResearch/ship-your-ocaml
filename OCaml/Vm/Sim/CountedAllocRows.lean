/-! GENERATED by scripts/gen_counted_alloc_rows.py. Nursery allocating opcode
rows reuse native execution and existing GoodF1/Fits/capacity guards. The
physical channel frame is supplied by counted_allocFrame at the entry. -/

namespace OCaml.Vm.Sim
set_option autoImplicit false
open OCaml.Bytecode Vsa.Machine OCaml.Vm.Primitives

/-- Supported allocating opcodes; GC and primitive calls remain separate. -/
def countedAllocOpcode : Opcode → Bool
  | .MAKEBLOCK => true
  | .MAKEBLOCK1 => true
  | .MAKEBLOCK2 => true
  | .MAKEBLOCK3 => true
  | .CLOSURE => true
  | .CLOSUREREC => true
  | .GRAB => true
  | _ => false

/-- BcSem channel preservation for MAKEBLOCK; physical framing is independent. -/
theorem counted_makeblock_channels {P : Prog} {s s' : St} {args : List Int}
    (effect : stepI P s ⟨.MAKEBLOCK, args⟩ = .next s') : s'.world.chans = s.world.chans := by
  rcases args with _ | ⟨a, _ | ⟨b, _ | ⟨c, rest⟩⟩⟩
  all_goals
    simp only [stepI, makeBlock] at effect
    repeat' split at effect
    all_goals cases effect <;> rfl

