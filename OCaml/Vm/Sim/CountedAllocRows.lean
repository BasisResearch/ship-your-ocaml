/-- Counted MAKEBLOCK, with every frame supplied from the actual entry runtime. -/
theorem counted_makeblock_row {P : Prog}
    {Ready : Nat → Config → Prop} {state Customs : Config → Nat → Prop}
    (custom : Gc.CustomMemCall Ready state Customs)
    (fits : OCaml.Fits Gc.f1Layout.budget P) (good : OCaml.GoodF1 P) :
    OCaml.OpArm P (CountedLoopAt Customs Gc.f1Layout P) .MAKEBLOCK :=
  counted_alloc_row custom (fun _ _ af rf stable => makeblock_row af fits g1_capacity f1_budgetSmall good)
    (fun _ i _ opcode effect => counted_makeblock_channels (P := P) (args := i.args)
      (by cases i; cases opcode; exact effect))

