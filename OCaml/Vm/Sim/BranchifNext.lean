/-- The fallthrough path of BRANCHIF, with the exact abstract false test.
The native branch guard is proved from the represented accumulator. -/
theorem branchif_next_arm {L : OCaml.Layout} {P : Prog} {s : St} {c : Config}
    {pl : Place} {cp : ChanPlace} {sp high : Nat}
    (stable : MemoryStable L.runtimeOk)
    (h : ArmInput L P s .BRANCHIF c pl cp sp high)
    (test : s.accu = .int 0)
    : ∃ c', Plus c c' ∧ Running L P {s with pc := s.pc + 2} c' := by
  apply control_arm stable h
  intro d dp accu haccu value
  have guard : (accu == 1#64) = true := by
    apply beq_iff_eq.mpr
    rw [test] at value
    exact (Option.some.inj value).symm
  have bp : SegSt (0x800030ec#64)
      [⟨Register.x21, accu⟩, ⟨Register.x8, BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)⟩]
      (fun σ => Vsa.Sim.Code.CamlBranchifNextLoaded σ.mem ∧ σ.mem = d.σ.mem ∧ σ = d.σ) d :=
    ⟨dp.good, dp.pc,
      ⟨haccu, (dp.frame.frame Register.x8 (by decide)).trans h.pc, trivial⟩,
      dp.good.minstret, dp.tick, branchif_next_loaded (dp.image h.dispatch.image), rfl, rfl⟩
  have run := tr_branchif_next accu (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc)) d.σ.mem d.σ
  simp only [
    show (0#64 + sign_extend (m := 64) (0x001#12)) = 1#64 from by decide] at run
  obtain ⟨nb, after, _, hb, post⟩ := run guard d bp
  obtain ⟨_, hm, frame⟩ := post.extra
  refine ⟨nb, after, hb, post.good, post.pcAt, ?_, ?_, hm, frame.out,
    immediate_preserved frame (by decide)⟩
  · have hp : gpr after Layout.reg_pc = some
        (BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 8#64) := PinsHold.get post.pins ⟨0, by simp⟩
    simpa only [show BitVec.ofNat 64 (pl.codeBase + 4 * s.pc) + 8#64 =
      BitVec.ofNat 64 (pl.codeBase + 4 * (s.pc + 2)) from codePc_add pl s.pc 2] using hp
  · exact (frame.frame Register.x21 (by decide)).trans haccu

end OCaml.Vm.Sim
