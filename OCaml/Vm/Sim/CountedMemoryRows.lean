/-- Counted CONST0, preserving the ordinary row's guards and reachable bounds. -/
theorem counted_const0_row {L : OCaml.Layout} {P : Prog}
    {Customs : Config → Nat → Prop} {Ready : Nat → Config → Prop} {state : Config → Nat → Prop}
    (stable : MemoryStable L.runtimeOk) (accounting : Gc.CustomAccounting Ready state Customs) :
    OCaml.OpArm P (CountedLoopAt Customs L P) .CONST0 :=
  counted_memory_row stable accounting (fun _ stable => const0_row stable)
    (fun _ i _ opcode effect => counted_const0_channels (P := P) (args := i.args)
      (by cases i; cases opcode; exact effect))

