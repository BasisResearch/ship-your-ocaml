/-- BcSem channel preservation for CONST0; physical framing is independent. -/
theorem counted_const0_channels {P : Prog} {s s' : St} {args : List Int}
    (effect : stepI P s ⟨.CONST0, args⟩ = .next s') : s'.world.chans = s.world.chans := by
  cases args
  all_goals
    simp only [stepI] at effect
    repeat' split at effect
    all_goals cases effect <;> rfl

