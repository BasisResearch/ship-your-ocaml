import OCaml.Vm.Sim.CamlMainReturnState
import OCaml.Vm.Sim.CamlMainReturnSegment
import OCaml.Vm.Sim.CamlMainReturnPins

/-! GENERATED by scripts/gen_interp_return.py. Normal native caml_main return. -/
namespace OCaml.Vm.Sim
set_option autoImplicit false
open Vsa.Machine Vsa.Sim OCaml.Vm.Primitives LeanRV64DExecutable LeanRV64DExecutable.Functions

/-- Check the normal interpreter result and restore the complete caml_main frame. -/
theorem caml_main_return {nativeSp : Nat} {saved : Nat → BitVec 64} {value : BitVec 64} {c : Config}
    (h : CamlMainReturnInput nativeSp saved value c) :
    ∃ count after, StepsN count c after ∧ CamlMainReturnPost c nativeSp saved value after := by
  have read (r : Nat) (hr : r ∈ Layout.camlMainSavedRegs) :
      sign_extend (m := 64) (bytesT8 c.σ.mem (nativeSp + Layout.camlMainSaveOffset r)) = saved r := by
    simpa only [word, bytesT_eight_eq, sign_extend, Sail.BitVec.signExtend, BitVec.signExtend_eq] using h.frame.words r hr
  have bp : SegSt (0x80004ff8#64) [⟨Register.x10, value⟩, ⟨Register.x2, BitVec.ofNat 64 nativeSp⟩]
      (fun σ => Vsa.Sim.Code.CamlCamlMainReturnLoaded σ.mem ∧ σ.mem = c.σ.mem ∧ σ = c.σ) c :=
    ⟨h.good, h.pc, ⟨h.value, h.stack, trivial⟩, h.good.minstret, h.tick, caml_main_return_loaded h.image, rfl, rfl⟩
  have native := tr_caml_main_return value (BitVec.ofNat 64 nativeSp) c.σ.mem c.σ
  simp only [show sign_extend (m := 64) (0x060#12) = BitVec.ofNat 64 (Layout.camlMainSaveOffset 8) from by decide,
    (h.frame.reads 8 (by decide)).toNat,
    show sign_extend (m := 64) (0x068#12) = BitVec.ofNat 64 (Layout.camlMainSaveOffset 1) from by decide,
    (h.frame.reads 1 (by decide)).toNat,
    show sign_extend (m := 64) (0x050#12) = BitVec.ofNat 64 (Layout.camlMainSaveOffset 18) from by decide,
    (h.frame.reads 18 (by decide)).toNat,
    show sign_extend (m := 64) (0x048#12) = BitVec.ofNat 64 (Layout.camlMainSaveOffset 19) from by decide,
    (h.frame.reads 19 (by decide)).toNat,
    show sign_extend (m := 64) (0x040#12) = BitVec.ofNat 64 (Layout.camlMainSaveOffset 20) from by decide,
    (h.frame.reads 20 (by decide)).toNat,
    show sign_extend (m := 64) (0x058#12) = BitVec.ofNat 64 (Layout.camlMainSaveOffset 9) from by decide,
    (h.frame.reads 9 (by decide)).toNat,
    show sign_extend (m := 64) (0x070#12) = BitVec.ofNat 64 Layout.camlMainFrameBytes from by decide,
    ← BitVec.ofNat_add] at native
  have target : Sail.BitVec.update (saved 1 + sign_extend (m := 64) (0x000#12)) 0 0#1 = saved 1 := by
    simpa only [show sign_extend (m := 64) (0x000#12) = 0#64 from rfl, BitVec.add_zero] using ret_tgt (saved 1) h.aligned
  obtain ⟨count, after, _, run, post⟩ := native (by simpa only [show sign_extend (m := 64) (0x003#12) = 3#64 from rfl, show (0#64) + sign_extend (m := 64) (0x002#12) = 2#64 from rfl, beq_eq_false_iff_ne] using h.ordinary) (h.frame.reads 8 (by decide)).lower (h.frame.reads 8 (by decide)).upper (h.frame.reads 8 (by decide)).htif
    (saved 8) (read 8 (by decide)).symm
    (h.frame.reads 1 (by decide)).lower (h.frame.reads 1 (by decide)).upper (h.frame.reads 1 (by decide)).htif
    (saved 1) (read 1 (by decide)).symm
    (h.frame.reads 18 (by decide)).lower (h.frame.reads 18 (by decide)).upper (h.frame.reads 18 (by decide)).htif
    (saved 18) (read 18 (by decide)).symm
    (h.frame.reads 19 (by decide)).lower (h.frame.reads 19 (by decide)).upper (h.frame.reads 19 (by decide)).htif
    (saved 19) (read 19 (by decide)).symm
    (h.frame.reads 20 (by decide)).lower (h.frame.reads 20 (by decide)).upper (h.frame.reads 20 (by decide)).htif
    (saved 20) (read 20 (by decide)).symm
    (h.frame.reads 9 (by decide)).lower (h.frame.reads 9 (by decide)).upper (h.frame.reads 9 (by decide)).htif
    (saved 9) (read 9 (by decide)).symm
    (by rw [target]; exact h.aligned) c bp
  obtain ⟨_, memory, frame⟩ := post.extra
  refine ⟨count, after, run, post.good, image_of_writeLog (log := []) h.image ⟨trivial, trivial⟩ memory,
    post.tick, ?_, ?_, ?_, ?_, memory, frame.widenChecked (allowed := camlMainReturnWrites) (by decide)⟩
  · have observed : pcOf after = some (Sail.BitVec.update (saved 1 + sign_extend (m := 64) (0x000#12)) 0 0#1) := post.pcAt
    simpa only [target] using observed
  · exact PinsHold.get post.pins ⟨0, by simp⟩
  · exact PinsHold.get post.pins ⟨9, by simp⟩
  · intro r member
    simp only [Layout.camlMainSavedRegs, List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl | rfl | rfl | rfl | rfl
    · exact PinsHold.get post.pins ⟨5, by simp⟩
    · exact PinsHold.get post.pins ⟨6, by simp⟩
    · exact PinsHold.get post.pins ⟨1, by simp⟩
    · exact PinsHold.get post.pins ⟨4, by simp⟩
    · exact PinsHold.get post.pins ⟨3, by simp⟩
    · exact PinsHold.get post.pins ⟨2, by simp⟩

end OCaml.Vm.Sim
