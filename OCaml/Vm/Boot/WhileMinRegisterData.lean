  sig_seip := ⟨_, get_sig_seip⟩
  mtime := ⟨_, get_mtime⟩
  mtimecmp := ⟨_, get_mtimecmp⟩
  minstret := ⟨_, get_minstret⟩
  minstret_increment := ⟨_, get_minstret_increment⟩
