    simpa only [Nat.add_sub_cancel' low] using code_120_144 memory ⟨i - 120, index⟩
  by_cases h168 : i < 168
  · have low : 144 ≤ i := by omega
    have index : i - 144 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using code_144_168 memory ⟨i - 144, index⟩
  by_cases h191 : i < 191
  · have low : 168 ≤ i := by omega
    have index : i - 168 < 23 := by omega
    simpa only [Nat.add_sub_cancel' low] using code_168_191 memory ⟨i - 168, index⟩
