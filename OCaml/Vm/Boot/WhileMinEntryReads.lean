theorem code (memory : Vsa.Densify.MemEqv c.σ.mem (observedMem initial log)) :
    ∀ i w, whileMin.code[i]? = some w → word32 c (place.codeBase + 4 * i) = w := by
  intro i w hi
  change (whileMinCode.map (BitVec.ofNat 32)).toArray[i]? = some w at hi
  rw [List.getElem?_toArray] at hi
  obtain ⟨bound, rfl⟩ := List.getElem?_eq_some_iff.mp hi
  have size : i < 191 := bound
  by_cases h24 : i < 24
  · have low : 0 ≤ i := by omega
    have index : i - 0 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using code_0_24 memory ⟨i - 0, index⟩
  by_cases h48 : i < 48
  · have low : 24 ≤ i := by omega
    have index : i - 24 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using code_24_48 memory ⟨i - 24, index⟩
  by_cases h72 : i < 72
  · have low : 48 ≤ i := by omega
    have index : i - 48 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using code_48_72 memory ⟨i - 48, index⟩
  by_cases h96 : i < 96
  · have low : 72 ≤ i := by omega
    have index : i - 72 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using code_72_96 memory ⟨i - 72, index⟩
  by_cases h120 : i < 120
  · have low : 96 ≤ i := by omega
    have index : i - 96 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using code_96_120 memory ⟨i - 96, index⟩
  by_cases h144 : i < 144
  · have low : 120 ≤ i := by omega
