  by_cases h25 : i < 25
  · have low : 1 ≤ i := by omega
    have index : i - 1 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using bin_lists_1_25 ⟨i - 1, index⟩
  by_cases h49 : i < 49
  · have low : 25 ≤ i := by omega
    have index : i - 25 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using bin_lists_25_49 ⟨i - 25, index⟩
  by_cases h73 : i < 73
  · have low : 49 ≤ i := by omega
    have index : i - 49 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using bin_lists_49_73 ⟨i - 49, index⟩
  by_cases h97 : i < 97
  · have low : 73 ≤ i := by omega
    have index : i - 73 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using bin_lists_73_97 ⟨i - 73, index⟩
  by_cases h121 : i < 121
  · have low : 97 ≤ i := by omega
    have index : i - 97 < 24 := by omega
