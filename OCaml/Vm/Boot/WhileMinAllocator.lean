    ∃ c ∈ chunks, c.addr = q ∧ c.inuse = false ∧ (1 < i → binIndex c.size = i) := by
  intro i q _ _ member
  by_cases h1 : i = 1
  · subst i
    have members : q ∈ [0x8038dbd0] := member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at members
    subst q
    exact ⟨chunk27, member27, rfl, rfl, by decide⟩
  by_cases h10 : i = 10
  · subst i
    have members : q ∈ [0x8007d6a0, 0x8007d630] := member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at members
    rcases members with rfl | rfl
    · exact ⟨chunk10, member10, rfl, rfl, by decide⟩
    · exact ⟨chunk8, member8, rfl, rfl, by decide⟩
  simp [bins, *] at member

