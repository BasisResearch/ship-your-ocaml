theorem cert_cons {α : Type} {P : α → Prop} {x : α} {xs : List α}
    (head : P x) (tail : ∀ y ∈ xs, P y) : ∀ y ∈ x :: xs, P y := by
  intro y hy
  rcases List.mem_cons.mp hy with rfl | hy
  · exact head
  · exact tail y hy

