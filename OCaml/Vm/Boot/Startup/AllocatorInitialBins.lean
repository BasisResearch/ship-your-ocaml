theorem initial_bin_links (i : Nat) (lo : 1 ≤ i) (hi : i < numBins) :
    bytesT WhileMinImage.initialMem (binAt i + 16) 8 = BitVec.ofNat 64 (binAt i) ∧
      bytesT WhileMinImage.initialMem (binAt i + 24) 8 = BitVec.ofNat 64 (binAt i) := by
  have bound : i < 128 := hi
  by_cases h25 : i < 25
  · have low : 1 ≤ i := by omega
    have index : i - 1 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using initial_bin_links_1_25 ⟨i - 1, index⟩
  by_cases h49 : i < 49
  · have low : 25 ≤ i := by omega
    have index : i - 25 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using initial_bin_links_25_49 ⟨i - 25, index⟩
  by_cases h73 : i < 73
  · have low : 49 ≤ i := by omega
    have index : i - 49 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using initial_bin_links_49_73 ⟨i - 49, index⟩
  by_cases h97 : i < 97
  · have low : 73 ≤ i := by omega
    have index : i - 73 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using initial_bin_links_73_97 ⟨i - 73, index⟩
  by_cases h121 : i < 121
  · have low : 97 ≤ i := by omega
    have index : i - 97 < 24 := by omega
    simpa only [Nat.add_sub_cancel' low] using initial_bin_links_97_121 ⟨i - 97, index⟩
  by_cases h128 : i < 128
  · have low : 121 ≤ i := by omega
    have index : i - 121 < 7 := by omega
    simpa only [Nat.add_sub_cancel' low] using initial_bin_links_121_128 ⟨i - 121, index⟩
  omega

end OCaml.Vm.Boot.Startup
