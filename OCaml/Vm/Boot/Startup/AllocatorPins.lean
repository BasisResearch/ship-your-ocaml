def allocatorImpureAddr : Nat := 0x800648f8
def allocatorImpureByte (i : Nat) : BitVec 8 :=
  match i with
  | 0 => 0x68#8
  | 1 => 0x46#8
  | 2 => 0x6#8
  | 3 => 0x80#8
  | 4 => 0x0#8
  | 5 => 0x0#8
  | 6 => 0x0#8
  | 7 => 0x0#8
  | _ => 0#8

