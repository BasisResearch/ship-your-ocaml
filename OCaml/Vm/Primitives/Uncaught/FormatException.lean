  ⟨0x8000ddfc#64, 0x17813a83#32, 0x83#8, 0x3a#8, 0x81#8, 0x17#8, .ld, 21, 2, 0, 0x178#12⟩,
  ⟨0x8000de00#64, 0x00048513#32, 0x13#8, 0x85#8, 0x04#8, 0x00#8, .addi, 10, 9, 0, 0x000#12⟩,
  ⟨0x8000de04#64, 0x19813483#32, 0x83#8, 0x34#8, 0x81#8, 0x19#8, .ld, 9, 2, 0, 0x198#12⟩,
  ⟨0x8000de08#64, 0x1b010113#32, 0x13#8, 0x01#8, 0x01#8, 0x1b#8, .addi, 2, 2, 0, 0x1b0#12⟩
]
def leave_term : TInstr := ⟨0x8000de0c#64, 0x00008067#32, 0x67#8, 0x80#8, 0x00#8, 0x00#8, .jr, 1, 0, 0#13, 0#21, 0x000#12⟩
def leave_blocks : List BBlock := [{ body := leave_body, term := some leave_term }]
def leave_input (R : Nat → BitVec 64) : GRegs := [(2, R 2), (9, R 9)]

theorem leave_code {c : Config} (image : ExecutableImage c) : CodeFacts c.σ.mem leave_body := by
  have hc := loaded image
  simp only [CodeFacts, leave_body]
  chain_facts hc with "Vsa.Sim.Code.caml_format_exception_at_"

theorem leave_shape : ChainOK 0x8000ddec#64 [2, 9] leave_blocks := by
  simp only [ChainOK, BBlockOK, leave_blocks, leave_body, leave_term, BlockOKM]
  repeat' apply And.intro
  all_goals decide

theorem leave_summary (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (loads : List (List (BitVec 8))) (h : LeafInput ra c)
    (regs : GHolds c.σ (leave_input R))
    (access : AccessPlan c.σ.mem (leave_input R) loads leave_body)
    (control : TermFactsO (runGM leave_body (leave_input R) loads) (some leave_term)) :
    FnSummary 0x8000ddec#64 (fun d => d = c)
      (BlockPost leave_blocks 0x8000ddec#64 (leave_input R) loads c) := by
  apply block_summary leave_blocks _ _ _ c
  refine ⟨h.good, h.minstret, regs, ?_, ?_, leave_shape, h.tick⟩
  · change KeysOK [2, 9]; decide
  · apply singleton_chain_facts (accessPlan_facts (leave_code h.image) access) ?_ control
    have hc := loaded h.image
    chain_facts hc with "Vsa.Sim.Code.caml_format_exception_at_"

def leave_regs (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : GRegs :=
  [(2, R 2 + 432#64), (9, bytesVal .ld (loads.getD 5 [])), (10, R 9), (21, bytesVal .ld (loads.getD 4 [])), (20, bytesVal .ld (loads.getD 3 [])), (18, bytesVal .ld (loads.getD 2 [])), (8, bytesVal .ld (loads.getD 1 [])), (1, bytesVal .ld (loads.getD 0 []))]
theorem leave_eval (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    runGM leave_body (leave_input R) loads = leave_regs R loads := by
  simp [leave_body, leave_input, leave_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
    Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, List.head?_eq_getElem?, BitVec.add_assoc]

def leave_loads (m : Std.ExtHashMap Nat (BitVec 8)) (R : Nat → BitVec 64) : List (List (BitVec 8)) :=
  [read8 m (R 2 + 424#64).toNat, read8 m (R 2 + 416#64).toNat, read8 m (R 2 + 400#64).toNat, read8 m (R 2 + 384#64).toNat, read8 m (R 2 + 376#64).toNat, read8 m (R 2 + 408#64).toNat]

theorem leave_fast (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (h : LeafInput (R 1) c) (regs : GHolds c.σ (leave_input R))
    (w0 : ReadWindow (R 2 + 424#64) 8)
    (w1 : ReadWindow (R 2 + 416#64) 8)
    (w2 : ReadWindow (R 2 + 400#64) 8)
    (w3 : ReadWindow (R 2 + 384#64) 8)
    (w4 : ReadWindow (R 2 + 376#64) 8)
    (w5 : ReadWindow (R 2 + 408#64) 8)
    (savedRa : bytesVal .ld (read8 c.σ.mem (R 2 + 424#64).toNat) = ra) (aligned : ra.toNat % 4 = 0) :
    FnSummary 0x8000ddec#64 (fun d => d = c)
      (WriteRegistersPost [1, 2, 8, 9, 10, 18, 20, 21] [] c (ra) (R 9) (leave_regs R (leave_loads c.σ.mem R))) := by
  have access : AccessPlan c.σ.mem (leave_input R) (leave_loads c.σ.mem R) leave_body := by
    simp only [AccessPlan, leave_body, leave_loads]
    chain_facts True.intro
    · apply w0.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, leave_input]
    · apply w1.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, leave_input]
    · apply w2.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, leave_input]
    · apply w3.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, leave_input]
    · apply w4.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, leave_input]
    · apply w5.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, leave_input]
  have control : TermFactsO (runGM leave_body (leave_input R) (leave_loads c.σ.mem R)) (some leave_term) := by rw [leave_eval]; exact return_facts _ rfl rfl rfl (by simpa [leave_regs, srcVal, lookupG, leave_loads] using savedRa) aligned
  apply registers_of_blocks h.image (log := []) ⟨True.intro, True.intro⟩ (leave_summary c (R 1) R _ h regs access control)
  · exact readonly_log _ (by unfold ReadOnlyBody; decide) _ _
  · change tgtPCT leave_term (runGM leave_body (leave_input R) (leave_loads c.σ.mem R)) = ra
    rw [leave_eval]
    change Sail.BitVec.update (bytesVal .ld ((leave_loads c.σ.mem R).getD 0 []) + Functions.sign_extend (m := 64) (0#12)) 0 0#1 = ra
    simp only [leave_loads, List.getD_cons_zero, List.getD_cons_succ]
    rw [savedRa]
    exact ret_tgt ra aligned
  · exact leave_eval R _
  · rfl
  · decide

end OCaml.Vm.Primitives.Uncaught.FormatException
