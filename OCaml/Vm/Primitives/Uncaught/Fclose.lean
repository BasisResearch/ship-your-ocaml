  []

theorem pro_fast (c : Config) (R : Nat → BitVec 64)
    (h : LeafInput (R 1) c) (regs : GHolds c.σ (pro_input R))
    (w0 : WriteWindow (R 2 + 18446744073709551584#64 + 24#64) 8)
    (w1 : WriteWindow (R 2 + 18446744073709551584#64) 8)
    (outside : ImageOutside (proLog R (pro_loads c.σ.mem R)))
    (ok : guardB .BEQ (R 11) (0#64) = false) :
    FnSummary 0x8004ce68#64 (fun d => d = c)
      (WriteRegistersPost [2] (proLog R (pro_loads c.σ.mem R)) c (0x8004ce78#64) (R 10) (pro_regs R (pro_loads c.σ.mem R))) := by
  have access : AccessPlan c.σ.mem (pro_input R) (pro_loads c.σ.mem R) pro_body := by
    simp only [AccessPlan, pro_body, pro_loads]
    chain_facts True.intro
    · apply w0.sd rfl
      simp only [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, ↓reduceIte, Nat.reduceEqDiff, Option.getD_some, List.headD_cons, BitVec.add_zero, pro_input, shamtOf, Sail.BitVec.extractLsb, (show BitVec.signExtend 64 4064#12 = 18446744073709551584#64 by decide), show BitVec.signExtend 64 0#12 = 0#64 by decide, show BitVec.signExtend 64 24#12 = 24#64 by decide]
    · apply w1.sd rfl
      simp only [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, ↓reduceIte, Nat.reduceEqDiff, Option.getD_some, List.headD_cons, BitVec.add_zero, pro_input, shamtOf, Sail.BitVec.extractLsb, (show BitVec.signExtend 64 4064#12 = 18446744073709551584#64 by decide), show BitVec.signExtend 64 0#12 = 0#64 by decide, show BitVec.signExtend 64 24#12 = 24#64 by decide]
  have control : TermFactsO (runGM pro_body (pro_input R) (pro_loads c.σ.mem R)) (some pro_term) := by rw [pro_eval]; exact ok
  apply registers_of_blocks h.image outside (pro_summary c (R 1) R _ h regs access control)
  · exact pro_log_eq R _
  · rfl
  · exact pro_eval R _
  · rfl
  · decide

