theorem pro_eval (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    runGM pro_body (pro_input R) loads = pro_regs R loads := by
  simp [pro_body, pro_input, pro_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
