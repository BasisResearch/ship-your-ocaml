def pro_input (R : Nat → BitVec 64) : GRegs := [(1, R 1), (2, R 2), (10, R 10), (11, R 11), (18, R 18)]

theorem pro_code {c : Config} (image : ExecutableImage c) : CodeFacts c.σ.mem pro_body := by
  have hc := loaded image
  simp only [CodeFacts, pro_body]
  chain_facts hc with "Vsa.Sim.Code._fclose_r_at_"

theorem pro_shape : ChainOK 0x8004ce68#64 [1, 2, 10, 11, 18] pro_blocks := by
  simp only [ChainOK, BBlockOK, pro_blocks, pro_body, pro_term, BlockOKM]
  repeat' apply And.intro
  all_goals decide

theorem pro_summary (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (loads : List (List (BitVec 8))) (h : LeafInput ra c)
    (regs : GHolds c.σ (pro_input R))
    (access : AccessPlan c.σ.mem (pro_input R) loads pro_body)
    (control : TermFactsO (runGM pro_body (pro_input R) loads) (some pro_term)) :
    FnSummary 0x8004ce68#64 (fun d => d = c)
      (BlockPost pro_blocks 0x8004ce68#64 (pro_input R) loads c) := by
  apply block_summary pro_blocks _ _ _ c
  refine ⟨h.good, h.minstret, regs, ?_, ?_, pro_shape, h.tick⟩
  · change KeysOK [1, 2, 10, 11, 18]; decide
  · apply singleton_chain_facts (accessPlan_facts (pro_code h.image) access) ?_ control
    have hc := loaded h.image
    chain_facts hc with "Vsa.Sim.Code._fclose_r_at_"

