    (loads : List (List (BitVec 8))) (h : LeafInput ra c)
    (regs : GHolds c.σ (pro_input R))
    (access : AccessPlan c.σ.mem (pro_input R) loads pro_body)
    (control : TermFactsO (runGM pro_body (pro_input R) loads) (none)) :
    FnSummary 0x8003f65c#64 (fun d => d = c)
      (BlockPost pro_blocks 0x8003f65c#64 (pro_input R) loads c) := by
