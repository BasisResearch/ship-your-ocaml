  ⟨0x8000c1e8#64, 0x00e78023#32, 0x23#8, 0x80#8, 0xe7#8, 0x00#8, .sb, 0, 15, 14, 0x000#12⟩,
  ⟨0x8000c1ec#64, 0x02813083#32, 0x83#8, 0x30#8, 0x81#8, 0x02#8, .ld, 1, 2, 0, 0x028#12⟩,
  ⟨0x8000c1f0#64, 0x03010113#32, 0x13#8, 0x01#8, 0x01#8, 0x03#8, .addi, 2, 2, 0, 0x030#12⟩
]
def initialize_term : TInstr := ⟨0x8000c1f4#64, 0x00008067#32, 0x67#8, 0x80#8, 0x00#8, 0x00#8, .jr, 1, 0, 0#13, 0#21, 0x000#12⟩
def initialize_blocks : List BBlock := [{ body := initialize_body, term := some initialize_term }]
def initialize_input (R : Nat → BitVec 64) : GRegs := [(1, R 1), (2, R 2), (10, R 10), (13, R 13), (14, R 14), (15, R 15), (16, R 16)]

theorem initialize_code {c : Config} (image : ExecutableImage c) : CodeFacts c.σ.mem initialize_body := by
  have hc := loaded image
  simp only [CodeFacts, initialize_body]
  chain_facts hc with "Vsa.Sim.Code.caml_alloc_string_at_"

theorem initialize_shape : ChainOK 0x8000c1bc#64 [1, 2, 10, 13, 14, 15, 16] initialize_blocks := by
  simp only [ChainOK, BBlockOK, initialize_blocks, initialize_body, initialize_term, BlockOKM]
  repeat' apply And.intro
  all_goals decide

theorem initialize_summary (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (loads : List (List (BitVec 8))) (h : LeafInput ra c)
    (regs : GHolds c.σ (initialize_input R))
    (access : AccessPlan c.σ.mem (initialize_input R) loads initialize_body)
    (control : TermFactsO (runGM initialize_body (initialize_input R) loads) (some initialize_term)) :
    FnSummary 0x8000c1bc#64 (fun d => d = c)
      (BlockPost initialize_blocks 0x8000c1bc#64 (initialize_input R) loads c) := by
  apply block_summary initialize_blocks _ _ _ c
  refine ⟨h.good, h.minstret, regs, ?_, ?_, initialize_shape, h.tick⟩
  · change KeysOK [1, 2, 10, 13, 14, 15, 16]; decide
  · apply singleton_chain_facts (accessPlan_facts (initialize_code h.image) access) ?_ control
    have hc := loaded h.image
    chain_facts hc with "Vsa.Sim.Code.caml_alloc_string_at_"

def reserve_regs (R : Nat → BitVec 64) (bd byoung blimit : List (BitVec 8)) : GRegs :=
  [(13, bytesVal .ld byoung - 8#64 - R 15), (17, bytesVal .ld blimit),
   (11, -8#64 - R 15), (12, bytesVal .ld bd), (16, DoubleAllocation.domainGlobal),
   (1, R 1), (2, R 2), (10, R 10), (14, R 14), (15, R 15)]
theorem reserve_eval (R : Nat → BitVec 64) (bd byoung blimit : List (BitVec 8)) :
    runGM reserve_body (reserve_input R) [bd, byoung, blimit] = reserve_regs R bd byoung blimit := by
  simp [reserve_body, reserve_input, reserve_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
    LeanRV64DExecutable.Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg]
  bv_omega

def paddingWord (span length : BitVec 64) : BitVec 64 :=
  LeanRV64DExecutable.Functions.sign_extend (m := 64)
    (Sail.BitVec.extractLsb (span - 1#64) 31 0 - Sail.BitVec.extractLsb length 31 0)
def initialize_regs (R : Nat → BitVec 64) (byoung bra : List (BitVec 8)) : GRegs :=
  [(2, R 2 + 48#64), (1, bytesVal .ld bra),
   (15, bytesVal .ld byoung + 8#64 + (R 15 - 1#64)),
   (14, paddingWord (R 15) (R 14)), (13, bytesVal .ld byoung + 8#64 + R 15),
   (10, bytesVal .ld byoung + 8#64), (16, R 16)]
theorem initialize_eval (R : Nat → BitVec 64) (bd byoung bra : List (BitVec 8)) :
    runGM initialize_body (initialize_input R) [bd, byoung, bra] = initialize_regs R byoung bra := by
  simp [initialize_body, initialize_input, initialize_regs, paddingWord, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG,
    LeanRV64DExecutable.Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg]

def stringWords (n : BitVec 64) : BitVec 64 := (n + 8#64) >>> 3
def stringSpan (n : BitVec 64) : BitVec 64 := (n + 8#64) &&& (-8#64)
def prepare_regs (R : Nat → BitVec 64) : GRegs :=
  [(15, stringSpan (R 10)), (13, 256#64), (10, stringWords (R 10)),
   (14, R 10), (2, R 2 - 48#64), (1, R 1)]
theorem prepare_eval (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    runGM prepare_body (prepare_input R) loads = prepare_regs R := by
  simp [prepare_body, prepare_input, prepare_regs, stringWords, stringSpan,
    runGM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG,
    LeanRV64DExecutable.Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg,
    shamtOf, Sail.BitVec.extractLsb, Sail.shift_bits_right]

end OCaml.Vm.Primitives.StringAllocation
