      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, link_input]
    · apply w1.sd rfl
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, link_input]
    · apply w2.sd rfl
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, link_input]
    · apply w3.sd rfl
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, link_input]
  have control : TermFactsO (runGM link_body (link_input R) (link_loads c.σ.mem R)) (none) := True.intro
  apply registers_of_blocks h.image outside (link_summary c (R 1) R _ h regs access control)
  · exact link_log_eq R _
  · rfl
  · exact link_eval R _
  · rfl
  · decide

def done_body : List MInstr := [
  ⟨0x800214d0#64, 0x03813083#32, 0x83#8, 0x30#8, 0x81#8, 0x03#8, .ld, 1, 2, 0, 0x038#12⟩,
  ⟨0x800214d4#64, 0x03013403#32, 0x03#8, 0x34#8, 0x01#8, 0x03#8, .ld, 8, 2, 0, 0x030#12⟩,
  ⟨0x800214d8#64, 0x02813483#32, 0x83#8, 0x34#8, 0x81#8, 0x02#8, .ld, 9, 2, 0, 0x028#12⟩,
  ⟨0x800214dc#64, 0x02013903#32, 0x03#8, 0x39#8, 0x01#8, 0x02#8, .ld, 18, 2, 0, 0x020#12⟩,
  ⟨0x800214e0#64, 0x01813983#32, 0x83#8, 0x39#8, 0x81#8, 0x01#8, .ld, 19, 2, 0, 0x018#12⟩,
  ⟨0x800214e4#64, 0x01013a03#32, 0x03#8, 0x3a#8, 0x01#8, 0x01#8, .ld, 20, 2, 0, 0x010#12⟩,
  ⟨0x800214e8#64, 0x00100513#32, 0x13#8, 0x05#8, 0x10#8, 0x00#8, .addi, 10, 0, 0, 0x001#12⟩,
  ⟨0x800214ec#64, 0x04010113#32, 0x13#8, 0x01#8, 0x01#8, 0x04#8, .addi, 2, 2, 0, 0x040#12⟩
]
def done_term : TInstr := ⟨0x800214f0#64, 0x00008067#32, 0x67#8, 0x80#8, 0x00#8, 0x00#8, .jr, 1, 0, 0#13, 0#21, 0x000#12⟩
def done_blocks : List BBlock := [{ body := done_body, term := some done_term }]
def done_input (R : Nat → BitVec 64) : GRegs := [(2, R 2)]

theorem done_code {c : Config} (image : ExecutableImage c) : CodeFacts c.σ.mem done_body := by
  have hc := loaded image
  simp only [CodeFacts, done_body]
  chain_facts hc with "Vsa.Sim.Code.caml_register_named_value_at_"

theorem done_shape : ChainOK 0x800214d0#64 [2] done_blocks := by
  simp only [ChainOK, BBlockOK, done_blocks, done_body, done_term, BlockOKM]
  repeat' apply And.intro
  all_goals decide

theorem done_summary (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (loads : List (List (BitVec 8))) (h : LeafInput ra c)
    (regs : GHolds c.σ (done_input R))
    (access : AccessPlan c.σ.mem (done_input R) loads done_body)
    (control : TermFactsO (runGM done_body (done_input R) loads) (some done_term)) :
    FnSummary 0x800214d0#64 (fun d => d = c)
      (BlockPost done_blocks 0x800214d0#64 (done_input R) loads c) := by
  apply block_summary done_blocks _ _ _ c
  refine ⟨h.good, h.minstret, regs, ?_, ?_, done_shape, h.tick⟩
  · change KeysOK [2]; decide
  · apply singleton_chain_facts (accessPlan_facts (done_code h.image) access) ?_ control
    have hc := loaded h.image
    chain_facts hc with "Vsa.Sim.Code.caml_register_named_value_at_"

def done_regs (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : GRegs :=
  [(2, R 2 + 64#64), (10, 1#64), (20, bytesVal .ld (loads.getD 5 [])), (19, bytesVal .ld (loads.getD 4 [])), (18, bytesVal .ld (loads.getD 3 [])), (9, bytesVal .ld (loads.getD 2 [])), (8, bytesVal .ld (loads.getD 1 [])), (1, bytesVal .ld (loads.getD 0 []))]
theorem done_eval (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    runGM done_body (done_input R) loads = done_regs R loads := by
  simp [done_body, done_input, done_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
    Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, List.head?_eq_getElem?, BitVec.add_assoc]

def done_loads (m : Std.ExtHashMap Nat (BitVec 8)) (R : Nat → BitVec 64) : List (List (BitVec 8)) :=
  [read8 m (R 2 + 56#64).toNat, read8 m (R 2 + 48#64).toNat, read8 m (R 2 + 40#64).toNat, read8 m (R 2 + 32#64).toNat, read8 m (R 2 + 24#64).toNat, read8 m (R 2 + 16#64).toNat]

theorem done_fast (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (h : LeafInput (R 1) c) (regs : GHolds c.σ (done_input R))
    (w0 : ReadWindow (R 2 + 56#64) 8)
    (w1 : ReadWindow (R 2 + 48#64) 8)
    (w2 : ReadWindow (R 2 + 40#64) 8)
    (w3 : ReadWindow (R 2 + 32#64) 8)
    (w4 : ReadWindow (R 2 + 24#64) 8)
    (w5 : ReadWindow (R 2 + 16#64) 8)
    (savedRa : bytesVal .ld (read8 c.σ.mem (R 2 + 56#64).toNat) = ra) (aligned : ra.toNat % 4 = 0) :
    FnSummary 0x800214d0#64 (fun d => d = c)
      (WriteRegistersPost [1, 2, 8, 9, 10, 18, 19, 20] [] c (ra) (1#64) (done_regs R (done_loads c.σ.mem R))) := by
  have access : AccessPlan c.σ.mem (done_input R) (done_loads c.σ.mem R) done_body := by
    simp only [AccessPlan, done_body, done_loads]
    chain_facts True.intro
    · apply w0.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, done_input]
    · apply w1.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, done_input]
    · apply w2.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, done_input]
    · apply w3.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, done_input]
    · apply w4.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, done_input]
    · apply w5.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, done_input]
  have control : TermFactsO (runGM done_body (done_input R) (done_loads c.σ.mem R)) (some done_term) := by rw [done_eval]; exact return_facts _ rfl rfl rfl (by simpa [done_regs, srcVal, lookupG, done_loads] using savedRa) aligned
  apply registers_of_blocks h.image (log := []) ⟨True.intro, True.intro⟩ (done_summary c (R 1) R _ h regs access control)
  · exact readonly_log _ (by unfold ReadOnlyBody; decide) _ _
  · change tgtPCT done_term (runGM done_body (done_input R) (done_loads c.σ.mem R)) = ra
    rw [done_eval]
    change Sail.BitVec.update (bytesVal .ld ((done_loads c.σ.mem R).getD 0 []) + Functions.sign_extend (m := 64) (0#12)) 0 0#1 = ra
    simp only [done_loads, List.getD_cons_zero, List.getD_cons_succ]
    rw [savedRa]
    exact ret_tgt ra aligned
  · exact done_eval R _
  · rfl
  · decide

end OCaml.Vm.Primitives.Named.NamedRegister
