  [(9, R 10), (8, R 11), (15, R 11 &&& 1#64), (2, R 2 + 18446744073709551584#64), (1, R 1), (10, R 10), (11, R 11)]
theorem newImm_eval (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    runGM newImm_body (newImm_input R) loads = newImm_regs R loads := by
  simp [newImm_body, newImm_input, newImm_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
