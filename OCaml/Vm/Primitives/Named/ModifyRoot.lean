def newImmLog (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : List WEntry :=
  [((R 2 - 32#64 + 16#64).toNat, 8, R 8), ((R 2 - 32#64 + 8#64).toNat, 8, R 9), ((R 2 - 32#64 + 24#64).toNat, 8, R 1)]

theorem newImm_log_eq (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    (evalBlocks newImm_blocks (SegEvalState.init (newImm_input R) loads)).log = newImmLog R loads := by
  change [] ++ wlogM newImm_body (newImm_input R) loads = _
  simp only [List.nil_append, newImm_body, wlogM, newImm_input, wentryM, widthOfM, eaddrM, srcVal, stepGM,
    lookupG, eraseG, stepLdsM, Nat.reduceEqDiff, ite_true, ite_false, Option.getD_some, Nat.reduceAdd, wvalM,
    Functions.sign_extend, Sail.BitVec.signExtend]
  simp only [show BitVec.signExtend 64 0#12 = 0#64 by decide, show BitVec.signExtend 64 1#12 = 1#64 by decide, show BitVec.signExtend 64 16#12 = 16#64 by decide, show BitVec.signExtend 64 24#12 = 24#64 by decide, show BitVec.signExtend 64 4064#12 = -32#64 by decide, show BitVec.signExtend 64 8#12 = 8#64 by decide, ← BitVec.sub_eq_add_neg, BitVec.add_zero]
  simp only [newImmLog, List.headD_eq_head?_getD, List.head?_eq_getElem?, List.getD_eq_getElem?_getD,
    List.getElem?_tail, BitVec.zero_add]

def newImm_loads (m : Std.ExtHashMap Nat (BitVec 8)) (R : Nat → BitVec 64) : List (List (BitVec 8)) :=
  []

theorem newImm_fast (c : Config) (R : Nat → BitVec 64)
    (h : LeafInput (R 1) c) (regs : GHolds c.σ (newImm_input R))
    (w0 : WriteWindow (R 2 - 32#64 + 16#64) 8)
    (w1 : WriteWindow (R 2 - 32#64 + 8#64) 8)
    (w2 : WriteWindow (R 2 - 32#64 + 24#64) 8)
    (outside : ImageOutside (newImmLog R (newImm_loads c.σ.mem R)))
    (ok : guardB .BNE (R 11 &&& 1#64) (0#64) = true) :
    FnSummary 0x8000cb08#64 (fun d => d = c)
      (WriteRegistersPost [2, 8, 9, 15] (newImmLog R (newImm_loads c.σ.mem R)) c (0x8000cbe0#64) (R 10) (newImm_regs R (newImm_loads c.σ.mem R))) := by
  have access : AccessPlan c.σ.mem (newImm_input R) (newImm_loads c.σ.mem R) newImm_body := by
    simp only [AccessPlan, newImm_body, newImm_loads]
    chain_facts True.intro
    · apply w0.sd rfl
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, newImm_input]
    · apply w1.sd rfl
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, newImm_input]
    · apply w2.sd rfl
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, newImm_input]
  have control : TermFactsO (runGM newImm_body (newImm_input R) (newImm_loads c.σ.mem R)) (some newImm_term) := by rw [newImm_eval]; exact ok
  apply registers_of_blocks h.image outside (newImm_summary c (R 1) R _ h regs access control)
  · exact newImm_log_eq R _
  · rfl
  · exact newImm_eval R _
  · rfl
  · decide

