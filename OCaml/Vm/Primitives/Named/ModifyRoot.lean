def newImm_blocks : List BBlock := [{ body := newImm_body, term := some newImm_term }]
def newImm_input (R : Nat → BitVec 64) : GRegs := [(1, R 1), (2, R 2), (8, R 8), (9, R 9), (10, R 10), (11, R 11)]

theorem newImm_code {c : Config} (image : ExecutableImage c) : CodeFacts c.σ.mem newImm_body := by
  have hc := loaded image
  simp only [CodeFacts, newImm_body]
  chain_facts hc with "Vsa.Sim.Code.caml_modify_generational_global_root_at_"

theorem newImm_shape : ChainOK 0x8000cb08#64 [1, 2, 8, 9, 10, 11] newImm_blocks := by
  simp only [ChainOK, BBlockOK, newImm_blocks, newImm_body, newImm_term, BlockOKM]
  repeat' apply And.intro
  all_goals decide

theorem newImm_summary (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (loads : List (List (BitVec 8))) (h : LeafInput ra c)
    (regs : GHolds c.σ (newImm_input R))
    (access : AccessPlan c.σ.mem (newImm_input R) loads newImm_body)
    (control : TermFactsO (runGM newImm_body (newImm_input R) loads) (some newImm_term)) :
    FnSummary 0x8000cb08#64 (fun d => d = c)
      (BlockPost newImm_blocks 0x8000cb08#64 (newImm_input R) loads c) := by
  apply block_summary newImm_blocks _ _ _ c
  refine ⟨h.good, h.minstret, regs, ?_, ?_, newImm_shape, h.tick⟩
  · change KeysOK [1, 2, 8, 9, 10, 11]; decide
  · apply singleton_chain_facts (accessPlan_facts (newImm_code h.image) access) ?_ control
    have hc := loaded h.image
    chain_facts hc with "Vsa.Sim.Code.caml_modify_generational_global_root_at_"

