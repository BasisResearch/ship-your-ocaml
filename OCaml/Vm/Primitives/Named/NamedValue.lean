theorem pro_fast (c : Config) (R : Nat → BitVec 64)
    (h : LeafInput (R 1) c) (regs : GHolds c.σ (pro_input R))
    (w0 : WriteWindow (R 2 - 32#64 + 8#64) 8)
    (w1 : WriteWindow (R 2 - 32#64 + 24#64) 8)
    (w2 : WriteWindow (R 2 - 32#64 + 16#64) 8)
    (w3 : ReadWindow (R 10) 1)
    (a3 : OutLRange ((proLog R (pro_loads c.σ.mem R)).take 3) (R 10).toNat 1)
    (outside : ImageOutside (proLog R (pro_loads c.σ.mem R)))
    (ok : guardB .BEQ (bytesVal .lbu ((pro_loads c.σ.mem R).getD 0 [])) (0#64) = false) :
    FnSummary 0x800214fc#64 (fun d => d = c)
      (WriteRegistersPost [2, 9, 14] (proLog R (pro_loads c.σ.mem R)) c (0x80021518#64) (R 10) (pro_regs R (pro_loads c.σ.mem R))) := by
  have wl : wlogM pro_body (pro_input R) (pro_loads c.σ.mem R) = proLog R (pro_loads c.σ.mem R) := by rw [← pro_log_eq R _]; rfl
  have access : AccessPlan c.σ.mem (pro_input R) (pro_loads c.σ.mem R) pro_body := by
    apply accessPlan_of_pure
    · simp only [AccessPure, pro_body, pro_loads]
      chain_facts True.intro
      · apply w0.sd rfl
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, pro_input]
      · apply w1.sd rfl
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, pro_input]
      · apply w2.sd rfl
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, pro_input]
      · apply w3.lbu rfl ?_ rfl
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, pro_input]
    · rw [wl]; simp only [LoadMiss, pro_body, IsStore, Bool.false_eq_true, ↓reduceIte, Nat.reduceAdd]
      exact ⟨fun h => by simp [IsLoad] at h, fun h => by simp [IsLoad] at h, fun h => by simp [IsLoad] at h, fun h => by simp [IsLoad] at h, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, pro_input, pro_loads]) a3, fun h => by simp [IsLoad] at h, trivial⟩
  have control : TermFactsO (runGM pro_body (pro_input R) (pro_loads c.σ.mem R)) (some pro_term) := by rw [pro_eval]; exact ok
  apply registers_of_blocks h.image outside (pro_summary c (R 1) R _ h regs access control)
  · exact pro_log_eq R _
  · rfl
  · exact pro_eval R _
  · rfl
  · decide

