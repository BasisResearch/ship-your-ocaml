def ret_term : TInstr := ⟨0x8001641c#64, 0x00008067#32, 0x67#8, 0x80#8, 0x00#8, 0x00#8, .jr, 1, 0, 0#13, 0#21, 0x000#12⟩
def ret_blocks : List BBlock := [{ body := ret_body, term := some ret_term }]
def ret_input (R : Nat → BitVec 64) : GRegs := [(2, R 2), (9, R 9), (18, R 18)]

theorem ret_code {c : Config} (image : ExecutableImage c) : CodeFacts c.σ.mem ret_body := by
  have hc := loaded image
  simp only [CodeFacts, ret_body]
  chain_facts hc with "Vsa.Sim.Code.caml_ml_output_char_at_"

theorem ret_shape : ChainOK 0x800163fc#64 [2, 9, 18] ret_blocks := by
  simp only [ChainOK, BBlockOK, ret_blocks, ret_body, ret_term, BlockOKM]
  repeat' apply And.intro
  all_goals decide

theorem ret_summary (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (loads : List (List (BitVec 8))) (h : LeafInput ra c)
    (regs : GHolds c.σ (ret_input R))
    (access : AccessPlan c.σ.mem (ret_input R) loads ret_body)
    (control : TermFactsO (runGM ret_body (ret_input R) loads) (some ret_term)) :
    FnSummary 0x800163fc#64 (fun d => d = c)
      (BlockPost ret_blocks 0x800163fc#64 (ret_input R) loads c) := by
  apply block_summary ret_blocks _ _ _ c
  refine ⟨h.good, h.minstret, regs, ?_, ?_, ret_shape, h.tick⟩
  · change KeysOK [2, 9, 18]; decide
  · apply singleton_chain_facts (accessPlan_facts (ret_code h.image) access) ?_ control
    have hc := loaded h.image
    chain_facts hc with "Vsa.Sim.Code.caml_ml_output_char_at_"

def ret_regs (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : GRegs :=
  [(2, R 2 + 112#64), (18, bytesVal .ld (loads.getD 4 [])), (9, bytesVal .ld (loads.getD 3 [])), (8, bytesVal .ld (loads.getD 2 [])), (1, bytesVal .ld (loads.getD 1 [])), (10, 1#64), (15, bytesVal .ld (loads.getD 0 []))]
theorem ret_eval (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    runGM ret_body (ret_input R) loads = ret_regs R loads := by
  simp [ret_body, ret_input, ret_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
