  simp [unlock_body, unlock_input, unlock_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
    Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, List.head?_eq_getElem?, BitVec.add_assoc]

def unlock_loads (m : Std.ExtHashMap Nat (BitVec 8)) (R : Nat → BitVec 64) : List (List (BitVec 8)) :=
  [read8 m (0x80064b50#64).toNat]

theorem unlock_fast (c : Config) (R : Nat → BitVec 64)
    (h : LeafInput (R 1) c) (regs : GHolds c.σ (unlock_input R))
    (ok : guardB .BEQ (bytesVal .ld ((unlock_loads c.σ.mem R).getD 0 [])) (0#64) = true) :
    FnSummary 0x800163e8#64 (fun d => d = c)
      (WriteRegistersPost [15] [] c (0x800163fc#64) (R 10) (unlock_regs R (unlock_loads c.σ.mem R))) := by
  have w0 : ReadWindow (0x80064b50#64) 8 := ⟨by decide, by decide, Or.inr (by decide)⟩
  have access : AccessPlan c.σ.mem (unlock_input R) (unlock_loads c.σ.mem R) unlock_body := by
    simp only [AccessPlan, unlock_body, unlock_loads]
    chain_facts True.intro
    · apply w0.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, unlock_input]
  have control : TermFactsO (runGM unlock_body (unlock_input R) (unlock_loads c.σ.mem R)) (some unlock_term) := by rw [unlock_eval]; exact ok
  apply registers_of_blocks h.image (log := []) ⟨True.intro, True.intro⟩ (unlock_summary c (R 1) R _ h regs access control)
  · exact readonly_log _ (by unfold ReadOnlyBody; decide) _ _
  · rfl
  · exact unlock_eval R _
  · rfl
  · decide

