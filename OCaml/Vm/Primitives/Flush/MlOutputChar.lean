def retLog (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : List WEntry :=
  [((bytesVal .ld (loads.getD 0 []) + 288#64).toNat, 8, R 9)]

theorem ret_log_eq (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    (evalBlocks ret_blocks (SegEvalState.init (ret_input R) loads)).log = retLog R loads := by
  change [] ++ wlogM ret_body (ret_input R) loads = _
  simp only [List.nil_append, ret_body, wlogM, ret_input, wentryM, widthOfM, eaddrM, srcVal, stepGM,
    lookupG, eraseG, stepLdsM, Nat.reduceEqDiff, ite_true, ite_false, Option.getD_some, Nat.reduceAdd, wvalM,
    Functions.sign_extend, Sail.BitVec.signExtend]
  simp only [show BitVec.signExtend 64 0#12 = 0#64 by decide, show BitVec.signExtend 64 1#12 = 1#64 by decide, show BitVec.signExtend 64 104#12 = 104#64 by decide, show BitVec.signExtend 64 112#12 = 112#64 by decide, show BitVec.signExtend 64 288#12 = 288#64 by decide, show BitVec.signExtend 64 80#12 = 80#64 by decide, show BitVec.signExtend 64 88#12 = 88#64 by decide, show BitVec.signExtend 64 96#12 = 96#64 by decide, ← BitVec.sub_eq_add_neg, BitVec.add_zero]
  simp only [retLog, List.headD_eq_head?_getD, List.head?_eq_getElem?, List.getD_eq_getElem?_getD,
    List.getElem?_tail, BitVec.zero_add]

def ret_loads (m : Std.ExtHashMap Nat (BitVec 8)) (R : Nat → BitVec 64) : List (List (BitVec 8)) :=
  [read8 m (R 18).toNat, read8 m (R 2 + 104#64).toNat, read8 m (R 2 + 96#64).toNat, read8 m (R 2 + 88#64).toNat, read8 m (R 2 + 80#64).toNat]

theorem ret_fast (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (h : LeafInput (R 1) c) (regs : GHolds c.σ (ret_input R))
    (w0 : ReadWindow (R 18) 8)
    (w1 : WriteWindow ((bytesVal .ld (read8 c.σ.mem (R 18).toNat)) + 288#64) 8)
    (w2 : ReadWindow (R 2 + 104#64) 8)
    (a2 : OutLRange ((retLog R (ret_loads c.σ.mem R)).take 1) (R 2 + 104#64).toNat 8)
    (w3 : ReadWindow (R 2 + 96#64) 8)
    (a3 : OutLRange ((retLog R (ret_loads c.σ.mem R)).take 1) (R 2 + 96#64).toNat 8)
    (w4 : ReadWindow (R 2 + 88#64) 8)
    (a4 : OutLRange ((retLog R (ret_loads c.σ.mem R)).take 1) (R 2 + 88#64).toNat 8)
    (w5 : ReadWindow (R 2 + 80#64) 8)
    (a5 : OutLRange ((retLog R (ret_loads c.σ.mem R)).take 1) (R 2 + 80#64).toNat 8)
    (outside : ImageOutside (retLog R (ret_loads c.σ.mem R)))
    (savedRa : bytesVal .ld (read8 c.σ.mem (R 2 + 104#64).toNat) = ra) (aligned : ra.toNat % 4 = 0) :
    FnSummary 0x800163fc#64 (fun d => d = c)
      (WriteRegistersPost [1, 2, 8, 9, 10, 15, 18] (retLog R (ret_loads c.σ.mem R)) c (ra) (1#64) (ret_regs R (ret_loads c.σ.mem R))) := by
  have wl : wlogM ret_body (ret_input R) (ret_loads c.σ.mem R) = retLog R (ret_loads c.σ.mem R) := by rw [← ret_log_eq R _]; rfl
  have access : AccessPlan c.σ.mem (ret_input R) (ret_loads c.σ.mem R) ret_body := by
    apply accessPlan_of_pure
    · simp only [AccessPure, ret_body, ret_loads]
      chain_facts True.intro
      · apply w0.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
      · apply w1.sd rfl
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
      · apply w2.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
      · apply w3.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
      · apply w4.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
      · apply w5.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
    · rw [wl]; simp only [LoadMiss, ret_body, IsStore, Bool.false_eq_true, ↓reduceIte, Nat.reduceAdd]
      exact ⟨fun _ => by simp [OutLRange], fun h => by simp [IsLoad] at h, fun h => by simp [IsLoad] at h, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input, ret_loads]) a2, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input, ret_loads]) a3, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input, ret_loads]) a4, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input, ret_loads]) a5, fun h => by simp [IsLoad] at h, trivial⟩
  have control : TermFactsO (runGM ret_body (ret_input R) (ret_loads c.σ.mem R)) (some ret_term) := by rw [ret_eval]; exact return_facts _ rfl rfl rfl (by simpa [ret_regs, srcVal, lookupG, ret_loads] using savedRa) aligned
  apply registers_of_blocks h.image outside (ret_summary c (R 1) R _ h regs access control)
  · exact ret_log_eq R _
  · change tgtPCT ret_term (runGM ret_body (ret_input R) (ret_loads c.σ.mem R)) = ra
    rw [ret_eval]
    change Sail.BitVec.update (bytesVal .ld ((ret_loads c.σ.mem R).getD 1 []) + Functions.sign_extend (m := 64) (0#12)) 0 0#1 = ra
    simp only [ret_loads, List.getD_cons_zero, List.getD_cons_succ]
    rw [savedRa]
    exact ret_tgt ra aligned
  · exact ret_eval R _
  · rfl
  · decide

