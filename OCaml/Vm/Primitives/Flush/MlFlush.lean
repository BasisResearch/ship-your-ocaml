  ⟨0x800162dc#64, 0x00100513#32, 0x13#8, 0x05#8, 0x10#8, 0x00#8, .addi, 10, 0, 0, 0x001#12⟩,
  ⟨0x800162e0#64, 0x07010113#32, 0x13#8, 0x01#8, 0x01#8, 0x07#8, .addi, 2, 2, 0, 0x070#12⟩
]
def tail_term : TInstr := ⟨0x800162e4#64, 0x00008067#32, 0x67#8, 0x80#8, 0x00#8, 0x00#8, .jr, 1, 0, 0#13, 0#21, 0x000#12⟩
def tail_blocks : List BBlock := [{ body := tail_body, term := some tail_term }]
def tail_input (R : Nat → BitVec 64) : GRegs := [(2, R 2), (9, R 9), (15, R 15)]

theorem tail_code {c : Config} (image : ExecutableImage c) : CodeFacts c.σ.mem tail_body := by
  have hc := loaded image
  simp only [CodeFacts, tail_body]
  chain_facts hc with "Vsa.Sim.Code.caml_ml_flush_at_"

theorem tail_shape : ChainOK 0x800162c8#64 [2, 9, 15] tail_blocks := by
  simp only [ChainOK, BBlockOK, tail_blocks, tail_body, tail_term, BlockOKM]
  repeat' apply And.intro
  all_goals decide

theorem tail_summary (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (loads : List (List (BitVec 8))) (h : LeafInput ra c)
    (regs : GHolds c.σ (tail_input R))
    (access : AccessPlan c.σ.mem (tail_input R) loads tail_body)
    (control : TermFactsO (runGM tail_body (tail_input R) loads) (some tail_term)) :
    FnSummary 0x800162c8#64 (fun d => d = c)
      (BlockPost tail_blocks 0x800162c8#64 (tail_input R) loads c) := by
  apply block_summary tail_blocks _ _ _ c
  refine ⟨h.good, h.minstret, regs, ?_, ?_, tail_shape, h.tick⟩
  · change KeysOK [2, 9, 15]; decide
  · apply singleton_chain_facts (accessPlan_facts (tail_code h.image) access) ?_ control
    have hc := loaded h.image
    chain_facts hc with "Vsa.Sim.Code.caml_ml_flush_at_"

def tail_regs (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : GRegs :=
  [(2, R 2 + 112#64), (10, 1#64), (18, bytesVal .ld (loads.getD 3 [])), (9, bytesVal .ld (loads.getD 2 [])), (8, bytesVal .ld (loads.getD 1 [])), (1, bytesVal .ld (loads.getD 0 [])), (15, R 15)]
theorem tail_eval (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    runGM tail_body (tail_input R) loads = tail_regs R loads := by
  simp [tail_body, tail_input, tail_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
    Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, List.head?_eq_getElem?, BitVec.add_assoc]

def tailLog (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : List WEntry :=
  [((R 15 + 288#64).toNat, 8, R 9)]

theorem tail_log_eq (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    (evalBlocks tail_blocks (SegEvalState.init (tail_input R) loads)).log = tailLog R loads := by
  change [] ++ wlogM tail_body (tail_input R) loads = _
  simp only [List.nil_append, tail_body, wlogM, tail_input, wentryM, widthOfM, eaddrM, srcVal, stepGM,
    lookupG, eraseG, stepLdsM, Nat.reduceEqDiff, ite_true, ite_false, Option.getD_some, Nat.reduceAdd, wvalM,
    Functions.sign_extend, Sail.BitVec.signExtend]
  simp only [show BitVec.signExtend 64 1#12 = 1#64 by decide, show BitVec.signExtend 64 104#12 = 104#64 by decide, show BitVec.signExtend 64 112#12 = 112#64 by decide, show BitVec.signExtend 64 288#12 = 288#64 by decide, show BitVec.signExtend 64 80#12 = 80#64 by decide, show BitVec.signExtend 64 88#12 = 88#64 by decide, show BitVec.signExtend 64 96#12 = 96#64 by decide, ← BitVec.sub_eq_add_neg, BitVec.add_zero]
  simp only [tailLog, List.headD_eq_head?_getD, List.head?_eq_getElem?, List.getD_eq_getElem?_getD,
    List.getElem?_tail, BitVec.zero_add]

def tail_loads (m : Std.ExtHashMap Nat (BitVec 8)) (R : Nat → BitVec 64) : List (List (BitVec 8)) :=
  [read8 (writeLog m (tailLog R [])) (R 2 + 104#64).toNat, read8 (writeLog m (tailLog R [])) (R 2 + 96#64).toNat, read8 (writeLog m (tailLog R [])) (R 2 + 88#64).toNat, read8 (writeLog m (tailLog R [])) (R 2 + 80#64).toNat]

theorem tail_fast (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (h : LeafInput (R 1) c) (regs : GHolds c.σ (tail_input R))
    (w0 : WriteWindow (R 15 + 288#64) 8)
    (w1 : ReadWindow (R 2 + 104#64) 8)
    (w2 : ReadWindow (R 2 + 96#64) 8)
    (w3 : ReadWindow (R 2 + 88#64) 8)
    (w4 : ReadWindow (R 2 + 80#64) 8)
    (outside : ImageOutside (tailLog R (tail_loads c.σ.mem R)))
    (savedRa : bytesVal .ld (read8 (writeLog c.σ.mem (tailLog R [])) (R 2 + 104#64).toNat) = ra) (aligned : ra.toNat % 4 = 0) :
    FnSummary 0x800162c8#64 (fun d => d = c)
      (WriteRegistersPost [1, 2, 8, 9, 10, 18] (tailLog R (tail_loads c.σ.mem R)) c (ra) (1#64) (tail_regs R (tail_loads c.σ.mem R))) := by
  have access : AccessPlan c.σ.mem (tail_input R) (tail_loads c.σ.mem R) tail_body := by
    simp only [AccessPlan, tail_body, tail_loads]
    chain_facts True.intro
    · apply w0.sd rfl
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, tail_input]
    · apply w1.ld rfl
      · simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, tail_input]
      · apply ArgvTuple.lpins8_of_view (m' := writeLog c.σ.mem (tailLog R []))
        · simp [stepMemM, wentryM, widthOfM, eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, tail_input, writeLog, tailLog]
        · rfl
    · apply w2.ld rfl
      · simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, tail_input]
      · apply ArgvTuple.lpins8_of_view (m' := writeLog c.σ.mem (tailLog R []))
        · simp [stepMemM, wentryM, widthOfM, eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, tail_input, writeLog, tailLog]
        · rfl
    · apply w3.ld rfl
      · simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, tail_input]
      · apply ArgvTuple.lpins8_of_view (m' := writeLog c.σ.mem (tailLog R []))
        · simp [stepMemM, wentryM, widthOfM, eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, tail_input, writeLog, tailLog]
        · rfl
    · apply w4.ld rfl
      · simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, tail_input]
      · apply ArgvTuple.lpins8_of_view (m' := writeLog c.σ.mem (tailLog R []))
        · simp [stepMemM, wentryM, widthOfM, eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, tail_input, writeLog, tailLog]
        · rfl
  have control : TermFactsO (runGM tail_body (tail_input R) (tail_loads c.σ.mem R)) (some tail_term) := by rw [tail_eval]; exact return_facts _ rfl rfl rfl (by simpa [tail_regs, srcVal, lookupG, tail_loads] using savedRa) aligned
  apply registers_of_blocks h.image outside (tail_summary c (R 1) R _ h regs access control)
  · exact tail_log_eq R _
  · change tgtPCT tail_term (runGM tail_body (tail_input R) (tail_loads c.σ.mem R)) = ra
    rw [tail_eval]
    change Sail.BitVec.update (bytesVal .ld ((tail_loads c.σ.mem R).getD 0 []) + Functions.sign_extend (m := 64) (0#12)) 0 0#1 = ra
    simp only [tail_loads, List.getD_cons_zero, List.getD_cons_succ]
    rw [savedRa]
    exact ret_tgt ra aligned
  · exact tail_eval R _
  · rfl
  · decide

end OCaml.Vm.Primitives.Flush.MlFlush
