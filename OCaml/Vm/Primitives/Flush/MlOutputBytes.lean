def ret_term : TInstr := ⟨0x800166ac#64, 0x00008067#32, 0x67#8, 0x80#8, 0x00#8, 0x00#8, .jr, 1, 0, 0#13, 0#21, 0x000#12⟩
def ret_blocks : List BBlock := [{ body := ret_body, term := some ret_term }]
def ret_input (R : Nat → BitVec 64) : GRegs := [(2, R 2), (20, R 20), (21, R 21)]

theorem ret_code {c : Config} (image : ExecutableImage c) : CodeFacts c.σ.mem ret_body := by
  have hc := loaded image
  simp only [CodeFacts, ret_body]
  chain_facts hc with "Vsa.Sim.Code.caml_ml_output_bytes_at_"

theorem ret_shape : ChainOK 0x80016684#64 [2, 20, 21] ret_blocks := by
  simp only [ChainOK, BBlockOK, ret_blocks, ret_body, ret_term, BlockOKM]
  repeat' apply And.intro
  all_goals decide

theorem ret_summary (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (loads : List (List (BitVec 8))) (h : LeafInput ra c)
    (regs : GHolds c.σ (ret_input R))
    (access : AccessPlan c.σ.mem (ret_input R) loads ret_body)
    (control : TermFactsO (runGM ret_body (ret_input R) loads) (some ret_term)) :
    FnSummary 0x80016684#64 (fun d => d = c)
      (BlockPost ret_blocks 0x80016684#64 (ret_input R) loads c) := by
  apply block_summary ret_blocks _ _ _ c
  refine ⟨h.good, h.minstret, regs, ?_, ?_, ret_shape, h.tick⟩
  · change KeysOK [2, 20, 21]; decide
  · apply singleton_chain_facts (accessPlan_facts (ret_code h.image) access) ?_ control
    have hc := loaded h.image
    chain_facts hc with "Vsa.Sim.Code.caml_ml_output_bytes_at_"

def ret_regs (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : GRegs :=
  [(2, R 2 + 176#64), (23, bytesVal .ld (loads.getD 6 [])), (21, bytesVal .ld (loads.getD 5 [])), (20, bytesVal .ld (loads.getD 4 [])), (18, bytesVal .ld (loads.getD 3 [])), (9, bytesVal .ld (loads.getD 2 [])), (1, bytesVal .ld (loads.getD 1 [])), (10, 1#64), (15, bytesVal .ld (loads.getD 0 []))]
theorem ret_eval (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    runGM ret_body (ret_input R) loads = ret_regs R loads := by
  simp [ret_body, ret_input, ret_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
    Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, List.head?_eq_getElem?, BitVec.add_assoc]

def retLog (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : List WEntry :=
  [((bytesVal .ld (loads.getD 0 []) + 288#64).toNat, 8, R 20)]

theorem ret_log_eq (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    (evalBlocks ret_blocks (SegEvalState.init (ret_input R) loads)).log = retLog R loads := by
  change [] ++ wlogM ret_body (ret_input R) loads = _
  simp only [List.nil_append, ret_body, wlogM, ret_input, wentryM, widthOfM, eaddrM, srcVal, stepGM,
    lookupG, eraseG, stepLdsM, Nat.reduceEqDiff, ite_true, ite_false, Option.getD_some, Nat.reduceAdd, wvalM,
    Functions.sign_extend, Sail.BitVec.signExtend]
  simp only [show BitVec.signExtend 64 0#12 = 0#64 by decide, show BitVec.signExtend 64 1#12 = 1#64 by decide, show BitVec.signExtend 64 104#12 = 104#64 by decide, show BitVec.signExtend 64 120#12 = 120#64 by decide, show BitVec.signExtend 64 128#12 = 128#64 by decide, show BitVec.signExtend 64 144#12 = 144#64 by decide, show BitVec.signExtend 64 152#12 = 152#64 by decide, show BitVec.signExtend 64 168#12 = 168#64 by decide, show BitVec.signExtend 64 176#12 = 176#64 by decide, show BitVec.signExtend 64 288#12 = 288#64 by decide, ← BitVec.sub_eq_add_neg, BitVec.add_zero]
  simp only [retLog, List.headD_eq_head?_getD, List.head?_eq_getElem?, List.getD_eq_getElem?_getD,
    List.getElem?_tail, BitVec.zero_add]

def ret_loads (m : Std.ExtHashMap Nat (BitVec 8)) (R : Nat → BitVec 64) : List (List (BitVec 8)) :=
  [read8 m (R 21).toNat, read8 m (R 2 + 168#64).toNat, read8 m (R 2 + 152#64).toNat, read8 m (R 2 + 144#64).toNat, read8 m (R 2 + 128#64).toNat, read8 m (R 2 + 120#64).toNat, read8 m (R 2 + 104#64).toNat]

theorem ret_fast (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (h : LeafInput (R 1) c) (regs : GHolds c.σ (ret_input R))
    (w0 : ReadWindow (R 21) 8)
    (w1 : WriteWindow ((bytesVal .ld (read8 c.σ.mem (R 21).toNat)) + 288#64) 8)
    (w2 : ReadWindow (R 2 + 168#64) 8)
    (a2 : OutLRange ((retLog R (ret_loads c.σ.mem R)).take 1) (R 2 + 168#64).toNat 8)
    (w3 : ReadWindow (R 2 + 152#64) 8)
    (a3 : OutLRange ((retLog R (ret_loads c.σ.mem R)).take 1) (R 2 + 152#64).toNat 8)
    (w4 : ReadWindow (R 2 + 144#64) 8)
    (a4 : OutLRange ((retLog R (ret_loads c.σ.mem R)).take 1) (R 2 + 144#64).toNat 8)
    (w5 : ReadWindow (R 2 + 128#64) 8)
    (a5 : OutLRange ((retLog R (ret_loads c.σ.mem R)).take 1) (R 2 + 128#64).toNat 8)
    (w6 : ReadWindow (R 2 + 120#64) 8)
    (a6 : OutLRange ((retLog R (ret_loads c.σ.mem R)).take 1) (R 2 + 120#64).toNat 8)
    (w7 : ReadWindow (R 2 + 104#64) 8)
    (a7 : OutLRange ((retLog R (ret_loads c.σ.mem R)).take 1) (R 2 + 104#64).toNat 8)
    (outside : ImageOutside (retLog R (ret_loads c.σ.mem R)))
    (savedRa : bytesVal .ld (read8 c.σ.mem (R 2 + 168#64).toNat) = ra) (aligned : ra.toNat % 4 = 0) :
    FnSummary 0x80016684#64 (fun d => d = c)
      (WriteRegistersPost [1, 2, 9, 10, 15, 18, 20, 21, 23] (retLog R (ret_loads c.σ.mem R)) c (ra) (1#64) (ret_regs R (ret_loads c.σ.mem R))) := by
  have wl : wlogM ret_body (ret_input R) (ret_loads c.σ.mem R) = retLog R (ret_loads c.σ.mem R) := by rw [← ret_log_eq R _]; rfl
  have access : AccessPlan c.σ.mem (ret_input R) (ret_loads c.σ.mem R) ret_body := by
    apply accessPlan_of_pure
    · simp only [AccessPure, ret_body, ret_loads]
      chain_facts True.intro
      · apply w0.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
      · apply w1.sd rfl
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
      · apply w2.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
      · apply w3.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
      · apply w4.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
      · apply w5.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
      · apply w6.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
      · apply w7.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input]
    · rw [wl]; simp only [LoadMiss, ret_body, IsStore, Bool.false_eq_true, ↓reduceIte, Nat.reduceAdd]
      exact ⟨fun _ => by simp [OutLRange], fun h => by simp [IsLoad] at h, fun h => by simp [IsLoad] at h, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input, ret_loads]) a2, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input, ret_loads]) a3, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input, ret_loads]) a4, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input, ret_loads]) a5, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input, ret_loads]) a6, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, ret_input, ret_loads]) a7, fun h => by simp [IsLoad] at h, trivial⟩
  have control : TermFactsO (runGM ret_body (ret_input R) (ret_loads c.σ.mem R)) (some ret_term) := by rw [ret_eval]; exact return_facts _ rfl rfl rfl (by simpa [ret_regs, srcVal, lookupG, ret_loads] using savedRa) aligned
  apply registers_of_blocks h.image outside (ret_summary c (R 1) R _ h regs access control)
  · exact ret_log_eq R _
  · change tgtPCT ret_term (runGM ret_body (ret_input R) (ret_loads c.σ.mem R)) = ra
    rw [ret_eval]
    change Sail.BitVec.update (bytesVal .ld ((ret_loads c.σ.mem R).getD 1 []) + Functions.sign_extend (m := 64) (0#12)) 0 0#1 = ra
