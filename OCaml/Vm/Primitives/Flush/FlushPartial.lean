  ⟨0x800154b4#64, 0x02013a03#32, 0x03#8, 0x3a#8, 0x01#8, 0x02#8, .ld, 20, 2, 0, 0x020#12⟩,
  ⟨0x800154b8#64, 0x01813a83#32, 0x83#8, 0x3a#8, 0x81#8, 0x01#8, .ld, 21, 2, 0, 0x018#12⟩,
  ⟨0x800154bc#64, 0x00153513#32, 0x13#8, 0x35#8, 0x15#8, 0x00#8, .slti true, 10, 10, 0, 0x001#12⟩,
  ⟨0x800154c0#64, 0x05010113#32, 0x13#8, 0x01#8, 0x01#8, 0x05#8, .addi, 2, 2, 0, 0x050#12⟩
]
def epi_term : TInstr := ⟨0x800154c4#64, 0x00008067#32, 0x67#8, 0x80#8, 0x00#8, 0x00#8, .jr, 1, 0, 0#13, 0#21, 0x000#12⟩
def epi_blocks : List BBlock := [{ body := epi_body, term := some epi_term }]
def epi_input (R : Nat → BitVec 64) : GRegs := [(2, R 2), (10, R 10), (18, R 18)]

theorem epi_code {c : Config} (image : ExecutableImage c) : CodeFacts c.σ.mem epi_body := by
  have hc := loaded image
  simp only [CodeFacts, epi_body]
  chain_facts hc with "Vsa.Sim.Code.caml_flush_partial_at_"

theorem epi_shape : ChainOK 0x8001549c#64 [2, 10, 18] epi_blocks := by
  simp only [ChainOK, BBlockOK, epi_blocks, epi_body, epi_term, BlockOKM]
  repeat' apply And.intro
  all_goals decide

theorem epi_summary (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (loads : List (List (BitVec 8))) (h : LeafInput ra c)
    (regs : GHolds c.σ (epi_input R))
    (access : AccessPlan c.σ.mem (epi_input R) loads epi_body)
    (control : TermFactsO (runGM epi_body (epi_input R) loads) (some epi_term)) :
    FnSummary 0x8001549c#64 (fun d => d = c)
      (BlockPost epi_blocks 0x8001549c#64 (epi_input R) loads c) := by
  apply block_summary epi_blocks _ _ _ c
  refine ⟨h.good, h.minstret, regs, ?_, ?_, epi_shape, h.tick⟩
  · change KeysOK [2, 10, 18]; decide
  · apply singleton_chain_facts (accessPlan_facts (epi_code h.image) access) ?_ control
    have hc := loaded h.image
    chain_facts hc with "Vsa.Sim.Code.caml_flush_partial_at_"

def epi_regs (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : GRegs :=
  [(2, R 2 + 80#64), (10, compareValue true (R 18 - R 10) 1#64), (21, bytesVal .ld (loads.getD 6 [])), (20, bytesVal .ld (loads.getD 5 [])), (19, bytesVal .ld (loads.getD 4 [])), (18, bytesVal .ld (loads.getD 3 [])), (9, bytesVal .ld (loads.getD 2 [])), (8, bytesVal .ld (loads.getD 1 [])), (1, bytesVal .ld (loads.getD 0 []))]
theorem epi_eval (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    runGM epi_body (epi_input R) loads = epi_regs R loads := by
  simp [epi_body, epi_input, epi_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
    Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, List.head?_eq_getElem?, BitVec.add_assoc]

def epi_loads (m : Std.ExtHashMap Nat (BitVec 8)) (R : Nat → BitVec 64) : List (List (BitVec 8)) :=
  [read8 m (R 2 + 72#64).toNat, read8 m (R 2 + 64#64).toNat, read8 m (R 2 + 56#64).toNat, read8 m (R 2 + 48#64).toNat, read8 m (R 2 + 40#64).toNat, read8 m (R 2 + 32#64).toNat, read8 m (R 2 + 24#64).toNat]

theorem epi_fast (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (h : LeafInput (R 1) c) (regs : GHolds c.σ (epi_input R))
    (w0 : ReadWindow (R 2 + 72#64) 8)
    (w1 : ReadWindow (R 2 + 64#64) 8)
    (w2 : ReadWindow (R 2 + 56#64) 8)
    (w3 : ReadWindow (R 2 + 48#64) 8)
    (w4 : ReadWindow (R 2 + 40#64) 8)
    (w5 : ReadWindow (R 2 + 32#64) 8)
    (w6 : ReadWindow (R 2 + 24#64) 8)
    (savedRa : bytesVal .ld (read8 c.σ.mem (R 2 + 72#64).toNat) = ra) (aligned : ra.toNat % 4 = 0) :
    FnSummary 0x8001549c#64 (fun d => d = c)
      (WriteRegistersPost [1, 2, 8, 9, 10, 18, 19, 20, 21] [] c (ra) (compareValue true (R 18 - R 10) 1#64) (epi_regs R (epi_loads c.σ.mem R))) := by
  have access : AccessPlan c.σ.mem (epi_input R) (epi_loads c.σ.mem R) epi_body := by
    simp only [AccessPlan, epi_body, epi_loads]
    chain_facts True.intro
    · apply w0.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, epi_input]
    · apply w1.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, epi_input]
    · apply w2.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, epi_input]
    · apply w3.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, epi_input]
    · apply w4.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, epi_input]
    · apply w5.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, epi_input]
    · apply w6.ld rfl ?_ (read8_pins _ _)
      simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, epi_input]
  have control : TermFactsO (runGM epi_body (epi_input R) (epi_loads c.σ.mem R)) (some epi_term) := by rw [epi_eval]; exact return_facts _ rfl rfl rfl (by simpa [epi_regs, srcVal, lookupG, epi_loads] using savedRa) aligned
  apply registers_of_blocks h.image (log := []) ⟨True.intro, True.intro⟩ (epi_summary c (R 1) R _ h regs access control)
  · exact readonly_log _ (by unfold ReadOnlyBody; decide) _ _
  · change tgtPCT epi_term (runGM epi_body (epi_input R) (epi_loads c.σ.mem R)) = ra
    rw [epi_eval]
    change Sail.BitVec.update (bytesVal .ld ((epi_loads c.σ.mem R).getD 0 []) + Functions.sign_extend (m := 64) (0#12)) 0 0#1 = ra
    simp only [epi_loads, List.getD_cons_zero, List.getD_cons_succ]
    rw [savedRa]
    exact ret_tgt ra aligned
  · exact epi_eval R _
  · rfl
  · decide

end OCaml.Vm.Primitives.Flush.FlushPartial
