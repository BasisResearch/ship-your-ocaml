theorem initialize_summary (c : Config) (ra header bits : BitVec 64) (bd byoung : List (BitVec 8))
    (h : LeafInput ra c)
    (hr : GHolds c.σ [(1, ra), (15, header), (16, domainGlobal), (17, bits)])
    (facts : ProgFactsM c.σ.mem c.σ.mem [(1, ra), (15, header), (16, domainGlobal), (17, bits)] [bd, byoung] initialize_body)
    (outside : ImageOutside (initializeLog header (bytesVal .ld byoung) bits))
    : FnSummary 0x80012218#64 (fun d => d = c)
      (WriteRegistersPost [10, 14, 15] (initializeLog header (bytesVal .ld byoung) bits) c ra (bytesVal .ld byoung + 8#64) (initialize_regs ra header bits bd byoung)) := by
  have ht : TermFactsO (runGM initialize_body [(1, ra), (15, header), (16, domainGlobal), (17, bits)] [bd, byoung]) (some ⟨0x80012230#64, 0x00008067#32, 0x67#8, 0x80#8, 0x00#8, 0x00#8, .jr, 1, 0, 0#13, 0#21, 0x000#12⟩) := by
    rw [initialize_eval]
    apply return_facts _ rfl rfl rfl ?_ h.aligned
    simp [initialize_regs, srcVal, lookupG]
  have S := block_summary initialize_blocks 0x80012218#64 [(1, ra), (15, header), (16, domainGlobal), (17, bits)] [bd, byoung] c
    ⟨h.good, h.minstret, hr, (by change KeysOK [1, 15, 16, 17]; decide),
      singleton_chain_facts facts
        (by have hc := loaded h.image; chain_facts hc with "Vsa.Sim.Code.caml_copy_double_at_") ht,
      initialize_shape, h.tick⟩
  apply registers_of_blocks h.image outside S
  · exact initialize_log ra header bits bd byoung
  · simp only [evalBlocksPC, initialize_blocks, SegEvalState.init, chainEndPC, endPCB, tgtPCT]
    rw [initialize_eval]
    change Sail.BitVec.update (ra + LeanRV64DExecutable.Functions.sign_extend (m := 64) (0#12)) 0 0#1 = ra
    exact ret_tgt ra h.aligned
  · exact initialize_eval ra header bits bd byoung
  · rfl
  · decide

