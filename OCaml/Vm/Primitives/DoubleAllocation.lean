theorem reserve_facts (c : Config) (ra bits : BitVec 64) (bd byoung blimit : List (BitVec 8))
    (hc : Vsa.Sim.Code.Caml_copy_doubleLoaded c.σ.mem)
    (globalRead : ReadWindow domainGlobal 8)
    (youngRead : ReadWindow (youngSlot (bytesVal .ld bd)) 8)
    (limitRead : ReadWindow (limitSlot (bytesVal .ld bd)) 8)
    (youngWrite : WriteWindow (youngSlot (bytesVal .ld bd)) 8)
    (domainPins : LPins8 c.σ.mem domainGlobal.toNat bd)
    (youngPins : LPins8 c.σ.mem (youngSlot (bytesVal .ld bd)).toNat byoung)
    (limitPins : LPins8 c.σ.mem (limitSlot (bytesVal .ld bd)).toNat blimit)
    : ProgFactsM c.σ.mem c.σ.mem [(1, ra), (10, bits)] [bd, byoung, blimit] reserve_body := by
  chain_facts hc with "Vsa.Sim.Code.caml_copy_double_at_"
  · apply globalRead.ld rfl ?_ domainPins
    simp [eaddrM, youngSlot, limitSlot, domainGlobal, Layout.sym_Caml_state, Layout.off_young_ptr, Layout.off_young_limit, runGM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, LeanRV64DExecutable.Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg]
  · apply youngRead.ld rfl ?_ youngPins
    simp [eaddrM, youngSlot, limitSlot, domainGlobal, Layout.sym_Caml_state, Layout.off_young_ptr, Layout.off_young_limit, runGM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, LeanRV64DExecutable.Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg]
  · apply limitRead.ld rfl ?_ limitPins
    simp [eaddrM, youngSlot, limitSlot, domainGlobal, Layout.sym_Caml_state, Layout.off_young_ptr, Layout.off_young_limit, runGM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, LeanRV64DExecutable.Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg]
  · apply youngWrite.sd rfl
    simp [eaddrM, youngSlot, limitSlot, domainGlobal, Layout.sym_Caml_state, Layout.off_young_ptr, Layout.off_young_limit, runGM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, LeanRV64DExecutable.Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg]

theorem reserve_log (ra bits : BitVec 64) (bd byoung blimit : List (BitVec 8)) :
    (evalBlocks reserve_blocks (SegEvalState.init [(1, ra), (10, bits)] [bd, byoung, blimit])).log = reserveLog (bytesVal .ld bd) (bytesVal .ld byoung) := by
  have down : LeanRV64DExecutable.Functions.sign_extend (m := 64) (0xff0#12) = -16#64 := by decide
  change [((bytesVal .ld bd + 8#64).toNat, 8, bytesVal .ld byoung + LeanRV64DExecutable.Functions.sign_extend (m := 64) (0xff0#12))] = _
  rw [down, ← BitVec.sub_eq_add_neg]
  rfl

theorem reserve_summary (c : Config) (ra bits : BitVec 64) (bd byoung blimit : List (BitVec 8))
    (h : LeafInput ra c)
    (hr : GHolds c.σ [(1, ra), (10, bits)])
    (facts : ProgFactsM c.σ.mem c.σ.mem [(1, ra), (10, bits)] [bd, byoung, blimit] reserve_body)
    (outside : ImageOutside (reserveLog (bytesVal .ld bd) (bytesVal .ld byoung)))
    (branch : guardB .BLTU (bytesVal .ld byoung - 16#64) (bytesVal .ld blimit) = false)
    : FnSummary 0x800121f4#64 (fun d => d = c)
      (WriteRegistersPost [13, 14, 15, 16, 17] (reserveLog (bytesVal .ld bd) (bytesVal .ld byoung)) c 0x80012218#64 bits (reserve_regs ra bits bd byoung blimit)) := by
  have ht : TermFactsO (runGM reserve_body [(1, ra), (10, bits)] [bd, byoung, blimit]) (some ⟨0x80012214#64, 0x02d7e063#32, 0x63#8, 0xe0#8, 0xd7#8, 0x02#8, .br bop.BLTU false, 15, 13, 0x0020#13, 0#21, 0#12⟩) := by
    rw [reserve_eval]
    simpa [TermFactsO, TermFactsT, reserve_regs, srcVal, lookupG] using branch
  have S := block_summary reserve_blocks 0x800121f4#64 [(1, ra), (10, bits)] [bd, byoung, blimit] c
    ⟨h.good, h.minstret, hr, (by change KeysOK [1, 10]; decide),
      singleton_chain_facts facts
        (by have hc := loaded h.image; chain_facts hc with "Vsa.Sim.Code.caml_copy_double_at_") ht,
      reserve_shape, h.tick⟩
  apply registers_of_blocks h.image outside S
  · exact reserve_log ra bits bd byoung blimit
  · simp only [evalBlocksPC, reserve_blocks, SegEvalState.init, chainEndPC, endPCB, tgtPCT]
    rfl
  · exact reserve_eval ra bits bd byoung blimit
  · rfl
  · decide

