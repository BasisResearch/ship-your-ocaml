def check_input (R : Nat → BitVec 64) : GRegs := [(1, R 1), (2, R 2), (8, R 8), (10, R 10)]

theorem check_code {c : Config} (image : ExecutableImage c) : CodeFacts c.σ.mem check_body := by
  have hc := loaded image
  simp only [CodeFacts, check_body]
  chain_facts hc with "Vsa.Sim.Code._write_r_at_"

theorem check_shape : ChainOK 0x800424e0#64 [1, 2, 8, 10] check_blocks := by
  simp only [ChainOK, BBlockOK, check_blocks, check_body, check_term, BlockOKM]
  repeat' apply And.intro
  all_goals decide

theorem check_summary (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (loads : List (List (BitVec 8))) (h : LeafInput ra c)
    (regs : GHolds c.σ (check_input R))
    (access : AccessPlan c.σ.mem (check_input R) loads check_body)
    (control : TermFactsO (runGM check_body (check_input R) loads) (some check_term)) :
    FnSummary 0x800424e0#64 (fun d => d = c)
      (BlockPost check_blocks 0x800424e0#64 (check_input R) loads c) := by
  apply block_summary check_blocks _ _ _ c
  refine ⟨h.good, h.minstret, regs, ?_, ?_, check_shape, h.tick⟩
  · change KeysOK [1, 2, 8, 10]; decide
  · apply singleton_chain_facts (accessPlan_facts (check_code h.image) access) ?_ control
    have hc := loaded h.image
    chain_facts hc with "Vsa.Sim.Code._write_r_at_"

def check_regs (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : GRegs :=
  [(15, 18446744073709551615#64), (1, R 1), (2, R 2), (8, R 8), (10, R 10)]
theorem check_eval (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    runGM check_body (check_input R) loads = check_regs R loads := by
  simp [check_body, check_input, check_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
    Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, List.head?_eq_getElem?, BitVec.add_assoc]

def ret_body : List MInstr := [
  ⟨0x800424e8#64, 0x00813083#32, 0x83#8, 0x30#8, 0x81#8, 0x00#8, .ld, 1, 2, 0, 0x008#12⟩,
  ⟨0x800424ec#64, 0x00013403#32, 0x03#8, 0x34#8, 0x01#8, 0x00#8, .ld, 8, 2, 0, 0x000#12⟩,
  ⟨0x800424f0#64, 0x01010113#32, 0x13#8, 0x01#8, 0x01#8, 0x01#8, .addi, 2, 2, 0, 0x010#12⟩
]
def ret_term : TInstr := ⟨0x800424f4#64, 0x00008067#32, 0x67#8, 0x80#8, 0x00#8, 0x00#8, .jr, 1, 0, 0#13, 0#21, 0x000#12⟩
def ret_blocks : List BBlock := [{ body := ret_body, term := some ret_term }]
def ret_input (R : Nat → BitVec 64) : GRegs := [(2, R 2), (10, R 10)]

theorem ret_code {c : Config} (image : ExecutableImage c) : CodeFacts c.σ.mem ret_body := by
  have hc := loaded image
  simp only [CodeFacts, ret_body]
  chain_facts hc with "Vsa.Sim.Code._write_r_at_"

theorem ret_shape : ChainOK 0x800424e8#64 [2, 10] ret_blocks := by
  simp only [ChainOK, BBlockOK, ret_blocks, ret_body, ret_term, BlockOKM]
  repeat' apply And.intro
  all_goals decide

theorem ret_summary (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (loads : List (List (BitVec 8))) (h : LeafInput ra c)
    (regs : GHolds c.σ (ret_input R))
    (access : AccessPlan c.σ.mem (ret_input R) loads ret_body)
    (control : TermFactsO (runGM ret_body (ret_input R) loads) (some ret_term)) :
    FnSummary 0x800424e8#64 (fun d => d = c)
      (BlockPost ret_blocks 0x800424e8#64 (ret_input R) loads c) := by
  apply block_summary ret_blocks _ _ _ c
  refine ⟨h.good, h.minstret, regs, ?_, ?_, ret_shape, h.tick⟩
  · change KeysOK [2, 10]; decide
  · apply singleton_chain_facts (accessPlan_facts (ret_code h.image) access) ?_ control
    have hc := loaded h.image
    chain_facts hc with "Vsa.Sim.Code._write_r_at_"

def ret_regs (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : GRegs :=
  [(2, R 2 + 16#64), (8, bytesVal .ld (loads.getD 1 [])), (1, bytesVal .ld (loads.getD 0 [])), (10, R 10)]
theorem ret_eval (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    runGM ret_body (ret_input R) loads = ret_regs R loads := by
  simp [ret_body, ret_input, ret_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
    Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, List.head?_eq_getElem?, BitVec.add_assoc]

