      (BlockPost done_blocks 0x80016120#64 (done_input R) loads c) := by
  apply block_summary done_blocks _ _ _ c
  refine ⟨h.good, h.minstret, regs, ?_, ?_, done_shape, h.tick⟩
  · change KeysOK [2, 10, 14, 15]; decide
  · apply singleton_chain_facts (accessPlan_facts (done_code h.image) access) ?_ control
    have hc := loaded h.image
    chain_facts hc with "Vsa.Sim.Code.caml_ml_out_channels_list_at_"

def done_regs (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : GRegs :=
  [(2, R 2 + 128#64), (8, bytesVal .ld (loads.getD 1 [])), (1, bytesVal .ld (loads.getD 0 [])), (10, R 10), (14, R 14), (15, R 15)]
theorem done_eval (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    runGM done_body (done_input R) loads = done_regs R loads := by
  simp [done_body, done_input, done_regs, runGM, stepGM, stepLdsM,
    wvalM, srcVal, lookupG, eraseG, imm20Of, DoubleAllocation.domainGlobal, Layout.sym_Caml_state,
    Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, List.head?_eq_getElem?, BitVec.add_assoc]

def doneLog (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) : List WEntry :=
  [((R 15 + 288#64).toNat, 8, R 14)]

theorem done_log_eq (R : Nat → BitVec 64) (loads : List (List (BitVec 8))) :
    (evalBlocks done_blocks (SegEvalState.init (done_input R) loads)).log = doneLog R loads := by
  change [] ++ wlogM done_body (done_input R) loads = _
  simp only [List.nil_append, done_body, wlogM, done_input, wentryM, widthOfM, eaddrM, srcVal, stepGM,
    lookupG, eraseG, stepLdsM, Nat.reduceEqDiff, ite_true, ite_false, Option.getD_some, Nat.reduceAdd, wvalM,
    Functions.sign_extend, Sail.BitVec.signExtend]
  simp only [show BitVec.signExtend 64 112#12 = 112#64 by decide, show BitVec.signExtend 64 120#12 = 120#64 by decide, show BitVec.signExtend 64 128#12 = 128#64 by decide, show BitVec.signExtend 64 288#12 = 288#64 by decide, ← BitVec.sub_eq_add_neg, BitVec.add_zero]
  simp only [doneLog, List.headD_eq_head?_getD, List.head?_eq_getElem?, List.getD_eq_getElem?_getD,
    List.getElem?_tail, BitVec.zero_add]

def done_loads (m : Std.ExtHashMap Nat (BitVec 8)) (R : Nat → BitVec 64) : List (List (BitVec 8)) :=
  [read8 m (R 2 + 120#64).toNat, read8 m (R 2 + 112#64).toNat]

theorem done_fast (c : Config) (ra : BitVec 64) (R : Nat → BitVec 64)
    (h : LeafInput (R 1) c) (regs : GHolds c.σ (done_input R))
    (w0 : WriteWindow (R 15 + 288#64) 8)
    (w1 : ReadWindow (R 2 + 120#64) 8)
    (a1 : OutLRange ((doneLog R (done_loads c.σ.mem R)).take 1) (R 2 + 120#64).toNat 8)
    (w2 : ReadWindow (R 2 + 112#64) 8)
    (a2 : OutLRange ((doneLog R (done_loads c.σ.mem R)).take 1) (R 2 + 112#64).toNat 8)
    (outside : ImageOutside (doneLog R (done_loads c.σ.mem R)))
    (savedRa : bytesVal .ld (read8 c.σ.mem (R 2 + 120#64).toNat) = ra) (aligned : ra.toNat % 4 = 0) :
    FnSummary 0x80016120#64 (fun d => d = c)
      (WriteRegistersPost [1, 2, 8] (doneLog R (done_loads c.σ.mem R)) c (ra) (R 10) (done_regs R (done_loads c.σ.mem R))) := by
  have wl : wlogM done_body (done_input R) (done_loads c.σ.mem R) = doneLog R (done_loads c.σ.mem R) := by rw [← done_log_eq R _]; rfl
  have access : AccessPlan c.σ.mem (done_input R) (done_loads c.σ.mem R) done_body := by
    apply accessPlan_of_pure
    · simp only [AccessPure, done_body, done_loads]
      chain_facts True.intro
      · apply w0.sd rfl
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, done_input]
      · apply w1.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, done_input]
      · apply w2.ld rfl ?_ (read8_pins _ _)
        simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, done_input]
    · rw [wl]; simp only [LoadMiss, done_body, IsStore, Bool.false_eq_true, ↓reduceIte, Nat.reduceAdd]
      exact ⟨fun h => by simp [IsLoad] at h, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, done_input, done_loads]) a1, fun _ => outLRange_of_eaddr (by simp [eaddrM, stepGM, stepLdsM, wvalM, srcVal, lookupG, eraseG, imm20Of, Functions.sign_extend, Sail.BitVec.signExtend, BitVec.sub_eq_add_neg, done_input, done_loads]) a2, fun h => by simp [IsLoad] at h, trivial⟩
  have control : TermFactsO (runGM done_body (done_input R) (done_loads c.σ.mem R)) (some done_term) := by rw [done_eval]; exact return_facts _ rfl rfl rfl (by simpa [done_regs, srcVal, lookupG, done_loads] using savedRa) aligned
  apply registers_of_blocks h.image outside (done_summary c (R 1) R _ h regs access control)
  · exact done_log_eq R _
  · change tgtPCT done_term (runGM done_body (done_input R) (done_loads c.σ.mem R)) = ra
    rw [done_eval]
    change Sail.BitVec.update (bytesVal .ld ((done_loads c.σ.mem R).getD 0 []) + Functions.sign_extend (m := 64) (0#12)) 0 0#1 = ra
    simp only [done_loads, List.getD_cons_zero, List.getD_cons_succ]
    rw [savedRa]
    exact ret_tgt ra aligned
  · exact done_eval R _
  · rfl
  · decide

end OCaml.Vm.Primitives.Channel.OutList
