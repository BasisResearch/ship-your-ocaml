import OCaml.Bytecode.Load

/-! `runbc FILE [FUEL] [TRACEFROM]`: run `BcSem` (the step function of
`OCaml/Bytecode/Semantics.lean`) on a bytecode executable, loaded by
`OCaml/Bytecode/Load.lean`, and print the console output, then one status
line on stderr: `halt exit <e> steps <n>` or where it stopped. With
TRACEFROM, every step from that index on is printed to stderr. Validation
only (VALIDATION.md §BcSem); not part of any statement. -/

open OCaml.Bytecode

def showV (h : Heap) : Val → String
  | .ptr l k => s!"ptr {l}+{k}:" ++ (match h.get? l with
      | some (.block t fs) => s!"blk{t}/{fs.length}"
      | some (.bytes b) => s!"str{repr (bytesToString b)}"
      | some o => s!"tag{o.tag}"
      | none => "?")
  | v => reprStr v

/-! Lean source for a loaded `Prog` (`runbc --lean FILE NAME`), for the
kernel-checked validation theorems in `OCaml/Programs/`. -/

def leanBytes (b : List UInt8) : String := "[" ++ ", ".intercalate (b.map fun x => toString x.toNat) ++ "]"

def leanVal : Val → String
  | .int n => s!"(.int {n.toNat}#63)"
  | .ptr l k => s!"(.ptr {l} {k})"
  | .code pc => s!"(.code {pc})"
  | .atom t => s!"(.atom {t})"
  | .raw w => s!"(.raw {w.toNat}#64)"

def leanObj : Obj → String
  | .block t fs => s!"(.block {t} [" ++ ", ".intercalate (fs.map leanVal) ++ "])"
  | .bytes b => s!"(.bytes {leanBytes b})"
  | .partialBytes b => s!"(.partialBytes {reprStr b})"
  | .double d => s!"(.double {d.toNat}#64)"
  | .doubleArray ds => "(.doubleArray [" ++ ", ".intercalate (ds.map fun d => s!"{d.toNat}#64") ++ "])"
  | .int64 n => s!"(.int64 {n.toNat}#64)"
  | .int32 n => s!"(.int32 {n.toNat}#32)"
  | .nativeint n => s!"(.nativeint {n.toNat}#64)"
  | .channel i => s!"(.channel {i})"

def leanProg (P : Prog) (name : String) : String :=
  let code := ", ".intercalate (P.code.toList.map fun w => toString w.toNat)
  let prims := ", ".intercalate (P.prims.toList.map fun p => "\"" ++ p ++ "\"")
  let objs := ",\n    ".intercalate (P.heap0.objs.map leanObj)
  s!"def {name}Code : List Nat := [{code}]\n\n" ++
  s!"def {name}Prims : Array String := #[{prims}]\n\n" ++
  s!"def {name}Heap : List Obj := [\n    {objs}]\n\n" ++
  s!"/-- The loaded program (generated by `runbc --lean`). The embedded-file\n" ++
  s!"table is left empty: F1 programs do not read files. -/\n" ++
  s!"def {name} : Prog :=\n  ⟨({name}Code.map (BitVec.ofNat 32)).toArray, {name}Prims, ⟨{name}Heap⟩, {leanVal P.globals},\n" ++
  s!"   {leanBytes P.exeName}, {leanVal P.argv}, [], []⟩\n"

/-- Import an isolated host fixture tree at the model's filesystem root. -/
def importTree (root : System.FilePath) (pathPrefix : String := "") : Nat →
    IO (List (String × List UInt8))
  | 0 => throw (IO.userError "fixture directory depth exceeds bound")
  | fuel + 1 => do
    let mut files := []
    for entry in ← root.readDir do
      let name := pathPrefix ++ "/" ++ entry.fileName
      if ← entry.path.isDir then
        files := files ++ (← importTree entry.path name fuel)
      else files := (name, (← IO.FS.readBinFile entry.path).toList) :: files
    pure files

/-- Write final model files into the isolated fixture tree. -/
def exportTree (root : System.FilePath) (w : World) : IO Unit := do
  for (name, bytes) in w.files do
    if name != "/prog" then
      let parts := (name.splitOn "/").filter (· != "")
      if parts.any (· == "..") then throw (IO.userError "noncanonical model path")
      let path := parts.foldl (fun (p : System.FilePath) (part : String) => p / System.FilePath.mk part) root
      if let some parent := path.parent then IO.FS.createDirAll parent
      IO.FS.writeBinFile path ⟨bytes.toArray⟩

def main (args : List String) : IO UInt32 := do
  match args with
  | ["--lean", f, name] =>
    match loadExe (← IO.FS.readBinFile f) with
    | none => IO.eprintln "load failed"; pure 2
    | some P => IO.println (leanProg P name); pure 0
  | "--fs" :: root :: f :: fuel :: rest =>
    let (snapshots, argv) ← match rest with
      | "--gc-stats" :: path :: "--" :: argv => do
        let lines := (← IO.FS.readFile path).splitOn "\n"
        let some snapshots := (lines.filter (· != "")).mapM GcSnapshot.parse
          | throw (IO.userError "invalid GC snapshot file")
        pure (snapshots, argv)
      | "--" :: argv => pure ([], argv)
      | _ => throw (IO.userError "expected -- [program arguments]")
    let files ← importTree root "" 64
    match loadExe (← IO.FS.readBinFile f) argv files with
    | none => IO.eprintln "load failed"; pure 2
    | some P =>
      let P := { P with gcSnapshots := snapshots }
      let (w, code, n, status) := runWorld P (fuel.toNat?.getD 100000000) P.init 0 []
      IO.print (bytesToString w.console)
      IO.eprintln s!"{status} exit {code} steps {n} gc_remaining {w.gcSnapshots.length}"
      exportTree root w
      pure (match code with | some e => e.toUInt32 | none => 3)
  | f :: rest =>
    let bytes ← IO.FS.readBinFile f
    let fuel := (rest.head?.bind String.toNat?).getD 100000000
    let traceFrom := (rest.drop 1).head?.bind String.toNat?
    match loadExe bytes with
    | none => IO.eprintln "load failed"; pure 2
    | some P =>
      match traceFrom with
      | none =>
        let (out, code, n, status) := run P fuel P.init 0
        IO.print out
        IO.eprintln s!"{status} exit {code} steps {n} prims {P.prims.size} heap0 {P.heap0.objs.length}"
        pure (match code with | some e => e.toUInt32 | none => 3)
      | some t0 =>
        let mut s := P.init
        for n in [0:fuel] do
          if n ≥ t0 then
            IO.eprintln s!"{n} pc {s.pc} {repr ((decodeAt P.code s.pc).map (fun i => (i.op, i.args)))} accu {showV s.heap s.accu} env {showV s.heap s.env} extra {s.extra} trap {s.trap} sp {(s.stack.take 5).map (showV s.heap)} len {s.stack.length}"
          match step P s with
          | .next s' => s := s'
          | .halt e _ => IO.eprintln s!"halt {e}"; return 0
          | .unsupported => IO.eprintln "unsupported"; return 3
          | .wrong => IO.eprintln "wrong"; return 3
        pure 3
  | [] => IO.eprintln "usage: runbc FILE [FUEL] [TRACEFROM]"; pure 2
